#requires -version 3
[CmdletBinding()]
param(
  [string]$GamesRoot = 'E:\games',
  [string]$BackupRoot = '',
  [switch]$BackupEgames,
  [switch]$VerifyOnly,
  [switch]$SkipLaunchProbe
)

$ErrorActionPreference = 'Stop'
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$InstallDir = 'F:\backup\windowsapps\installed\gamesavemanager'
$ExeName = 'gs_mngr_3.exe'
$GsmHome = 'https://www.gamesave-manager.com/'
$MaxAttempts = 5
$ProbeSeconds = 18
$Work = 'C:\Temp\gsm_latest_repair'
New-Item -ItemType Directory -Force -Path $Work | Out-Null
$Log = Join-Path $Work 'last_run.log'
$CustomEntriesPath = Join-Path $env:APPDATA 'GSM Backups\custom_entries.json'
$CoverageManifest = Join-Path $Work 'egames_coverage_manifest.json'
function Log([string]$m){ $line = ('{0}  {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m); Write-Host $line; Add-Content -LiteralPath $Log -Value $line -Encoding UTF8 }
function Get-TextFromUrl([string]$url){
  $wc = New-Object Net.WebClient
  $wc.Headers['User-Agent'] = 'Mozilla/5.0 Hermes-GSM-Repair'
  return $wc.DownloadString($url)
}
function Get-OfficialReleaseInfo(){
  $html = Get-TextFromUrl $GsmHome
  $versionMatch = [regex]::Match($html, 'Latest Version:\s*.*?([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)', 'Singleline')
  if(!$versionMatch.Success){ $versionMatch = [regex]::Match($html, 'Download GameSave Manager v([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)') }
  $dbMatch = [regex]::Match($html, 'Database Update:\s*.*?([0-9]+\.[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]+)', 'Singleline')
  if(!$versionMatch.Success){ throw 'Could not read latest GameSave Manager version from homepage.' }
  if(!$dbMatch.Success){ throw 'Could not read latest GameSave Manager database version from homepage.' }
  [PSCustomObject]@{ Version = $versionMatch.Groups[1].Value; Database = $dbMatch.Groups[1].Value; Html = $html }
}
function Download-FileStrict([string]$url,[string]$out){
  $wc = New-Object Net.WebClient
  $wc.Headers['User-Agent'] = 'Mozilla/5.0 Hermes-GSM-Repair'
  $wc.DownloadFile($url,$out)
}
function HashOf([string]$path,[string]$alg){ (Get-FileHash -LiteralPath $path -Algorithm $alg).Hash.ToLowerInvariant() }
function Stop-GSM(){
  Get-Process -Name 'gs_mngr_3' -ErrorAction SilentlyContinue | ForEach-Object {
    Log ('Stopping old GameSave Manager pid={0}' -f $_.Id)
    try { $_.CloseMainWindow() | Out-Null } catch {}
  }
  Start-Sleep -Milliseconds 800
  Get-Process -Name 'gs_mngr_3' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
}
function Ensure-ZipAssembly(){ Add-Type -AssemblyName System.IO.Compression.FileSystem }
function Backup-Settings(){
  $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
  $backup = Join-Path $Work ('settings_backup_' + $stamp)
  New-Item -ItemType Directory -Force -Path $backup | Out-Null
  foreach($name in @('settings','bin\config.ini','bin\config.ini.bk')){
    $src = Join-Path $InstallDir $name
    if(Test-Path -LiteralPath $src){ Copy-Item -LiteralPath $src -Destination (Join-Path $backup ($name -replace '[\\/:*?"<>|]','_')) -Recurse -Force }
  }
  if(Test-Path -LiteralPath $CustomEntriesPath){ Copy-Item -LiteralPath $CustomEntriesPath -Destination (Join-Path $backup 'custom_entries.json') -Force }
  return $backup
}
function Ensure-GsmConfig(){
  $config = Join-Path $InstallDir 'bin\config.ini'
  if(!(Test-Path -LiteralPath $config)){ return }
  $text = Get-Content -LiteralPath $config -Raw
  if($text -notmatch '(?m)^\[CustomEntries\]'){
    $text = $text.TrimEnd() + "`r`n`r`n[CustomEntries]`r`nListOfficialEntries=true`r`n"
  } elseif($text -notmatch '(?m)^ListOfficialEntries='){
    $text = [regex]::Replace($text, '(?m)^\[CustomEntries\]\s*', "[CustomEntries]`r`nListOfficialEntries=true`r`n")
  } else {
    $text = [regex]::Replace($text, '(?m)^ListOfficialEntries=.*$', 'ListOfficialEntries=true')
  }
  if($text -notmatch '(?m)^\[Settings\]'){
    $text = $text.TrimEnd() + "`r`n`r`n[Settings]`r`nStoreWithinLaunchDir=true`r`n"
  } elseif($text -notmatch '(?m)^StoreWithinLaunchDir='){
    $text = [regex]::Replace($text, '(?m)^\[Settings\]\s*', "[Settings]`r`nStoreWithinLaunchDir=true`r`n")
  } else {
    $text = [regex]::Replace($text, '(?m)^StoreWithinLaunchDir=.*$', 'StoreWithinLaunchDir=true')
  }
  Set-Content -LiteralPath $config -Value $text -Encoding UTF8
  Copy-Item -LiteralPath $config -Destination (Join-Path $InstallDir 'bin\config.ini.bk') -Force
  Log 'GSM config enforced: ListOfficialEntries=true and StoreWithinLaunchDir=true'
}
function Get-DbVersion(){
  $sqlite = Get-Command sqlite3.exe -ErrorAction SilentlyContinue
  if(!$sqlite){ $sqlite = Get-Command sqlite3 -ErrorAction SilentlyContinue }
  if(!$sqlite){ throw 'sqlite3 is required to verify GameSave Manager games.db version, but it was not found in PATH.' }
  $dbPath = Join-Path $InstallDir 'bin\games.db'
  if(!(Test-Path -LiteralPath $dbPath)){ throw ('Missing GameSave Manager database: ' + $dbPath) }
  $raw = & $sqlite.Source $dbPath 'select Version || ''.'' || Build from DBVer limit 1;'
  if($LASTEXITCODE -ne 0 -or !$raw){ throw 'Could not read DBVer from games.db.' }
  return ('' + $raw).Trim()
}
function Assert-InstalledLatest([object]$Official){
  $exe = Join-Path $InstallDir $ExeName
  if(!(Test-Path -LiteralPath $exe)){ throw ('Missing executable: ' + $exe) }
  $ver = (Get-Item -LiteralPath $exe).VersionInfo.ProductVersion
  if($ver -ne $Official.Version){ throw ('Installed version ' + $ver + ' is not latest official ' + $Official.Version) }
  $db = Get-DbVersion
  if($db -ne $Official.Database){ throw ('Installed database ' + $db + ' is not latest official ' + $Official.Database) }
  Log ('Verified installed latest app=' + $ver + ' database=' + $db)
}
function New-StableGuid([string]$Text){
  $md5 = [System.Security.Cryptography.MD5]::Create()
  try {
    $bytes = [Text.Encoding]::UTF8.GetBytes($Text)
    $hash = $md5.ComputeHash($bytes)
    return (New-Object Guid (,$hash)).ToString()
  } finally {
    $md5.Dispose()
  }
}
function Get-EGamesDirectories(){
  if(!(Test-Path -LiteralPath $GamesRoot)){ throw ('Games root does not exist: ' + $GamesRoot) }
  @(Get-ChildItem -LiteralPath $GamesRoot -Directory -Force | Sort-Object FullName)
}
function Resolve-EGamesBackupRoot(){
  if($BackupRoot){ return $BackupRoot }
  $sourceDrive = ([IO.Path]::GetPathRoot((Resolve-Path -LiteralPath $GamesRoot).ProviderPath)).TrimEnd('\')
  $candidates = @()
  foreach($driveName in @('C','F','D')){
    $drive = Get-PSDrive -Name $driveName -ErrorAction SilentlyContinue
    if($drive -and (($drive.Root.TrimEnd('\')) -ne $sourceDrive)){
      $candidates += [PSCustomObject]@{ Root = (Join-Path $drive.Root 'GameSaveManager\E-games-backups'); Free = $drive.Free; Drive = $drive.Name }
    }
  }
  if($candidates.Count -eq 0){ throw 'No non-source backup drive candidate was found. Provide -BackupRoot explicitly.' }
  $selected = $candidates | Sort-Object Free -Descending | Select-Object -First 1
  Log ('Backup root auto-selected: ' + $selected.Root + ' free_bytes=' + $selected.Free)
  return $selected.Root
}
function ConvertTo-ObjectArray([object]$Value){
  if($null -eq $Value){ return @() }
  if($Value -is [System.Array]){ return @($Value) }
  return @($Value)
}
function Update-EGamesCustomEntries(){
  $dirs = @(Get-EGamesDirectories)
  $customDir = Split-Path -Parent $CustomEntriesPath
  New-Item -ItemType Directory -Force -Path $customDir | Out-Null
  $manual = @()
  if(Test-Path -LiteralPath $CustomEntriesPath){
    try {
      $existing = ConvertTo-ObjectArray (Get-Content -LiteralPath $CustomEntriesPath -Raw | ConvertFrom-Json)
      foreach($entry in $existing){
        $title = '' + $entry.title
        $hasGeneratedPath = $false
        try {
          $winRules = ConvertTo-ObjectArray $entry.save_location.win
          foreach($rule in $winRules){
            $template = '' + $rule.template
            if($template.StartsWith($GamesRoot, [System.StringComparison]::OrdinalIgnoreCase)){ $hasGeneratedPath = $true }
          }
        } catch {}
        if(($title -notlike 'Egames - *') -and (-not $hasGeneratedPath)){ $manual += $entry }
      }
    } catch {
      throw ('Existing custom entries JSON is invalid: ' + $_.Exception.Message)
    }
  }
  $generated = @()
  foreach($dir in $dirs){
    $generated += [PSCustomObject]@{
      title = ('Egames - ' + $dir.Name)
      wiki_page_id = (New-StableGuid ('fixgsm|egames|' + $dir.FullName.ToLowerInvariant()))
      install_folder = $dir.FullName
      save_location = [PSCustomObject]@{
        win = @([PSCustomObject]@{ template = $dir.FullName; type = 'folder' })
        reg = @()
        mac = @()
        linux = @()
      }
    }
  }
  $all = @($manual + $generated)
  $all | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $CustomEntriesPath -Encoding UTF8
  [PSCustomObject]@{
    generated_at = (Get-Date).ToString('s')
    games_root = $GamesRoot
    custom_entries_path = $CustomEntriesPath
    total_top_level_directories = $dirs.Count
    generated_entries = $generated.Count
    manual_entries_preserved = $manual.Count
    missing_entry_paths = @()
    entries = @($dirs | ForEach-Object { [PSCustomObject]@{ name = $_.Name; path = $_.FullName; title = ('Egames - ' + $_.Name) } })
  } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $CoverageManifest -Encoding UTF8
  Log ('E:\games GSM custom-entry coverage generated: ' + $generated.Count + ' of ' + $dirs.Count + ' directories; manifest=' + $CoverageManifest)
}
function Invoke-EGamesBackup(){
  $dirs = @(Get-EGamesDirectories)
  $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
  $root = Resolve-EGamesBackupRoot
  $target = Join-Path $root $stamp
  New-Item -ItemType Directory -Force -Path $target | Out-Null
  $manifestEntries = @()
  foreach($dir in $dirs){
    $dest = Join-Path $target $dir.Name
    Log ('Backing up E:\games directory: ' + $dir.FullName + ' -> ' + $dest)
    & robocopy.exe $dir.FullName $dest /MIR /R:2 /W:2 /XJ /FFT /COPY:DAT /DCOPY:DAT | Out-Null
    $code = $LASTEXITCODE
    if($code -ge 8){ throw ('robocopy failed for ' + $dir.FullName + ' with exit code ' + $code) }
    $manifestEntries += [PSCustomObject]@{ source = $dir.FullName; destination = $dest; robocopy_exit = $code }
  }
  $backupManifest = Join-Path $target 'fixgsm-egames-backup-manifest.json'
  [PSCustomObject]@{ created_at = (Get-Date).ToString('s'); games_root = $GamesRoot; directory_count = $dirs.Count; entries = $manifestEntries } |
    ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $backupManifest -Encoding UTF8
  Log ('E:\games backup complete: ' + $backupManifest)
}
function Install-Latest([object]$Official){
  if(!(Test-Path -LiteralPath $InstallDir)){ New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null }
  $latest = $Official.Version
  $d = [regex]::Match($Official.Html, '/download/[0-9a-fA-F-]+/')
  if(!$d.Success){ throw 'Could not find homepage download link.' }
  $downloadPageUrl = (New-Object Uri((New-Object Uri($GsmHome)), $d.Value)).AbsoluteUri
  $page = Get-TextFromUrl $downloadPageUrl
  $file = [regex]::Match($page, 'https://www\.gamesave-manager\.com/file/[^''" ]+/')
  if(!$file.Success){ throw 'Could not find real ZIP download URL.' }
  $md5m = [regex]::Match($page, '<td align="right">md5</td>\s*<td>([a-fA-F0-9]+)</td>')
  $sha1m = [regex]::Match($page, '<td align="right">sha1</td>\s*<td>([a-fA-F0-9]+)</td>')
  $zip = Join-Path $Work ('GameSaveManager_' + $latest + '.zip')
  Log ('Latest GameSave Manager online version: ' + $latest)
  Log ('Downloading: ' + $file.Value)
  Download-FileStrict $file.Value $zip
  if($md5m.Success){ $md5 = HashOf $zip 'MD5'; if($md5 -ne $md5m.Groups[1].Value.ToLowerInvariant()){ throw ('MD5 mismatch: ' + $md5) }; Log ('MD5 verified: ' + $md5) }
  if($sha1m.Success){ $sha1 = HashOf $zip 'SHA1'; if($sha1 -ne $sha1m.Groups[1].Value.ToLowerInvariant()){ throw ('SHA1 mismatch: ' + $sha1) }; Log ('SHA1 verified: ' + $sha1) }
  $backup = Backup-Settings
  Log ('Settings backup: ' + $backup)
  Stop-GSM
  Ensure-ZipAssembly
  $extract = Join-Path $Work 'extract'
  if(Test-Path -LiteralPath $extract){ Remove-Item -LiteralPath $extract -Recurse -Force }
  New-Item -ItemType Directory -Force -Path $extract | Out-Null
  [IO.Compression.ZipFile]::ExtractToDirectory($zip, $extract)
  Get-ChildItem -LiteralPath $extract -Force | ForEach-Object { Copy-Item -LiteralPath $_.FullName -Destination $InstallDir -Recurse -Force }
  $exe = Join-Path $InstallDir $ExeName
  if(!(Test-Path -LiteralPath $exe)){ throw ('Missing executable after extract: ' + $exe) }
  $ver = (Get-Item -LiteralPath $exe).VersionInfo.ProductVersion
  Log ('Installed ProductVersion: ' + $ver)
  if($ver -ne $latest){ throw ('Installed version ' + $ver + ' is not latest ' + $latest) }
  Ensure-GsmConfig
  Assert-InstalledLatest $Official
  return $latest
}
function Get-UiErrorsForProcess([int]$TargetPid){
  Add-Type -AssemblyName UIAutomationClient
  Add-Type -AssemblyName UIAutomationTypes
  $bad = New-Object System.Collections.Generic.List[string]
  $root = [System.Windows.Automation.AutomationElement]::RootElement
  $all = $root.FindAll([System.Windows.Automation.TreeScope]::Children, [System.Windows.Automation.Condition]::TrueCondition)
  foreach($w in $all){
    try{
      $wpid = $w.Current.ProcessId
      $title = '' + $w.Current.Name
      if(($wpid -eq $TargetPid) -or ($title -match 'GameSave|File not found|Error')){
        $texts = New-Object System.Collections.Generic.List[string]
        if($title){ $texts.Add($title) }
        $kids = $w.FindAll([System.Windows.Automation.TreeScope]::Descendants, [System.Windows.Automation.Condition]::TrueCondition)
        foreach($k in $kids){ $n = '' + $k.Current.Name; if($n){ $texts.Add($n) } }
        $joined = ($texts | Select-Object -Unique) -join ' | '
        if($joined -match 'File not found|Unhandled|Exception|Error|missing|not found') { $bad.Add($joined) }
      }
    } catch {}
  }
  return @($bad.ToArray())
}
function Probe-Launch(){
  $exe = Join-Path $InstallDir $ExeName
  Stop-GSM
  $p = Start-Process -FilePath $exe -WorkingDirectory $InstallDir -PassThru
  Log ('Launched GameSave Manager pid=' + $p.Id)
  $deadline = (Get-Date).AddSeconds($ProbeSeconds)
  $errors = @()
  while((Get-Date) -lt $deadline){
    Start-Sleep -Seconds 2
    if($p.HasExited){ throw ('GameSave Manager exited during probe with code ' + $p.ExitCode) }
    $errors = @(Get-UiErrorsForProcess $p.Id)
    if($errors.Count -gt 0){ break }
  }
  if($errors.Count -gt 0){ throw ('Visible UI error detected: ' + ($errors -join ' || ')) }
  $ver = (Get-Item -LiteralPath $exe).VersionInfo.ProductVersion
  Log ('Probe clean: no File-not-found/Error dialogs detected for ' + $ProbeSeconds + 's. Version=' + $ver)
  return $true
}
if(Test-Path -LiteralPath $Log){ Remove-Item -LiteralPath $Log -Force }
$lastErr = $null
for($attempt=1; $attempt -le $MaxAttempts; $attempt++){
  try{
    Log ('=== Attempt ' + $attempt + ' of ' + $MaxAttempts + ' ===')
    $official = Get-OfficialReleaseInfo
    Log ('Official latest GameSave Manager app=' + $official.Version + ' database=' + $official.Database)
    if($VerifyOnly){
      Ensure-GsmConfig
      Assert-InstalledLatest $official
      $latest = $official.Version
    } else {
      $latest = Install-Latest $official
    }
    Update-EGamesCustomEntries
    if($BackupEgames){ Invoke-EGamesBackup }
    if($SkipLaunchProbe){ Log 'Launch probe skipped by -SkipLaunchProbe.' } else { Probe-Launch | Out-Null }
    Assert-InstalledLatest $official
    Log ('SUCCESS latest working version=' + $latest)
    exit 0
  } catch {
    $lastErr = $_.Exception.Message
    Log ('Attempt failed: ' + $lastErr)
    Stop-GSM
    Start-Sleep -Seconds 2
  }
}
throw ('Repair failed after ' + $MaxAttempts + ' attempts. Last error: ' + $lastErr)
