$__extractedFunctionName = 'rmfunc'
$__extractedCommandName = 'rmfunc'
$__extractedScriptPath = $PSCommandPath
$__extractedArgs = @($args)
if ($__extractedArgs -contains '-SelfTest') {
    [pscustomobject]@{
        Function = $__extractedFunctionName
        Command = $__extractedCommandName
        Script = $__extractedScriptPath
        Exists = [bool](Test-Path -LiteralPath $__extractedScriptPath)
        Mode = 'SelfTest'
    } | ConvertTo-Json -Compress
    return
}

function Normalize-RmfuncFunctionName {
    param([string]$Name)

    if ([string]::IsNullOrWhiteSpace($Name)) { return $null }
    $Name.Trim() -replace '^(?i:global:)', ''
}

function New-RmfuncFunctionNameSet {
    param([string[]]$Functions)

    $set = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($functionName in $Functions) {
        $normalized = Normalize-RmfuncFunctionName -Name $functionName
        if (-not [string]::IsNullOrWhiteSpace($normalized)) {
            $set.Add($normalized) | Out-Null
        }
    }
    $set
}

function Get-RmfuncProfileSourcePaths {
    param([string[]]$ProfilePath)

    if ($ProfilePath -and $ProfilePath.Count -gt 0) {
        $paths = @($ProfilePath)
    } else {
        $documentsRoot = Join-Path $env:USERPROFILE 'Documents'
        $windowsPowerShellRoot = Join-Path $documentsRoot 'WindowsPowerShell'
        $powerShellRoot = Join-Path $documentsRoot 'PowerShell'
        $paths = @(
            $PROFILE,
            $script:ProfileRuntimeSnapshotPath,
            $script:FullProfileLibraryPath,
            (Join-Path $windowsPowerShellRoot 'Microsoft.PowerShell_profile.ps1'),
            (Join-Path $windowsPowerShellRoot 'Microsoft.PowerShell_profile.runtime.ps1'),
            (Join-Path $windowsPowerShellRoot 'Microsoft.PowerShell_profile.full.ps1'),
            (Join-Path $powerShellRoot 'Microsoft.PowerShell_profile.ps1'),
            (Join-Path $powerShellRoot 'Microsoft.PowerShell_profile.runtime.ps1'),
            (Join-Path $powerShellRoot 'Microsoft.PowerShell_profile.full.ps1')
        )
    }

    $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($path in $paths) {
        if ([string]::IsNullOrWhiteSpace($path)) { continue }
        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { continue }
        $resolved = (Resolve-Path -LiteralPath $path).ProviderPath
        if ($seen.Add($resolved)) { $resolved }
    }
}

function Get-RmfuncTextEncoding {
    param([string]$Path)

    $bytes = [System.IO.File]::ReadAllBytes($Path)
    $hasUtf8Bom = $bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF
    New-Object System.Text.UTF8Encoding($hasUtf8Bom)
}

function Remove-RmfuncFunctionDefinitionsFromText {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Source,

        [Parameter(Mandatory = $true)]
        [System.Collections.Generic.HashSet[string]]$TargetNames
    )

    $tokens = $null
    $errors = $null
    $ast = [System.Management.Automation.Language.Parser]::ParseInput($Source, [ref]$tokens, [ref]$errors)

    if ($errors -and $errors.Count -gt 0) {
        throw "Profile source has syntax errors already. Aborting: $($errors[0].Message)"
    }

    $funcAsts = $ast.FindAll({
        param($node)
        if ($node -is [System.Management.Automation.Language.FunctionDefinitionAst]) {
            $normalizedNodeName = Normalize-RmfuncFunctionName -Name $node.Name
            return $TargetNames.Contains($normalizedNodeName)
        }
        $false
    }, $true)

    $removed = New-Object 'System.Collections.Generic.List[string]'
    foreach ($func in ($funcAsts | Sort-Object { $_.Extent.StartOffset } -Descending)) {
        $start = $func.Extent.StartOffset
        $length = $func.Extent.EndOffset - $start
        $Source = $Source.Remove($start, $length)
        $removed.Add($func.Name) | Out-Null
    }

    [pscustomobject]@{
        Source = $Source
        Removed = @($removed)
    }
}

function Remove-RmfuncLazyProxyEntriesFromText {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Source,

        [Parameter(Mandatory = $true)]
        [System.Collections.Generic.HashSet[string]]$TargetNames
    )

    $newline = "`n"
    if ($Source.Contains("`r`n")) { $newline = "`r`n" }
    $hasFinalNewline = $Source.EndsWith("`n")
    $lines = [regex]::Split($Source, "`r`n|`n")
    if ($lines.Count -gt 0 -and $lines[$lines.Count - 1] -eq '') {
        if ($lines.Count -eq 1) {
            $lines = @()
        } else {
            $lines = $lines[0..($lines.Count - 2)]
        }
    }

    $kept = New-Object 'System.Collections.Generic.List[string]'
    $removed = New-Object 'System.Collections.Generic.List[string]'
    $insideFullProfileFunctionNames = $false

    foreach ($line in $lines) {
        if ($line -match '^\s*\$script:FullProfileFunctionNames\s*=\s*@\(') {
            $insideFullProfileFunctionNames = $true
        }

        $skip = $false
        if ($insideFullProfileFunctionNames -and $line -match "^\s*'([^']+)'\s*,?\s*$") {
            $entryName = Normalize-RmfuncFunctionName -Name $matches[1]
            if ($TargetNames.Contains($entryName)) {
                $removed.Add($matches[1]) | Out-Null
                $skip = $true
            }
        }

        if (-not $skip) {
            $kept.Add($line) | Out-Null
        }

        if ($insideFullProfileFunctionNames -and $line -match '^\s*\)\s*$') {
            $insideFullProfileFunctionNames = $false
        }
    }

    $newSource = [string]::Join($newline, $kept.ToArray())
    if ($hasFinalNewline) { $newSource += $newline }

    [pscustomobject]@{
        Source = $newSource
        Removed = @($removed)
    }
}

function rmfunc {
    [CmdletBinding(SupportsShouldProcess = $true)]
    param(
        [Parameter(Mandatory = $true, Position = 0)]
        [string[]]$Functions,

        [string[]]$ProfilePath
    )

    $targetNames = New-RmfuncFunctionNameSet -Functions $Functions
    if ($targetNames.Count -eq 0) {
        Write-Error 'No function names were provided.'
        return
    }

    $profilePaths = @(Get-RmfuncProfileSourcePaths -ProfilePath $ProfilePath)
    if ($profilePaths.Count -eq 0) {
        Write-Error 'No profile sources were found.'
        return
    }

    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $totalDefinitionRemovals = 0
    $totalProxyRemovals = 0
    $totalSessionRemovals = 0

    foreach ($profilePath in $profilePaths) {
        $source = [System.IO.File]::ReadAllText($profilePath)
        $encoding = Get-RmfuncTextEncoding -Path $profilePath
        $originalSource = $source

        $definitionResult = Remove-RmfuncFunctionDefinitionsFromText -Source $source -TargetNames $targetNames
        $source = $definitionResult.Source
        $proxyResult = Remove-RmfuncLazyProxyEntriesFromText -Source $source -TargetNames $targetNames
        $source = $proxyResult.Source

        if ($source -eq $originalSource) { continue }

        if ($PSCmdlet.ShouldProcess($profilePath, "remove profile function(s): $($targetNames -join ', ')")) {
            $backupPath = "$profilePath.bak-rmfunc-$stamp"
            Copy-Item -LiteralPath $profilePath -Destination $backupPath -Force
            [System.IO.File]::WriteAllText($profilePath, $source, $encoding)

            foreach ($removedFunction in $definitionResult.Removed) {
                Write-Host "Removed function definition: $removedFunction from $profilePath"
                $totalDefinitionRemovals++
            }
            foreach ($removedProxy in $proxyResult.Removed) {
                Write-Host "Removed lazy proxy entry: $removedProxy from $profilePath"
                $totalProxyRemovals++
            }
            Write-Host "Backup: $backupPath"
        }
    }

    foreach ($targetName in $targetNames) {
        $functionPath = "Function:\$targetName"
        if (Test-Path -LiteralPath $functionPath) {
            if ($PSCmdlet.ShouldProcess($functionPath, 'remove loaded function from current session')) {
                Remove-Item -LiteralPath $functionPath -Force -ErrorAction SilentlyContinue
                Write-Host "Removed loaded function from current session: $targetName"
                $totalSessionRemovals++
            }
        }
    }

    if (($totalDefinitionRemovals + $totalProxyRemovals + $totalSessionRemovals) -eq 0) {
        Write-Warning "No matching functions found."
        return
    }

    Write-Host "rmfunc completed. Removed $totalDefinitionRemovals definition(s), $totalProxyRemovals lazy proxy entry/entries, and $totalSessionRemovals loaded function(s)."
}

& $__extractedCommandName @__extractedArgs
