[CmdletBinding()]
param(
    [Alias('Test')]
    [switch]$Preview,
    [switch]$Run,
    [string]$AllowlistPath,
    [string]$RootPath = 'C:\',
    [switch]$SelfTest,
    [switch]$RecycleCodexLockOwners
)

$ErrorActionPreference = 'Stop'

if ([string]::IsNullOrWhiteSpace($AllowlistPath)) {
    $AllowlistPath = Join-Path -Path (Split-Path -Parent $PSCommandPath) -ChildPath 'cleanc-allowlist.txt'
}

$script:ForceDeleteAnythingPath = 'F:\study\projects\ForceDeleteAnything\publish\ForceDeleteAnything.exe'

function Get-CleancForceDeleteAnythingPath {
    if ([string]::IsNullOrWhiteSpace($script:ForceDeleteAnythingPath)) {
        $script:ForceDeleteAnythingPath = 'F:\study\projects\ForceDeleteAnything\publish\ForceDeleteAnything.exe'
    }

    return $script:ForceDeleteAnythingPath
}

function Resolve-CleancRootPath {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    $item = Get-Item -LiteralPath $Path -ErrorAction Stop
    if (-not $item.PSIsContainer) {
        throw "cleanc root path must be a directory: $Path"
    }

    $resolved = [System.IO.Path]::GetFullPath($item.FullName).TrimEnd('\')
    if ($resolved.Length -eq 2 -and $resolved[1] -eq ':') {
        return $resolved + '\'
    }

    return $resolved
}

function Test-CleancSystemRoot {
    param(
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath
    )

    return $ResolvedRootPath.TrimEnd('\') -ieq 'C:'
}

function Get-CleancRelativeName {
    param(
        [Parameter(Mandatory = $true)]
        [System.IO.FileSystemInfo]$Item,
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath
    )

    $rootPrefix = $ResolvedRootPath.TrimEnd('\') + '\'
    if (-not $Item.FullName.StartsWith($rootPrefix, [System.StringComparison]::OrdinalIgnoreCase)) {
        return $null
    }

    $relative = $Item.FullName.Substring($rootPrefix.Length).TrimStart('\')
    if ([string]::IsNullOrWhiteSpace($relative) -or $relative.Contains('\')) {
        return $null
    }

    return $relative
}

function Get-CleancRootInventory {
    param(
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath
    )

    $items = Get-ChildItem -LiteralPath $ResolvedRootPath -Force -ErrorAction Stop
    foreach ($item in $items) {
        $name = Get-CleancRelativeName -Item $item -ResolvedRootPath $ResolvedRootPath
        if ($null -eq $name) {
            continue
        }

        [pscustomobject]@{
            Name      = $name
            FullName  = $item.FullName
            ItemType  = if ($item.PSIsContainer) { 'Directory' } else { 'File' }
            Attributes = [string]$item.Attributes
            IsDirectory = [bool]$item.PSIsContainer
            IsReparsePoint = [bool]($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint)
        }
    }
}

function Read-CleancAllowlist {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path,
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        throw "cleanc allowlist not found: $Path"
    }

    $entries = New-Object 'System.Collections.Generic.List[string]'
    $names = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    $lineNumber = 0
    foreach ($rawLine in [System.IO.File]::ReadAllLines($Path)) {
        $lineNumber++
        $line = $rawLine.Trim()
        if ([string]::IsNullOrWhiteSpace($line)) {
            continue
        }
        if ($line.StartsWith('#') -or $line.StartsWith(';')) {
            continue
        }

        $candidateName = $null
        if ([System.IO.Path]::IsPathRooted($line)) {
            $resolvedEntry = [System.IO.Path]::GetFullPath($line)
            $rootPrefix = $ResolvedRootPath.TrimEnd('\') + '\'
            if (-not $resolvedEntry.StartsWith($rootPrefix, [System.StringComparison]::OrdinalIgnoreCase)) {
                throw "cleanc allowlist line $lineNumber is outside root ${ResolvedRootPath}: $line"
            }

            $relative = $resolvedEntry.Substring($rootPrefix.Length).TrimStart('\')
            if ([string]::IsNullOrWhiteSpace($relative) -or $relative.Contains('\')) {
                throw "cleanc allowlist line $lineNumber must target a direct child of ${ResolvedRootPath}: $line"
            }

            $candidateName = $relative
        } else {
            if ($line.Contains('\') -or $line.Contains('/')) {
                throw "cleanc allowlist line $lineNumber must be a root item name or rooted path: $line"
            }

            $candidateName = $line
        }

        if ($names.Add($candidateName)) {
            $entries.Add($candidateName) | Out-Null
        }
    }

    if ($entries.Count -eq 0) {
        throw "cleanc allowlist is empty: $Path"
    }

    [pscustomobject]@{
        Path = $Path
        Entries = @($entries)
        EntrySet = $names
    }
}

function Test-CleancCriticalAllowlist {
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Inventory,
        [Parameter(Mandatory = $true)]
        [System.Collections.Generic.HashSet[string]]$AllowlistSet,
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath
    )

    if (-not (Test-CleancSystemRoot -ResolvedRootPath $ResolvedRootPath)) {
        return
    }

    $requiredNames = @(
        'boot',
        'bootmgr',
        'Program Files',
        'Program Files (x86)',
        'ProgramData',
        'System Volume Information',
        'Users',
        'Windows'
    )

    $present = $Inventory | ForEach-Object { $_.Name }
    $missing = @(foreach ($name in $requiredNames) {
        if (($present -icontains $name) -and -not $AllowlistSet.Contains($name)) {
            $name
        }
    })

    if ($missing.Count -gt 0) {
        throw "cleanc allowlist refuses destructive execution because critical root items are not allowlisted: $($missing -join ', ')"
    }
}

function New-CleancPlan {
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$Inventory,
        [Parameter(Mandatory = $true)]
        [System.Collections.Generic.HashSet[string]]$AllowlistSet
    )

    $plan = foreach ($item in $Inventory | Sort-Object Name) {
        $keep = $AllowlistSet.Contains($item.Name)
        [pscustomobject]@{
            Name = $item.Name
            FullName = $item.FullName
            ItemType = $item.ItemType
            Attributes = $item.Attributes
            IsDirectory = $item.IsDirectory
            IsReparsePoint = $item.IsReparsePoint
            Keep = $keep
            Delete = -not $keep
        }
    }

    [pscustomobject]@{
        Keep = @($plan | Where-Object { $_.Keep })
        Delete = @($plan | Where-Object { $_.Delete })
        All = @($plan)
    }
}

function Show-CleancPreview {
    param(
        [Parameter(Mandatory = $true)]
        [pscustomobject]$Plan,
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath,
        [Parameter(Mandatory = $true)]
        [string]$AllowlistPath
    )

    Write-Host "cleanc preview root: $ResolvedRootPath" -ForegroundColor Yellow
    Write-Host "cleanc allowlist: $AllowlistPath" -ForegroundColor Yellow
    Write-Host "Keep count: $($Plan.Keep.Count)" -ForegroundColor Green
    Write-Host "Delete count: $($Plan.Delete.Count)" -ForegroundColor Cyan
    Write-Host ''

    Write-Host '[KEEP]' -ForegroundColor Green
    foreach ($item in $Plan.Keep) {
        Write-Host ("  {0} [{1}] [{2}]" -f $item.FullName, $item.ItemType, $item.Attributes)
    }

    Write-Host ''
    Write-Host '[DELETE]' -ForegroundColor Cyan
    if ($Plan.Delete.Count -eq 0) {
        Write-Host '  Nothing would be deleted.' -ForegroundColor Green
        return
    }

    foreach ($item in $Plan.Delete) {
        Write-Host ("  {0} [{1}] [{2}]" -f $item.FullName, $item.ItemType, $item.Attributes)
    }
}

function Test-CleancAdministrator {
    $principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
    return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

function Get-CleancApproxBytes {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path,
        [Parameter(Mandatory = $true)]
        [bool]$IsDirectory
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return [int64]0
    }

    try {
        if (-not $IsDirectory) {
            return [int64](Get-Item -LiteralPath $Path -Force -ErrorAction Stop).Length
        }

        $measure = Get-ChildItem -LiteralPath $Path -Force -Recurse -File -ErrorAction SilentlyContinue |
            Measure-Object -Property Length -Sum
        if ($null -eq $measure.Sum) {
            return [int64]0
        }

        return [int64]$measure.Sum
    } catch {
        return [int64]0
    }
}

function Format-CleancMB {
    param(
        [Parameter(Mandatory = $true)]
        [Int64]$Bytes
    )

    return ('{0:N1}' -f ($Bytes / 1MB))
}

function Exit-CleancTargetLocation {
    param(
        [Parameter(Mandatory = $true)]
        [string]$TargetPath,
        [Parameter(Mandatory = $true)]
        [string]$FallbackPath
    )

    try {
        $currentPath = (Get-Location).ProviderPath
        if ([string]::IsNullOrWhiteSpace($currentPath)) {
            return $false
        }

        $normalizedCurrent = [System.IO.Path]::GetFullPath($currentPath).TrimEnd('\')
        $normalizedTarget = [System.IO.Path]::GetFullPath($TargetPath).TrimEnd('\')
        $insideTarget = $normalizedCurrent.Length -ge $normalizedTarget.Length -and (
            $normalizedCurrent.Equals($normalizedTarget, [System.StringComparison]::OrdinalIgnoreCase) -or
            $normalizedCurrent.StartsWith($normalizedTarget + '\', [System.StringComparison]::OrdinalIgnoreCase)
        )

        if (-not $insideTarget) {
            return $false
        }

        Set-Location -LiteralPath $FallbackPath
        return $true
    } catch {
        return $false
    }
}

function New-CleancDeleteResult {
    param(
        [Parameter(Mandatory = $true)]
        [pscustomobject]$Item
    )

    return [ordered]@{
        Name = $Item.Name
        Path = $Item.FullName
        ItemType = if ($Item.IsDirectory) { 'Directory' } else { 'File' }
        Succeeded = $false
        Reason = ''
        Method = ''
        PermissionEscalated = $false
        ServiceStops = @()
    }
}

function Invoke-CleancFastDeleteAttempt {
    param(
        [Parameter(Mandatory = $true)]
        [pscustomobject]$Item
    )

    $result = New-CleancDeleteResult -Item $Item

    function Test-Gone {
        param([string]$Path)
        return -not (Test-Path -LiteralPath $Path)
    }

    function Invoke-NativeDelete {
        param([string]$CommandLine)
        & $env:ComSpec /d /c $CommandLine | Out-Null
    }

    if (Test-Gone -Path $Item.FullName) {
        $result.Succeeded = $true
        $result.Reason = 'Already absent.'
        $result.Method = 'NoOp'
        return [pscustomobject]$result
    }

    $forceDeleteAnythingPath = Get-CleancForceDeleteAnythingPath
    if (-not (Test-Path -LiteralPath $forceDeleteAnythingPath -PathType Leaf)) {
        throw "ForceDeleteAnything executable not found: $forceDeleteAnythingPath"
    }

    try {
        $global:LASTEXITCODE = 0
        & $forceDeleteAnythingPath delete --force --kill-lockers --success-pending --progress terminal $Item.FullName
        $forceDeleteExitCode = $global:LASTEXITCODE

        if (Test-Gone -Path $Item.FullName) {
            $result.Succeeded = $true
            $result.Reason = "Deleted with ForceDeleteAnything.exe exit=$forceDeleteExitCode."
            $result.Method = 'ForceDeleteAnything'
            return [pscustomobject]$result
        }

        if ($forceDeleteExitCode -eq 0) {
            $result.Succeeded = $true
            $result.Reason = 'ForceDeleteAnything.exe completed successfully; target still exists now and is treated as pending reboot cleanup.'
            $result.Method = 'PendingReboot'
            return [pscustomobject]$result
        }
    } catch {
        Write-Warning ("ForceDeleteAnything.exe failed for {0}: {1}" -f $Item.FullName, $_.Exception.Message)
    }

    if ($Item.IsReparsePoint) {
        try {
            if ($Item.IsDirectory) {
                Invoke-NativeDelete -CommandLine ("rmdir `"{0}`" >nul 2>&1" -f $Item.FullName)
            } else {
                Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $Item.FullName)
            }

            if (Test-Gone -Path $Item.FullName) {
                $result.Succeeded = $true
                $result.Reason = 'Deleted reparse point link.'
                $result.Method = 'ReparseNative'
                return [pscustomobject]$result
            }
        } catch {
        }

        try {
            Remove-Item -LiteralPath $Item.FullName -Force -ErrorAction Stop
            if (Test-Gone -Path $Item.FullName) {
                $result.Succeeded = $true
                $result.Reason = 'Deleted reparse point link with Remove-Item.'
                $result.Method = 'ReparseRemoveItem'
                return [pscustomobject]$result
            }
        } catch {
        }

        $result.Reason = 'Fast reparse delete path was not enough.'
        $result.Method = 'NeedsEscalation'
        return [pscustomobject]$result
    }

    try {
        if ($Item.IsDirectory) {
            Invoke-NativeDelete -CommandLine ("rd /s /q `"{0}`" >nul 2>&1" -f $Item.FullName)
        } else {
            Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $Item.FullName)
        }

        if (Test-Gone -Path $Item.FullName) {
            $result.Succeeded = $true
            $result.Reason = 'Deleted with quick native delete.'
            $result.Method = if ($Item.IsDirectory) { 'QuickRd' } else { 'QuickDel' }
            return [pscustomobject]$result
        }
    } catch {
    }

    try {
        if ($Item.IsDirectory) {
            Remove-Item -LiteralPath $Item.FullName -Recurse -Force -ErrorAction Stop
        } else {
            Remove-Item -LiteralPath $Item.FullName -Force -ErrorAction Stop
        }

        if (Test-Gone -Path $Item.FullName) {
            $result.Succeeded = $true
            $result.Reason = 'Deleted with Remove-Item before escalation.'
            $result.Method = 'RemoveItemFast'
            return [pscustomobject]$result
        }
    } catch {
    }

    $result.Reason = 'Fast delete path was not enough.'
    $result.Method = 'NeedsEscalation'
    return [pscustomobject]$result
}

function Invoke-CleancDeleteJob {
    param(
        [Parameter(Mandatory = $true)]
        [pscustomobject]$Item,
        [Parameter(Mandatory = $true)]
        [bool]$SystemRoot,
        [Parameter(Mandatory = $true)]
        [bool]$RecycleCodexLockOwners
    )

    $jobScript = {
        param(
            [string]$ItemPath,
            [string]$ItemName,
            [bool]$IsDirectory,
            [bool]$IsReparsePoint,
            [bool]$SystemRoot,
            [bool]$RecycleCodexLockOwners
        )

        $result = [ordered]@{
            Name = $ItemName
            Path = $ItemPath
            ItemType = if ($IsDirectory) { 'Directory' } else { 'File' }
            Succeeded = $false
            Reason = ''
            Method = ''
            PermissionEscalated = $false
            ServiceStops = @()
        }

        function Test-Gone {
            param([string]$Path)
            return -not (Test-Path -LiteralPath $Path)
        }

        function Invoke-NativeDelete {
            param([string]$CommandLine)
            & $env:ComSpec /d /c $CommandLine | Out-Null
        }

        function Register-PendingDelete {
            param([string]$Path)

            if ([string]::IsNullOrWhiteSpace($Path) -or -not (Test-Path -LiteralPath $Path)) {
                return $false
            }

            if (-not ('Cleanc.NativeMethods' -as [type])) {
                Add-Type -TypeDefinition @'
namespace Cleanc {
    using System;
    using System.Runtime.InteropServices;

    public static class NativeMethods {
        [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
        public static extern bool MoveFileEx(string lpExistingFileName, System.IntPtr lpNewFileName, int dwFlags);
    }
}
'@
            }

            return [Cleanc.NativeMethods]::MoveFileEx($Path, [IntPtr]::Zero, 4)
        }

        function Register-PendingDeleteTree {
            param(
                [string]$Path,
                [bool]$Directory
            )

            $registered = 0
            if ($Directory -and (Test-Path -LiteralPath $Path)) {
                try {
                    $children = @(Get-ChildItem -LiteralPath $Path -Force -Recurse -ErrorAction SilentlyContinue |
                        Sort-Object @{ Expression = { $_.FullName.Length }; Descending = $true })
                    foreach ($child in $children) {
                        if (Register-PendingDelete -Path $child.FullName) {
                            $registered++
                        }
                    }
                } catch {
                }
            }

            if (Register-PendingDelete -Path $Path) {
                $registered++
            }

            return $registered
        }

        function Get-ProcessByIdSafe {
            param([int]$ProcessId)

            try {
                return Get-CimInstance Win32_Process -Filter ("ProcessId={0}" -f $ProcessId) -ErrorAction Stop
            } catch {
                return $null
            }
        }

        function Get-SafeRestartRoot {
            param([int]$ProcessId)

            $safeRootNames = @('Telegram.exe', 'Todoist.exe', 'murmure.exe', 'Wand.exe')
            $blockedRootNames = @('powershell.exe', 'pwsh.exe')
            if ($RecycleCodexLockOwners) {
                $safeRootNames += 'Codex.exe'
            } else {
                $blockedRootNames += 'Codex.exe'
            }
            $seen = New-Object 'System.Collections.Generic.HashSet[int]'
            $currentId = $ProcessId

            while ($currentId -gt 0 -and $seen.Add($currentId)) {
                $process = Get-ProcessByIdSafe -ProcessId $currentId
                if ($null -eq $process) {
                    return $null
                }

                if ($blockedRootNames -icontains $process.Name) {
                    return $null
                }

                if ($safeRootNames -icontains $process.Name) {
                    return $process
                }

                $currentId = [int]$process.ParentProcessId
            }

            return $null
        }

        function Invoke-SafeLockOwnerRecycle {
            param(
                [string]$Path,
                [bool]$Directory
            )

            $handlePath = Join-Path -Path $env:USERPROFILE -ChildPath '.codex\tools\sysinternals-handle\handle64.exe'
            if (-not (Test-Path -LiteralPath $handlePath -PathType Leaf)) {
                return [pscustomobject]@{ Attempted = $false; Stopped = @(); Restarted = @(); Reason = 'handle64.exe not found.' }
            }

            try {
                $handleOutput = @(& $handlePath -accepteula -nobanner $Path 2>$null)
            } catch {
                return [pscustomobject]@{ Attempted = $false; Stopped = @(); Restarted = @(); Reason = 'handle64.exe failed.' }
            }

            $rootsByPid = @{}
            foreach ($line in $handleOutput) {
                if ($line -notmatch '^\s*(?<name>\S+)\s+pid:\s+(?<pid>\d+)\s+') {
                    continue
                }

                $root = Get-SafeRestartRoot -ProcessId ([int]$Matches.pid)
                if ($null -eq $root -or [string]::IsNullOrWhiteSpace($root.ExecutablePath)) {
                    continue
                }

                $rootsByPid[[int]$root.ProcessId] = $root
            }

            if ($rootsByPid.Count -eq 0) {
                return [pscustomobject]@{ Attempted = $true; Stopped = @(); Restarted = @(); Reason = 'No safe restartable lock owners found.' }
            }

            $restartPaths = New-Object 'System.Collections.Generic.List[string]'
            $stoppedNames = New-Object 'System.Collections.Generic.List[string]'
            foreach ($root in $rootsByPid.Values) {
                if (-not [string]::IsNullOrWhiteSpace($root.ExecutablePath) -and (Test-Path -LiteralPath $root.ExecutablePath -PathType Leaf)) {
                    $restartPaths.Add($root.ExecutablePath) | Out-Null
                }

                try {
                    Stop-Process -Id ([int]$root.ProcessId) -Force -ErrorAction Stop
                    $stoppedNames.Add(("{0}:{1}" -f $root.Name, $root.ProcessId)) | Out-Null
                } catch {
                }
            }

            Start-Sleep -Milliseconds 350

            try {
                if ($Directory) {
                    Invoke-NativeDelete -CommandLine ("rd /s /q `"{0}`" >nul 2>&1" -f $Path)
                } else {
                    Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $Path)
                }
            } catch {
            }

            $restarted = New-Object 'System.Collections.Generic.List[string]'
            foreach ($restartPath in ($restartPaths | Select-Object -Unique)) {
                try {
                    Start-Process -FilePath $restartPath
                    $restarted.Add($restartPath) | Out-Null
                } catch {
                }
            }

            return [pscustomobject]@{
                Attempted = $true
                Stopped = @($stoppedNames)
                Restarted = @($restarted)
                Reason = 'Recycled safe lock owners.'
            }
        }

        function Invoke-QuickDelete {
            param(
                [string]$Path,
                [bool]$Directory
            )

            try {
                if ($Directory) {
                    Invoke-NativeDelete -CommandLine ("rd /s /q `"{0}`" >nul 2>&1" -f $Path)
                } else {
                    Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $Path)
                }
            } catch {
            }
        }

        function Invoke-PermissionEscalation {
            param(
                [string]$Path,
                [bool]$Directory
            )

            if ($Directory) {
                Invoke-NativeDelete -CommandLine ("takeown /f `"{0}`" /r /d y >nul 2>&1" -f $Path)
                Invoke-NativeDelete -CommandLine ("icacls `"{0}`" /grant `"{1}`":F /t /c /q >nul 2>&1" -f $Path, $env:USERNAME)
                Invoke-NativeDelete -CommandLine ("icacls `"{0}`" /grant Everyone:F /t /c /q >nul 2>&1" -f $Path)
                Invoke-NativeDelete -CommandLine ("attrib -r -h -s `"{0}`" >nul 2>&1" -f $Path)
            } else {
                Invoke-NativeDelete -CommandLine ("takeown /f `"{0}`" >nul 2>&1" -f $Path)
                Invoke-NativeDelete -CommandLine ("icacls `"{0}`" /grant `"{1}`":F /c /q >nul 2>&1" -f $Path, $env:USERNAME)
                Invoke-NativeDelete -CommandLine ("icacls `"{0}`" /grant Everyone:F /c /q >nul 2>&1" -f $Path)
                Invoke-NativeDelete -CommandLine ("attrib -r -h -s `"{0}`" >nul 2>&1" -f $Path)
            }

            $result.PermissionEscalated = $true
        }

        function Stop-BlockingServicesForItem {
            param(
                [string]$Name
            )

            if ($Name -ine 'inetpub') {
                return
            }

            $serviceNames = @('W3SVC', 'ftpsvc', 'WMSVC', 'WAS', 'IISADMIN', 'AppHostSvc')
            foreach ($serviceName in $serviceNames) {
                try {
                    $service = Get-Service -Name $serviceName -ErrorAction SilentlyContinue
                    if ($null -ne $service -and $service.Status -ne 'Stopped') {
                        Stop-Service -Name $serviceName -Force -ErrorAction Stop
                        $result.ServiceStops += $serviceName
                    }
                } catch {
                }
            }
        }

        if ([string]::IsNullOrWhiteSpace($ItemPath)) {
            $result.Reason = 'Blank item path.'
            return [pscustomobject]$result
        }

        Stop-BlockingServicesForItem -Name $ItemName

        if (Test-Gone -Path $ItemPath) {
            $result.Succeeded = $true
            $result.Reason = 'Already absent.'
            $result.Method = 'NoOp'
            return [pscustomobject]$result
        }

        if ($IsReparsePoint) {
            try {
                if ($IsDirectory) {
                    Invoke-NativeDelete -CommandLine ("rmdir `"{0}`" >nul 2>&1" -f $ItemPath)
                } else {
                    Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $ItemPath)
                }

                if (Test-Gone -Path $ItemPath) {
                    $result.Succeeded = $true
                    $result.Reason = 'Deleted reparse point link.'
                    $result.Method = 'ReparseNative'
                    return [pscustomobject]$result
                }
            } catch {
            }

            try {
                Invoke-PermissionEscalation -Path $ItemPath -Directory:$IsDirectory
                if ($IsDirectory) {
                    Invoke-NativeDelete -CommandLine ("rmdir `"{0}`" >nul 2>&1" -f $ItemPath)
                } else {
                    Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $ItemPath)
                }

                if (Test-Gone -Path $ItemPath) {
                    $result.Succeeded = $true
                    $result.Reason = 'Deleted reparse point link after permission escalation.'
                    $result.Method = 'ReparseEscalated'
                    return [pscustomobject]$result
                }
            } catch {
            }

            try {
                Remove-Item -LiteralPath $ItemPath -Force -ErrorAction Stop
                if (Test-Gone -Path $ItemPath) {
                    $result.Succeeded = $true
                    $result.Reason = 'Deleted reparse point link with Remove-Item.'
                    $result.Method = 'ReparseRemoveItem'
                    return [pscustomobject]$result
                }
            } catch {
            }

            $result.Reason = 'Reparse point still exists after link delete attempts.'
            $result.Method = 'ReparseFailed'
            return [pscustomobject]$result
        }

        try {
            Invoke-QuickDelete -Path $ItemPath -Directory:$IsDirectory
        } catch {
        }

        if (Test-Gone -Path $ItemPath) {
            $result.Succeeded = $true
            $result.Reason = 'Deleted with quick native delete.'
            $result.Method = if ($IsDirectory) { 'QuickRd' } else { 'QuickDel' }
            return [pscustomobject]$result
        }

        try {
            if ($IsDirectory) {
                Remove-Item -LiteralPath $ItemPath -Recurse -Force -ErrorAction Stop
            } else {
                Remove-Item -LiteralPath $ItemPath -Force -ErrorAction Stop
            }
        } catch {
        }

        if (Test-Gone -Path $ItemPath) {
            $result.Succeeded = $true
            $result.Reason = 'Deleted with Remove-Item before permission escalation.'
            $result.Method = 'RemoveItemFast'
            return [pscustomobject]$result
        }

        try {
            Invoke-PermissionEscalation -Path $ItemPath -Directory:$IsDirectory
        } catch {
        }

        if ($IsDirectory) {
            try {
                Invoke-NativeDelete -CommandLine ("rd /s /q `"{0}`" >nul 2>&1" -f $ItemPath)
            } catch {
            }

            if (Test-Gone -Path $ItemPath) {
                $result.Succeeded = $true
                $result.Reason = 'Deleted with native directory delete after permission escalation.'
                $result.Method = 'NativeRd'
                return [pscustomobject]$result
            }
        } else {
            try {
                Invoke-NativeDelete -CommandLine ("del /f /q `"{0}`" >nul 2>&1" -f $ItemPath)
            } catch {
            }

            if (Test-Gone -Path $ItemPath) {
                $result.Succeeded = $true
                $result.Reason = 'Deleted with native file delete after permission escalation.'
                $result.Method = 'NativeDel'
                return [pscustomobject]$result
            }
        }

        try {
            if ($IsDirectory) {
                Remove-Item -LiteralPath $ItemPath -Recurse -Force -ErrorAction Stop
            } else {
                Remove-Item -LiteralPath $ItemPath -Force -ErrorAction Stop
            }

            if (Test-Gone -Path $ItemPath) {
                $result.Succeeded = $true
                $result.Reason = 'Deleted with Remove-Item.'
                $result.Method = 'RemoveItem'
                return [pscustomobject]$result
            }
        } catch {
        }

        if ($IsDirectory) {
            try {
                $tempRoot = [System.IO.Path]::GetTempPath()
                $normalizedTempRoot = [System.IO.Path]::GetFullPath($tempRoot).TrimEnd('\')
                $normalizedItemPath = [System.IO.Path]::GetFullPath($ItemPath).TrimEnd('\')
                if ($normalizedTempRoot.Equals($normalizedItemPath, [System.StringComparison]::OrdinalIgnoreCase) -or
                    $normalizedTempRoot.StartsWith($normalizedItemPath + '\', [System.StringComparison]::OrdinalIgnoreCase)) {
                    $tempRoot = Join-Path -Path $env:SystemRoot -ChildPath 'Temp'
                }

                $emptyDir = Join-Path -Path $tempRoot -ChildPath ('cleanc-empty-' + [guid]::NewGuid().ToString('N'))
                New-Item -ItemType Directory -Path $emptyDir -Force | Out-Null
                Invoke-NativeDelete -CommandLine ("robocopy `"{0}`" `"{1}`" /MIR /XJ /R:0 /W:0 /NFL /NDL /NJH /NJS /NC /NS >nul 2>&1" -f $emptyDir, $ItemPath)
                Remove-Item -LiteralPath $emptyDir -Recurse -Force -ErrorAction SilentlyContinue
                Invoke-NativeDelete -CommandLine ("rd /s /q `"{0}`" >nul 2>&1" -f $ItemPath)
                if (Test-Gone -Path $ItemPath) {
                    $result.Succeeded = $true
                    $result.Reason = 'Deleted after robocopy mirror reset.'
                    $result.Method = 'RobocopyReset'
                    return [pscustomobject]$result
                }
            } catch {
            }
        }

        if (Test-Gone -Path $ItemPath) {
            $result.Succeeded = $true
            $result.Reason = 'Path disappeared during verification.'
            $result.Method = 'VerifyOnly'
            return [pscustomobject]$result
        }

        $recycle = Invoke-SafeLockOwnerRecycle -Path $ItemPath -Directory:$IsDirectory
        if ($recycle.Attempted -and $recycle.Stopped.Count -gt 0 -and (Test-Gone -Path $ItemPath)) {
            $result.Succeeded = $true
            $result.Reason = "Deleted after recycling safe lock owners: $($recycle.Stopped -join ', ')."
            $result.Method = 'RecycleLockOwners'
            return [pscustomobject]$result
        }

        $pendingCount = Register-PendingDeleteTree -Path $ItemPath -Directory:$IsDirectory
        if ($pendingCount -gt 0) {
            $result.Succeeded = $true
            $result.Reason = "Locked item still exists now; registered $pendingCount path(s) for deletion at next reboot."
            $result.Method = 'PendingReboot'
            return [pscustomobject]$result
        }

        $result.Reason = 'Item still exists after all delete attempts.'
        $result.Method = 'Failed'
        return [pscustomobject]$result
    }

    Start-Job -ScriptBlock $jobScript -ArgumentList @(
        $Item.FullName,
        $Item.Name,
        $Item.IsDirectory,
        $Item.IsReparsePoint,
        $SystemRoot,
        $RecycleCodexLockOwners
    )
}

function Invoke-CleancRun {
    param(
        [Parameter(Mandatory = $true)]
        [pscustomobject]$Plan,
        [Parameter(Mandatory = $true)]
        [string]$ResolvedRootPath,
        [Parameter(Mandatory = $true)]
        [bool]$RecycleCodexLockOwners
    )

    if ($Plan.Delete.Count -eq 0) {
        Write-Host "cleanc run root: $ResolvedRootPath" -ForegroundColor Yellow
        Write-Host 'Nothing to delete.' -ForegroundColor Green
        return @()
    }

    $systemRoot = Test-CleancSystemRoot -ResolvedRootPath $ResolvedRootPath
    if ($systemRoot -and -not (Test-CleancAdministrator)) {
        throw 'cleanc destructive C:\ cleanup requires an elevated Administrator PowerShell session.'
    }
    $forceDeleteAnythingPath = Get-CleancForceDeleteAnythingPath
    if ($systemRoot -and -not (Test-Path -LiteralPath $forceDeleteAnythingPath -PathType Leaf)) {
        throw "cleanc destructive C:\ cleanup requires ForceDeleteAnything.exe at: $forceDeleteAnythingPath"
    }

    $total = $Plan.Delete.Count
    $overallStopwatch = [System.Diagnostics.Stopwatch]::StartNew()
    $completed = 0
    $ok = 0
    $fail = 0
    $results = @()
    [int64]$bytesFreedTotal = 0

    Write-Host "cleanc run root: $ResolvedRootPath" -ForegroundColor Yellow
    Write-Host ("Starting delete pass for {0} root items." -f $total) -ForegroundColor Yellow

    foreach ($item in $Plan.Delete) {
        $itemStopwatch = [System.Diagnostics.Stopwatch]::StartNew()
        if (Exit-CleancTargetLocation -TargetPath $item.FullName -FallbackPath $ResolvedRootPath) {
            Write-Host ("[INFO] moved current location to {0} before deleting {1}" -f $ResolvedRootPath, $item.FullName) -ForegroundColor Yellow
        }
        [int64]$itemInitialBytes = if ($systemRoot) { [int64]0 } else { Get-CleancApproxBytes -Path $item.FullName -IsDirectory:$item.IsDirectory }
        $fastResult = Invoke-CleancFastDeleteAttempt -Item $item
        if ($fastResult.Succeeded) {
            $completed++
            [int64]$itemFreedBytes = $itemInitialBytes
            $bytesFreedTotal += $itemFreedBytes
            $ok++
            Write-Host ("[OK] {0} [{1}] via {2} ({3}) freedMB={4} escalated={5}" -f $fastResult.Path, $fastResult.ItemType, $fastResult.Method, $fastResult.Reason, (Format-CleancMB -Bytes $itemFreedBytes), $fastResult.PermissionEscalated) -ForegroundColor Green
            $results += $fastResult
            continue
        }

        $job = Invoke-CleancDeleteJob -Item $item -SystemRoot:$systemRoot -RecycleCodexLockOwners:$RecycleCodexLockOwners
        try {
            while ($true) {
                $state = (Get-Job -Id $job.Id).State
                if ($state -ne 'Running' -and $state -ne 'NotStarted') {
                    break
                }

                [int64]$itemCurrentBytes = Get-CleancApproxBytes -Path $item.FullName -IsDirectory:$item.IsDirectory
                [int64]$itemFreedBytes = [Math]::Max([int64]0, $itemInitialBytes - $itemCurrentBytes)
                [int64]$liveTotalBytes = $bytesFreedTotal + $itemFreedBytes
                $percent = [math]::Floor((($completed) / [math]::Max($total, 1)) * 100)
                $status = "elapsed=$($overallStopwatch.Elapsed.ToString('hh\:mm\:ss\.fff')) completed=$completed/$total ok=$ok fail=$fail current=$($item.Name) itemElapsed=$($itemStopwatch.Elapsed.ToString('hh\:mm\:ss\.fff')) freedMB=$((Format-CleancMB -Bytes $itemFreedBytes)) totalFreedMB=$((Format-CleancMB -Bytes $liveTotalBytes))"
                Write-Progress -Activity 'cleanc delete pass' -Status $status -PercentComplete $percent
                Write-Host "[PROGRESS] $status" -ForegroundColor DarkGray
                Start-Sleep -Milliseconds 250
            }

            $result = Receive-Job -Id $job.Id -ErrorAction Stop
            $completed++
            [int64]$itemFinalBytes = Get-CleancApproxBytes -Path $item.FullName -IsDirectory:$item.IsDirectory
            [int64]$itemFreedBytes = if ($result.Succeeded) { $itemInitialBytes } else { [Math]::Max([int64]0, $itemInitialBytes - $itemFinalBytes) }
            $bytesFreedTotal += $itemFreedBytes
            if ($result.Succeeded) {
                $ok++
                Write-Host ("[OK] {0} [{1}] via {2} ({3}) freedMB={4} escalated={5}" -f $result.Path, $result.ItemType, $result.Method, $result.Reason, (Format-CleancMB -Bytes $itemFreedBytes), $result.PermissionEscalated) -ForegroundColor Green
            } else {
                $fail++
                Write-Host ("[FAIL] {0} [{1}] via {2} ({3}) freedMB={4} escalated={5}" -f $result.Path, $result.ItemType, $result.Method, $result.Reason, (Format-CleancMB -Bytes $itemFreedBytes), $result.PermissionEscalated) -ForegroundColor Red
            }
            $results += $result
        } finally {
            Remove-Job -Id $job.Id -Force -ErrorAction SilentlyContinue
        }
    }

    Write-Progress -Activity 'cleanc delete pass' -Completed
    Write-Host ("Delete pass complete in {0}: ok={1} fail={2} total={3} totalFreedMB={4}" -f $overallStopwatch.Elapsed.ToString('hh\:mm\:ss\.fff'), $ok, $fail, $total, (Format-CleancMB -Bytes $bytesFreedTotal)) -ForegroundColor Yellow
    return $results
}

function Show-CleancVerification {
    param(
        [Parameter(Mandatory = $true)]
        [object[]]$PostInventory,
        [Parameter(Mandatory = $true)]
        [System.Collections.Generic.HashSet[string]]$AllowlistSet,
        [AllowEmptyCollection()]
        [object[]]$DeleteResults
    )

    $pendingResults = @($DeleteResults | Where-Object { $_.Succeeded -and $_.Method -eq 'PendingReboot' })
    $pendingPaths = @($pendingResults | ForEach-Object { [System.IO.Path]::GetFullPath($_.Path).TrimEnd('\') })
    $unexpected = @($PostInventory | Where-Object {
        if ($AllowlistSet.Contains($_.Name)) {
            return $false
        }

        $survivorPath = [System.IO.Path]::GetFullPath($_.FullName).TrimEnd('\')
        foreach ($pendingPath in $pendingPaths) {
            if ($survivorPath.Equals($pendingPath, [System.StringComparison]::OrdinalIgnoreCase) -or
                $survivorPath.StartsWith($pendingPath + '\', [System.StringComparison]::OrdinalIgnoreCase)) {
                return $false
            }
        }

        return $true
    })
    $failedResults = @($DeleteResults | Where-Object { -not $_.Succeeded })

    Write-Host ''
    Write-Host '[VERIFICATION]' -ForegroundColor Yellow
    Write-Host ("Remaining root items: {0}" -f $PostInventory.Count) -ForegroundColor Yellow
    Write-Host ("Unexpected survivors: {0}" -f $unexpected.Count) -ForegroundColor Yellow
    if ($pendingResults.Count -gt 0) {
        Write-Host ("Pending reboot deletions: {0}" -f $pendingResults.Count) -ForegroundColor Yellow
        foreach ($pending in $pendingResults) {
            Write-Host ("  [PENDING] {0} [{1}] reason={2}" -f $pending.Path, $pending.ItemType, $pending.Reason) -ForegroundColor Yellow
        }
    }

    if ($unexpected.Count -eq 0) {
        if ($pendingResults.Count -gt 0) {
            Write-Host 'Verification passed: every remaining non-allowlisted root item is registered for reboot deletion.' -ForegroundColor Green
        } else {
            Write-Host 'Verification passed: every remaining root item is allowlisted.' -ForegroundColor Green
        }
    } else {
        foreach ($item in $unexpected) {
            $match = $failedResults | Where-Object { $_.Path -ieq $item.FullName } | Select-Object -First 1
            $reason = if ($match) { $match.Reason } else { 'Unexpected survivor after run.' }
            Write-Host ("  [SURVIVOR] {0} [{1}] reason={2}" -f $item.FullName, $item.Attributes, $reason) -ForegroundColor Red
        }
    }
}

$resolvedRootPath = Resolve-CleancRootPath -Path $RootPath
$inventory = @(Get-CleancRootInventory -ResolvedRootPath $resolvedRootPath)

if ($SelfTest) {
    [pscustomobject]@{
        Script = $PSCommandPath
        AllowlistPath = $AllowlistPath
        AllowlistExists = (Test-Path -LiteralPath $AllowlistPath)
        RootPath = $resolvedRootPath
        RootItemCount = $inventory.Count
        Mode = 'SelfTest'
    }
    return
}

if ($Run -and $Preview) {
    throw 'cleanc accepts either -Preview or -Run, not both together.'
}

if (-not $Run -and -not $Preview) {
    $Run = $true
}

$allowlist = Read-CleancAllowlist -Path $AllowlistPath -ResolvedRootPath $resolvedRootPath
$plan = New-CleancPlan -Inventory $inventory -AllowlistSet $allowlist.EntrySet

if ($Preview) {
    Show-CleancPreview -Plan $plan -ResolvedRootPath $resolvedRootPath -AllowlistPath $allowlist.Path
    return
}

Test-CleancCriticalAllowlist -Inventory $inventory -AllowlistSet $allowlist.EntrySet -ResolvedRootPath $resolvedRootPath
$deleteResults = @(Invoke-CleancRun -Plan $plan -ResolvedRootPath $resolvedRootPath -RecycleCodexLockOwners:$RecycleCodexLockOwners)
$postInventory = @(Get-CleancRootInventory -ResolvedRootPath $resolvedRootPath)
Show-CleancVerification -PostInventory $postInventory -AllowlistSet $allowlist.EntrySet -DeleteResults $deleteResults
