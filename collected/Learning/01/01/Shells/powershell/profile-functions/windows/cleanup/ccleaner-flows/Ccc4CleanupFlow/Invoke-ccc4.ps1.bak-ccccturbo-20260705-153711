            foreach($cd in $cacheDirs){$cp=Join-Path $_.FullName $cd;if(Test-Path $cp -EA 0){$s=SZ $cp;$script:freed+=$s;if($s -gt 1MB){Write-Host "    Edge\$($_.Name)\$cd ($([math]::Round($s/1MB))MB)" -ForegroundColor DarkGray};Get-ChildItem $cp -Force -EA 0|Remove-Item -Recurse -Force -EA 0}}
