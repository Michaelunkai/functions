                }
            }
            # 10.x 11.x - keep all (active use)
        }
    }
    # Remove old runtimes same logic
    $sharedBase='C:\Program Files\dotnet\shared'
    if(Test-Path $sharedBase){
        Get-ChildItem $sharedBase -Directory -EA 0|ForEach-Object{
            $family=$_.FullName
            $rts=Get-ChildItem $family -Directory -EA 0|Where-Object{$_.Name -match '^\d+\.\d+'}
            $grp=@{}
            foreach($r in $rts){$m=$r.Name -replace '^(\d+\.\d+)\..*','$1';if(!$grp[$m]){$grp[$m]=@()};$grp[$m]+=$r}
            foreach($k in $grp.Keys){
                $maj=[int]($k -replace '\..*','')
                if($maj -in 2,3,5,6,7){
                    foreach($r in $grp[$k]){$sz=SZ $r.FullName;$script:freed+=$sz;Write-Host "    EOL runtime: $($_.Name)\$($r.Name) ($([math]::Round($sz/1MB))MB)" -ForegroundColor DarkGray;Remove-Item $r.FullName -Recurse -Force -EA 0}
                } elseif($maj -in 8,9) {
                    $sorted=@($grp[$k]|Sort-Object{try{[version]($_.Name -replace '-.*','')}catch{[version]'0.0.0'}})
                    if($sorted.Count -gt 1){
                        $old=$sorted[0..($sorted.Count-2)]
                        foreach($r in $old){$sz=SZ $r.FullName;$script:freed+=$sz;Write-Host "    Old runtime: $($_.Name)\$($r.Name) ($([math]::Round($sz/1MB))MB)" -ForegroundColor DarkGray;Remove-Item $r.FullName -Recurse -Force -EA 0}
                    }
                }
            }
        }
    }
    # Remove empty AspNetCore.All family if all versions removed
    $aspAll=Join-Path $sharedBase 'Microsoft.AspNetCore.All'
    if((Test-Path $aspAll) -and (@(Get-ChildItem $aspAll -Directory -EA 0)).Count -eq 0){Remove-Item $aspAll -Recurse -Force -EA 0}
    Write-Host "  .NET total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [5/10] BROWSER CACHES (Chrome all profiles, Edge, Firefox, Brave) - NEVER touches logins/passwords/cookies
    Write-Host '[5/10] Browser caches (all browsers, all profiles)...' -ForegroundColor Cyan
