        foreach($s in $sdks){$m=$s.Name -replace '^(\d+\.\d+)\..*','$1';if(!$grp[$m]){$grp[$m]=@()};$grp[$m]+=$s}
        foreach($k in $grp.Keys){
            $maj=[int]($k -replace '\..*','')
            if($maj -in 2,3,5,6,7){
                # EOL - remove all
                foreach($s in $grp[$k]){$sz=SZ $s.FullName;$script:freed+=$sz;Write-Host "    EOL SDK: $($s.Name) ($([math]::Round($sz/1MB))MB)" -ForegroundColor DarkGray;Remove-Item $s.FullName -Recurse -Force -EA 0}
            } elseif($maj -in 8,9) {
                # Supported - keep only latest patch
                $sorted=@($grp[$k]|Sort-Object{try{[version]$_.Name}catch{[version]'0.0.0'}})
                if($sorted.Count -gt 1){
                    $old=$sorted[0..($sorted.Count-2)]
