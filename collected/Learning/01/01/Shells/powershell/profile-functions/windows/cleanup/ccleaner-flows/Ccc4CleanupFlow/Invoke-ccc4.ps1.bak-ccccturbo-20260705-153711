    Write-Host "  WinGet total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [4/10] OLD .NET SDKs + RUNTIMES (keep latest patch per major.minor, keep all 10.x+)
    Write-Host '[4/10] Old .NET SDKs & runtimes...' -ForegroundColor Cyan
    $b=$freed
    $sdkBase='C:\Program Files\dotnet\sdk'
    # Remove EOL SDKs: 2.x 3.x 5.x 6.x 7.x entirely + old patches of 8.x 9.x
    if(Test-Path $sdkBase){
        $sdks=Get-ChildItem $sdkBase -Directory -EA 0|Where-Object{$_.Name -match '^\d+\.\d+\.\d+'}
