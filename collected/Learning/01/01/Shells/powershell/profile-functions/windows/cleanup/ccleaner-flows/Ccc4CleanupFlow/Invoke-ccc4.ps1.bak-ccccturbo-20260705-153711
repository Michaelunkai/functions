        Remove-Item $_.FullName -Force -EA 0
    }
    # Tiny orphan GUID dirs >90 days old
    Get-ChildItem 'C:\Windows\Installer' -Directory -EA 0|Where-Object{$_.Name -match '^\{' -and $_.LastWriteTime -lt (Get-Date).AddDays(-90)}|ForEach-Object{$s=SZ $_.FullName;if($s -gt 0 -and $s -lt 5MB){$script:freed+=$s;Remove-Item $_.FullName -Recurse -Force -EA 0}}
    Write-Host "  Installer total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [8/10] SUPERSEDED WINDOWSAPPS
    Write-Host '[8/10] Superseded WindowsApps...' -ForegroundColor Cyan
    $b=$freed
    # Remove staged packages
    Get-AppxPackage -AllUsers -EA 0|Where-Object{$_.PackageUserInformation.InstallState -eq 'Staged'}|ForEach-Object{Write-Host "    Staged: $($_.Name) $($_.Version)" -ForegroundColor DarkGray;Remove-AppxPackage -Package $_.PackageFullName -AllUsers -EA 0}
    # Find old versions in WindowsApps dir and remove via AppX
    $appDir='C:\Program Files\WindowsApps'
    $apps=Get-ChildItem $appDir -Directory -Force -EA 0|Where-Object{$_.Name -match '^(.+?)_(\d[\d\.]+?)_'}|ForEach-Object{
        $m=[regex]::Match($_.Name,'^(.+?)_(\d[\d\.]+?)_')
        [PSCustomObject]@{Base=$m.Groups[1].Value;Ver=$m.Groups[2].Value;Full=$_.FullName;Name=$_.Name}
    }
    $apps|Group-Object Base|Where-Object{$_.Count -gt 1}|ForEach-Object{
        $sorted=@($_.Group|Sort-Object{try{[version]($_.Ver -replace '[^\d\.]','')}catch{[version]'0.0'}})
        if($sorted.Count -gt 1){
            $old=$sorted[0..($sorted.Count-2)]
            foreach($o in $old){
                $pkg=Get-AppxPackage -AllUsers -EA 0|Where-Object{$_.PackageFullName -like "*$($o.Name)*"}
                if($pkg){
                    $isInstalled=$false
                    $pkg.PackageUserInformation|ForEach-Object{if($_.InstallState -eq 'Installed'){$isInstalled=$true}}
                    if(!$isInstalled){
                        $s=SZ $o.Full;$script:freed+=$s
                        Write-Host "    Old AppX: $($o.Base) $($o.Ver) ($([math]::Round($s/1MB))MB)" -ForegroundColor DarkGray
                        Remove-AppxPackage -Package $pkg.PackageFullName -AllUsers -EA 0
                    }
