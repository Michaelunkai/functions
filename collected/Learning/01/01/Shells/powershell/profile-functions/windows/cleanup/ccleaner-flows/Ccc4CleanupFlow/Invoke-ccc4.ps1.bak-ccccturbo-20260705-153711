    Write-Host "  WindowsApps total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [9/10] RUSTUP + MISC DEV CACHES
    Write-Host '[9/10] Rustup + dev caches...' -ForegroundColor Cyan
    $b=$freed
    # Rustup: clean old toolchain artifacts, download cache, tmp
    FR 'RustupTmp' @('C:\Users\micha\.rustup\tmp','C:\Users\micha\.rustup\downloads')
    # VS Build Tools cache (NOT the install itself)
    FR 'VSCache' @("$env:LOCALAPPDATA\Microsoft\VisualStudio\Packages\_Instances","$env:LOCALAPPDATA\Microsoft\VisualStudio\17.0\Extensions\DotNetSdkFeedUrl","$env:TEMP\NuGetScratch","$env:TEMP\VBCSCompiler","$env:TEMP\.NETCoreApp","$env:TEMP\dotnet-diagnostic","$env:TEMP\Razor")
    Write-Host "  Dev caches total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [10/10] DISM COMPONENT CLEANUP
    Write-Host '[10/10] DISM component cleanup (background)...' -ForegroundColor Cyan
    $jDism=Start-Job{dism /online /cleanup-image /startcomponentcleanup /resetbase 2>&1|Select-Object -Last 1}
    $done=Wait-Job $jDism -Timeout 90 -EA 0
