    # Brave
    $braveUD='C:\Users\micha\AppData\Local\BraveSoftware\Brave-Browser\User Data'
    if(Test-Path $braveUD){Get-ChildItem $braveUD -Directory -Force -EA 0|Where-Object{$_.Name -match '^(Default|Profile)'}|ForEach-Object{foreach($cd in $cacheDirs){$cp=Join-Path $_.FullName $cd;if(Test-Path $cp -EA 0){$s=SZ $cp;$script:freed+=$s;Get-ChildItem $cp -Force -EA 0|Remove-Item -Recurse -Force -EA 0}}}}
