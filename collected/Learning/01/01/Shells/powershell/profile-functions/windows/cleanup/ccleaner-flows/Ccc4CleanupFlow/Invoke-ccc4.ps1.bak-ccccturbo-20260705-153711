    $vivaldiUD='C:\Users\micha\AppData\Local\Vivaldi\User Data'
    if(Test-Path $vivaldiUD){Get-ChildItem $vivaldiUD -Directory -Force -EA 0|Where-Object{$_.Name -match '^(Default|Profile)'}|ForEach-Object{foreach($cd in $cacheDirs){$cp=Join-Path $_.FullName $cd;if(Test-Path $cp -EA 0){$s=SZ $cp;$script:freed+=$s;Get-ChildItem $cp -Force -EA 0|Remove-Item -Recurse -Force -EA 0}}}}
    Write-Host "  Browsers total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [6/10] TEMP FOLDER
