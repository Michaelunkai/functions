        if(Test-Path $_ -EA 0){
            Get-ChildItem $_ -Force -EA 0|Where-Object{$_.LastWriteTime -lt $cutoff}|ForEach-Object{
                $s=if($_.PSIsContainer){SZ $_.FullName}else{$_.Length}
                $script:freed+=$s
                Remove-Item $_.FullName -Recurse -Force -EA 0
            }
        }
    }
    Write-Host "  TEMP total: $([math]::Round(($freed-$b)/1MB))MB" -ForegroundColor Green

    # [7/10] WINDOWS INSTALLER ORPHANS
    Write-Host '[7/10] Windows Installer orphans...' -ForegroundColor Cyan
    $b=$freed
    # Remove .tmp .log .txt files
    Get-ChildItem 'C:\Windows\Installer' -File -EA 0|Where-Object{$_.Extension -in '.tmp','.log','.txt'}|ForEach-Object{$script:freed+=$_.Length;Remove-Item $_.FullName -Force -EA 0}
    # Remove old .msp >180 days >5MB
    Get-ChildItem 'C:\Windows\Installer' -File -EA 0|Where-Object{$_.Extension -eq '.msp' -and $_.LastWriteTime -lt (Get-Date).AddDays(-180) -and $_.Length -gt 5MB}|ForEach-Object{$script:freed+=$_.Length;Write-Host "    Old MSP: $($_.Name) ($([math]::Round($_.Length/1MB))MB)" -ForegroundColor DarkGray;Remove-Item $_.FullName -Force -EA 0}
    # PatchCache
    if(Test-Path 'C:\Windows\Installer\$PatchCache$' -EA 0){$s=SZ 'C:\Windows\Installer\$PatchCache$';if($s -gt 1MB){$script:freed+=$s;Get-ChildItem 'C:\Windows\Installer\$PatchCache$' -Recurse -Force -EA 0|Remove-Item -Recurse -Force -EA 0;Write-Host "    PatchCache ($([math]::Round($s/1MB))MB)" -ForegroundColor DarkGray}}
    # Orphaned .msi files (not referenced in registry)
    $regPkgs=@{}
    Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Installer\UserData\S-1-5-18\Products\*\InstallProperties' -EA 0|Where-Object{$_.LocalPackage}|ForEach-Object{$regPkgs[$_.LocalPackage]=$true}
    Get-ChildItem 'C:\Windows\Installer' -File -Filter '*.msi' -EA 0|Where-Object{!$regPkgs[$_.FullName]}|ForEach-Object{
        $script:freed+=$_.Length
