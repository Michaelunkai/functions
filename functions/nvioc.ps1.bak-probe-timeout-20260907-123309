    function Test-NviocStreamingInference {
        param(
            [string]$Uri,
            [hashtable]$Headers,
            [string]$Body,
            [int]$TimeoutSec = 60
        )

        # A streaming probe is successful as soon as the first non-error SSE
        # data event arrives. Invoke-WebRequest waits for the server to close
        # the stream, which is unnecessarily slow for reasoning models that
        # keep emitting tokens after the first usable event.
        $client = New-Object System.Net.Http.HttpClient
        $request = $null
        $response = $null
        $stream = $null
        $cts = New-Object System.Threading.CancellationTokenSource
        $cts.CancelAfter([TimeSpan]::FromSeconds($TimeoutSec))
        try {
            $request = New-Object System.Net.Http.HttpRequestMessage(
                [System.Net.Http.HttpMethod]::Post, $Uri)
            $request.Content = New-Object System.Net.Http.StringContent(
                $Body, [Text.Encoding]::UTF8, 'application/json')
            foreach ($header in $Headers.GetEnumerator()) {
                if ([string]$header.Key -eq 'Content-Type') { continue }
                [void]$request.Headers.TryAddWithoutValidation(
                    [string]$header.Key, [string]$header.Value)
            }

            $response = $client.SendAsync(
                $request,
                [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead,
                $cts.Token).GetAwaiter().GetResult()
            if ($response.StatusCode -lt 200 -or $response.StatusCode -ge 300) {
                return $false
            }

            $stream = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
            $buffer = New-Object byte[] 4096
            $pending = ''
            $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSec)
            while ([DateTime]::UtcNow -lt $deadline) {
                $remainingMs = [int][math]::Max(1, [math]::Min(
                    30000, ($deadline - [DateTime]::UtcNow).TotalMilliseconds))
                $readTask = $stream.ReadAsync($buffer, 0, $buffer.Length, $cts.Token)
                if (-not $readTask.Wait($remainingMs)) {
                    throw "streaming probe timed out after ${TimeoutSec}s"
                }
                $readCount = [int]$readTask.Result
                if ($readCount -le 0) { break }
                $pending += [Text.Encoding]::UTF8.GetString($buffer, 0, $readCount)
                if ($pending -match '(?m)^data:\s*(?<data>[^\r\n]*)') {
                    $data = [string]$matches['data']
                    if ($data -match '\[PROXY ERROR|"type"\s*:\s*"error"') {
                        return $false
                    }
                    if (-not [string]::IsNullOrWhiteSpace($data) -and $data -ne '[DONE]') {
                        return $true
                    }
                }
                if ($pending.Length -gt 16384) {
                    $pending = $pending.Substring($pending.Length - 8192)
                }
            }
            return $false
        } finally {
            if ($stream) { $stream.Dispose() }
            if ($response) { $response.Dispose() }
            if ($request) { $request.Dispose() }
            $cts.Dispose()
            $client.Dispose()
        }
    }

    function Test-ModelInference {
        param(
            [string]$ModelId,
            [string]$ApiKey,
            [int]$TimeoutSec = 30,
            [int]$MaxRetries = 3
        )
        # Quick inference probe with retries.
        # Retries handle transient 500s, timeouts (status=0), and brief 429s.
        $apiModelId = $ModelId -replace '^[^/]+/', ''
        $lastStatus = 0

        for ($attempt = 1; $attempt -le $MaxRetries; $attempt++) {
            try {
                $request = Get-NviocInferenceRequest -ApiKey $ApiKey
                $body = @{
                    model       = $apiModelId
                    messages    = @(@{ role = 'user'; content = 'Reply with exactly OK.' })
                    max_tokens  = 4
                    temperature = 0
                    stream      = $true
                } | ConvertTo-Json -Depth 5
                if (Test-NviocStreamingInference -Uri $request.Uri -Headers $request.Headers -Body $body -TimeoutSec $TimeoutSec) {
                    return $true
                }
                throw 'The inference probe returned an incomplete or proxy-error response.'
            } catch {
                $lastStatus = 0
                if ($_.Exception.Response) {
                    $lastStatus = $_.Exception.Response.StatusCode.value__
                }
                # 429 = rate limit, 500/502/503 = transient server error, 0 = timeout/connection
                # All are retryable. 404 = model doesn't exist, not retryable.
                if ($lastStatus -eq 404) {
                    Write-Host "OC_PROGRESS stage=inference-probe-fail model=$ModelId status=$lastStatus (not found, no retry)"
                    return $false
                }
                if ($attempt -lt $MaxRetries) {
                    $backoff = $attempt * 2
                    Write-Host "OC_PROGRESS stage=inference-probe-retry model=$ModelId status=$lastStatus attempt=$attempt/$MaxRetries wait=${backoff}s"
                    Start-Sleep -Seconds $backoff
                } else {
                    Write-Host "OC_PROGRESS stage=inference-probe-fail model=$ModelId status=$lastStatus attempts=$MaxRetries exhausted"
                    return $false
                }
            }
        }
        return $false
    }

