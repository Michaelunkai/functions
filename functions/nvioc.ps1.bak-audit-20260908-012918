            $status = 0
            if ($_.Exception.Response) { $status = [int]$_.Exception.Response.StatusCode }
            return @{ ok = $false; status = $status }
        }
    }

    function Backup-OpenCodeSessions {
        # The database can be several gigabytes. Start one low-priority,
        # SQLite-consistent backup worker and never block the TUI launch.
        $dbPath = Join-Path $env:USERPROFILE '.local\share\opencode\opencode.db'
        if (-not (Test-Path -LiteralPath $dbPath -PathType Leaf)) { return }
        $backupDir = 'F:\backup\opencode-sessions'
        $helper = 'F:\study\Platforms\windows\functions\backup-opencode-sessions.py'
        $marker = Join-Path $backupDir '.opencode-backup.active'
        $receipt = Join-Path $backupDir 'opencode-backup-receipt.json'
        try {
            if (-not (Test-Path -LiteralPath $backupDir -PathType Container)) {
                New-Item -ItemType Directory -Force -Path $backupDir | Out-Null
            }
            if (-not (Test-Path -LiteralPath $helper -PathType Leaf)) {
                Write-Host "OC_PROGRESS stage=sessions-backup-helper-missing path=$helper"
                return
            }
            if (Test-Path -LiteralPath $receipt -PathType Leaf) {
                try {
                    $receiptState = Get-Content -LiteralPath $receipt -Raw | ConvertFrom-Json
                    $receiptAge = ([DateTime]::UtcNow - (Get-Item -LiteralPath $receipt).LastWriteTimeUtc).TotalSeconds
                    if ($receiptAge -lt 900 -and $receiptState.status -in @('completed', 'recent_backup')) {
                        return
                    }
                } catch { }
            }
            if (Test-Path -LiteralPath $marker -PathType Leaf) {
                $markerAge = ([DateTime]::UtcNow - (Get-Item -LiteralPath $marker).LastWriteTimeUtc).TotalSeconds
                $markerPid = 0
                try { $markerPid = [int](Get-Content -LiteralPath $marker -Raw).Trim() } catch { }
                if (($markerPid -gt 0 -and (Get-Process -Id $markerPid -ErrorAction SilentlyContinue)) -or $markerAge -lt 60) {
                    return
                }
                Remove-Item -LiteralPath $marker -Force -ErrorAction SilentlyContinue
            }
            $markerStream = $null
            try {
                $markerStream = [IO.File]::Open(
                    $marker,
                    [IO.FileMode]::CreateNew,
                    [IO.FileAccess]::Write,
                    [IO.FileShare]::Read
                )
            } catch [IO.IOException] {
                return
            } finally {
                if ($markerStream) { $markerStream.Dispose() }
            }
            $pyExe = $null
            foreach ($pythonCandidate in @(
                'C:\Users\micha\AppData\Local\Programs\Python\Python312\python.exe',
                'C:\Users\micha\AppData\Local\Programs\Python\Python311\python.exe'
            )) {
                if (Test-Path -LiteralPath $pythonCandidate -PathType Leaf) {
                    $pyExe = $pythonCandidate
                    break
                }
            }
            if (-not $pyExe) {
                foreach ($pyCmd in (Get-Command python.exe -CommandType Application -ErrorAction SilentlyContinue)) {
                    if ($pyCmd.Source -notmatch 'WindowsApps') {
                        $pyExe = $pyCmd.Source
                        break
                    }
                }
            }
            if (-not $pyExe) {
                Remove-Item -LiteralPath $marker -Force -ErrorAction SilentlyContinue
                Write-Host 'OC_PROGRESS stage=sessions-backup-skip msg=no-real-python.exe'
                return
            }
            $backupProcess = Start-Process -FilePath $pyExe -ArgumentList @(
                $helper,
                '--source', $dbPath,
                '--destination', $backupDir,
                '--marker', $marker,
                '--minimum-interval-seconds', '900',
                '--retain', '20'
            ) -WindowStyle Hidden -PassThru -ErrorAction Stop
            Write-Host "OC_PROGRESS stage=sessions-backup-started pid=$($backupProcess.Id)"
            $backupProcess.Dispose()
        } catch {
            Remove-Item -LiteralPath $marker -Force -ErrorAction SilentlyContinue
            Write-Host "OC_PROGRESS stage=sessions-backup-skip msg=$($_.Exception.Message)"
        }
    }

    function Clear-StaleOpenCode {
        # Parent lifetimes are not reliable ownership evidence: Windows
        # Terminal handoffs and concurrent short-lived shells can leave a
        # healthy OpenCode process parentless. Preserve every session and
        # let explicit user cancellation plus proxy disconnect handling
        # release upstream work.
        $sessionCount = @(Get-Process -Name 'opencode' -ErrorAction SilentlyContinue).Count
        Write-Host "OC_PROGRESS stage=session-preservation active=$sessionCount"
    }

    # =====================================================================
    # NVIDIA RATE-LIMIT PROXY (with API key rotation)
    # A zero-dependency Node.js proxy on localhost:3460 that:
    #   1. Intercepts 429/503/529 and retries BEFORE OpenCode sees them
    #   2. ROTATES between multiple API keys to maximize rate limit headroom
    #   3. Per-key cooldown: a 429'd key is skipped for 60s
    #   4. Auto-reloads keys file every 60s (add keys without restart)
    #
    # Keys live in nvidia-api-keys.txt (one nvapi- key per line).
    # Add more free keys from https://org.ngc.nvidia.com/setup/api-keys
    # =====================================================================
    $proxyScript = Join-Path $env:USERPROFILE '.config\opencode\nvidia-proxy.cjs'
    $proxyKeysFile = 'F:\backup\windowsapps\credentials\nvidia\api-keys.txt'
    $proxyPort = 3460
    if ($env:NVIDIA_PROXY_PORT -match '^\d+$') {
        $requestedProxyPort = [int]$env:NVIDIA_PROXY_PORT
        if ($requestedProxyPort -ge 1024 -and $requestedProxyPort -le 65535) {
            $proxyPort = $requestedProxyPort
        }
    }
    $proxyBaseUrl = "http://127.0.0.1:$proxyPort/v1"
    $proxyReadyMarker = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\nvioc-nvidia-proxy-ready.json'

    function Get-NviocTcpListenerProcessId {
        param([int]$Port)
        $netstatPath = Join-Path $env:SystemRoot 'System32\netstat.exe'
        if (-not (Test-Path -LiteralPath $netstatPath -PathType Leaf)) { return 0 }
        foreach ($line in @(& $netstatPath -ano -p tcp 2>$null)) {
            if ($line -match ('^\s*TCP\s+\S+:' + [regex]::Escape([string]$Port) + '\s+\S+\s+LISTENING\s+(\d+)\s*$')) {
                return [int]$matches[1]
            }
        }
        return 0
    }

    function Write-NviocProxyReadyMarker {
        param([int]$Port, [int]$ProcessId)
        try {
            $process = Get-Process -Id $ProcessId -ErrorAction Stop
            $payload = [ordered]@{
                port = $Port
                processId = $ProcessId
                processStartUtcTicks = $process.StartTime.ToUniversalTime().Ticks
            }
            $markerDir = Split-Path -Parent $proxyReadyMarker
            if (-not (Test-Path -LiteralPath $markerDir -PathType Container)) {
                New-Item -ItemType Directory -Force -Path $markerDir | Out-Null
            }
            $temporaryPath = "$proxyReadyMarker.tmp.$PID.$([guid]::NewGuid().ToString('N'))"
            [IO.File]::WriteAllText(
                $temporaryPath,
                (($payload | ConvertTo-Json -Depth 5) + "`r`n"),
                (New-Object Text.UTF8Encoding($false))
            )
            Move-Item -LiteralPath $temporaryPath -Destination $proxyReadyMarker -Force
        } catch { }
    }

    function Test-NviocCachedProxy {
        param([int]$Port)
        try {
            if (-not (Test-Path -LiteralPath $proxyReadyMarker -PathType Leaf)) { return $false }
            $marker = Get-Content -LiteralPath $proxyReadyMarker -Raw | ConvertFrom-Json
            if ([int]$marker.port -ne $Port -or [int]$marker.processId -le 0) { return $false }
            $process = Get-Process -Id ([int]$marker.processId) -ErrorAction Stop
            if ([long]$marker.processStartUtcTicks -ne $process.StartTime.ToUniversalTime().Ticks) { return $false }
            return (Get-NviocTcpListenerProcessId -Port $Port) -eq [int]$marker.processId
        } catch {
            return $false
        }
    }

    function Sync-NvidiaApiKeys {
        # Collect all known NVIDIA API keys from various sources and
        # write them to the proxy keys file. Called before proxy start.
        $knownKeys = @{}
        # Source 1: existing keys file
        if (Test-Path -LiteralPath $proxyKeysFile -PathType Leaf) {
            foreach ($line in (Get-Content -LiteralPath $proxyKeysFile)) {
                $t = $line.Trim()
                if ($t -and -not $t.StartsWith('#') -and $t -match 'nvapi-') {
                    $knownKeys[$t] = 'keys-file'
                }
            }
        }
        # Source 2: env var
        if ($env:NVIDIA_API_KEY -and $env:NVIDIA_API_KEY -match 'nvapi-') {
            $knownKeys[$env:NVIDIA_API_KEY.Trim()] = 'env'
        }
        # Source 3: legacy key files (individual api.txt, api2.txt, api3.txt)
        $legacyKeyDir = 'F:\backup\windowsapps\credentials\nvidia'
        if (Test-Path -LiteralPath $legacyKeyDir -PathType Container) {
            foreach ($lkf in @('api.txt', 'api2.txt', 'api3.txt')) {
                $lkfPath = Join-Path $legacyKeyDir $lkf
                if (Test-Path -LiteralPath $lkfPath -PathType Leaf) {
                    $fk = (Get-Content -LiteralPath $lkfPath -Raw).Trim()
                    if ($fk -match 'nvapi-') { $knownKeys[$fk] = "legacy-$lkf" }
                }
            }
        }
        # Source 4: opencode auth.json
        $authFile = Join-Path $env:USERPROFILE '.local\share\opencode\auth.json'
        if (Test-Path -LiteralPath $authFile -PathType Leaf) {
            try {
                $aj = Get-Content -LiteralPath $authFile -Raw | ConvertFrom-Json
                if ($aj.nvidia -and $aj.nvidia.key -and $aj.nvidia.key -match 'nvapi-') {
                    $knownKeys[$aj.nvidia.key.Trim()] = 'auth.json'
                }
            } catch { }
        }
        # Source 5: opencode.json provider configs
        $ocCfgs = @(
            (Join-Path $env:USERPROFILE '.config\opencode\opencode.json'),
            (Join-Path $env:APPDATA 'opencode\opencode.json')
        )
        foreach ($ocCfg in $ocCfgs) {
            if (-not (Test-Path -LiteralPath $ocCfg -PathType Leaf)) { continue }
            try {
                $j = Get-Content -LiteralPath $ocCfg -Raw | ConvertFrom-Json
                $providers = @()
                if ($j.provider.'nvidia-nim') { $providers += $j.provider.'nvidia-nim' }
                if ($j.provider.nvidia) { $providers += $j.provider.nvidia }
                foreach ($p in $providers) {
                    if ($p.options -and $p.options.apiKey -and $p.options.apiKey -match 'nvapi-') {
                        $knownKeys[$p.options.apiKey.Trim()] = 'opencode.json'
                    }
                }
            } catch { }
        }
        # Write unique keys to file
        if ($knownKeys.Count -eq 0) {
            Write-Host "OC_PROGRESS stage=keys-sync-warning no-keys-found"
            return
        }
        $dir = Split-Path -Parent $proxyKeysFile
        if (-not (Test-Path -LiteralPath $dir -PathType Container)) {
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
        }
        $kl = @("# NVIDIA NIM API Keys (auto-synced by nvioc)")
        $kl += "# Add more at https://org.ngc.nvidia.com/setup/api-keys"
        $kl += "# One nvapi- key per line. Proxy rotates between all."
        $kl += "#"
        foreach ($k in $knownKeys.Keys) { $kl += $k }
        $kl -join "`n" | Set-Content -LiteralPath $proxyKeysFile -Encoding UTF8
        Write-Host "OC_PROGRESS stage=keys-synced count=$($knownKeys.Count) path=$proxyKeysFile"
    }

    function Get-NvidiaProxyHealth {
        try {
            $resp = Invoke-WebRequest -Uri "http://127.0.0.1:$proxyPort/health" `
                -Method Get -TimeoutSec 5 -UseBasicParsing -ErrorAction Stop
            if ($resp.StatusCode -eq 200) { return ($resp.Content | ConvertFrom-Json) }
        } catch { }
        return $null
    }

    function Ensure-NvidiaProxy {
        # Returns $true if the proxy is reachable, $false if it could not be started.
        if (Test-NviocCachedProxy -Port $proxyPort) {
            Write-Host "OC_PROGRESS stage=proxy-warm port=$proxyPort"
            return $true
        }
        $health = Get-NvidiaProxyHealth
        if ($health) {
            Write-Host "OC_PROGRESS stage=proxy-already-running port=$proxyPort keys=$($health.keys)"
            $existingProxyPid = Get-NviocTcpListenerProcessId -Port $proxyPort
            if ($existingProxyPid -gt 0) {
                Write-NviocProxyReadyMarker -Port $proxyPort -ProcessId $existingProxyPid
            }
            # Hot-reload the keys file
            try { $null = Invoke-WebRequest -Uri "http://127.0.0.1:$proxyPort/_reload" -Method Get -TimeoutSec 5 -UseBasicParsing -ErrorAction SilentlyContinue } catch { }
            return $true
        }
        if (-not (Test-Path -LiteralPath $proxyScript -PathType Leaf)) {
            Write-Host "OC_PROGRESS stage=proxy-missing path=$proxyScript"
            return $false
        }
        $startupMutex = New-Object Threading.Mutex($false, 'Local\NviocNvidiaProxyStartupV1')
        $startupLockTaken = $false
        try {
            try {
                $startupLockTaken = $startupMutex.WaitOne(0)
            } catch [Threading.AbandonedMutexException] {
                $startupLockTaken = $true
            }
            if (-not $startupLockTaken) {
                $followerDeadline = (Get-Date).AddSeconds(15)
                while ((Get-Date) -lt $followerDeadline) {
                    Start-Sleep -Milliseconds 100
                    if (Get-NvidiaProxyHealth) { return $true }
                }
                Write-Host "OC_PROGRESS stage=proxy-start-wait-timeout port=$proxyPort"
                return $false
            }
            $health = Get-NvidiaProxyHealth
            if ($health) { return $true }
            Sync-NvidiaApiKeys
            $nodeExe = $null
            # Resolve node.exe even when it is not on PATH (the default
            # Node.js install directory is frequently missing from PATH).
            $nodeCandidates = @(
                (Join-Path ${env:ProgramFiles} 'nodejs\node.exe'),
                (Join-Path ${env:ProgramFiles(x86)} 'nodejs\node.exe'),
                (Join-Path ${env:ProgramFiles} 'nodejs\nodejs.exe'),
                (Join-Path ${env:ProgramFiles(x86)} 'nodejs\nodejs.exe')
            )
            foreach ($nodePath in $nodeCandidates) {
                if ($nodePath -and (Test-Path -LiteralPath $nodePath -PathType Leaf)) {
                    $nodeExe = $nodePath
                    break
                }
            }
            if (-not $nodeExe) {
                foreach ($c in (Get-Command node.exe -CommandType Application -ErrorAction SilentlyContinue)) {
                    if ($c.Source -notmatch 'WindowsApps') { $nodeExe = $c.Source; break }
                }
            }
            if (-not $nodeExe) { $nodeExe = 'node' }
            $proxyProcess = Start-Process -FilePath $nodeExe `
                -ArgumentList @($proxyScript, '--port', [string]$proxyPort, '--keys', $proxyKeysFile) `
                -WorkingDirectory (Split-Path -Parent $proxyScript) `
                -WindowStyle Hidden -PassThru -ErrorAction Stop
            $proxyProcess.Dispose()
            $deadline = (Get-Date).AddSeconds(15)
            while ((Get-Date) -lt $deadline) {
                Start-Sleep -Milliseconds 100
                $h = Get-NvidiaProxyHealth
                if ($h) {
                    $startedProxyPid = Get-NviocTcpListenerProcessId -Port $proxyPort
                    if ($startedProxyPid -gt 0) {
                        Write-NviocProxyReadyMarker -Port $proxyPort -ProcessId $startedProxyPid
                    }
                    Write-Host "OC_PROGRESS stage=proxy-started port=$proxyPort keys=$($h.keys)"
                    return $true
                }
            }
            Write-Host "OC_PROGRESS stage=proxy-timeout port=$proxyPort"
            return $false
        } catch {
            Write-Host "OC_PROGRESS stage=proxy-start-error msg=$($_.Exception.Message)"
            return $false
        } finally {
            if ($startupLockTaken) {
                [void]$startupMutex.ReleaseMutex()
            }
            $startupMutex.Dispose()
        }
    }

    $finalModelArg = $modelArg
    $finalLabel = $modelLabels[$finalModelArg]
    if (-not $finalLabel) { $finalLabel = $finalModelArg }

    if ($Check) {
        Write-Host "OC_PROGRESS stage=fetching-model-list"
        $nimModelList = $null
        $maxRetries = 3
        for ($retry = 1; $retry -le $maxRetries; $retry++) {
            $nimModelList = Get-NvidiaModelList -ApiKey $nvidiaApiKey -TimeoutSec 30
            if ($null -ne $nimModelList) {
                $modelCount = @($nimModelList).Count
                Write-Host "OC_PROGRESS stage=model-list-ok count=$modelCount"
                break
            }
            Write-Host "OC_PROGRESS stage=model-list-retry attempt=$retry/$maxRetries"
            if ($retry -lt $maxRetries) {
                Start-Sleep -Seconds ($retry * 2)
            }
        }

        # Verify exactly one requested model. Falling through to another model
        # would make -Check report success while the function launches a
        # different assignment, so every route is fail-closed.
        $modelsToTest = @($modelArg)

        $workingModelId = $null
        if ($null -ne $nimModelList) {
            foreach ($testId in $modelsToTest) {
                $label = $modelLabels[$testId]
                if (-not $label) { $label = $testId }

                # Phase 1: Check model exists in catalog
                if (-not (Test-ModelListed -ModelId $testId -ModelList $nimModelList)) {
                    Write-Host "OC_PROGRESS stage=model-not-listed model=$testId label=$label"
                    continue
                }

                # Phase 2: Quick inference probe (detects 429 rate limits)
                Write-Host "OC_PROGRESS stage=probe-testing model=$testId label=$label"
                if (Test-ModelInference -ModelId $testId -ApiKey $nvidiaApiKey -TimeoutSec 90 -MaxRetries 1) {
                    Write-Host "OC_PROGRESS stage=model-verified model=$testId label=$label"
                    $workingModelId = $testId
                    break
                } else {
                    Write-Host "OC_PROGRESS stage=model-probe-failed model=$testId label=$label"
                }
            }
        } else {
            # Could not fetch model list. No route may claim success without a
            # live model-list/inference gate, including the default route.
            Write-Host "OC_PROGRESS stage=model-list-failed using-model=$modelArg"
            throw "nvioc: cannot verify requested NVIDIA model $modelArg because /v1/models failed."
        }

        if (-not $workingModelId) {
            throw "nvioc: requested NVIDIA model $modelArg failed the live catalog/inference check."
        }

        $finalModelArg = $workingModelId
        $finalLabel = $modelLabels[$finalModelArg]
        if (-not $finalLabel) { $finalLabel = $finalModelArg }

        Write-Host "OC_PROGRESS stage=model-selected model=$finalModelArg label=$finalLabel"
    } else {
        # INSTANT PATH: skip preflight when proxy handles 429s.
        # The proxy rotates keys, retries with backoff, and NEVER passes 429s
        # to OpenCode. Probing wastes rate-limit quota and causes the very 429s
        # we want to avoid. When the proxy is running, just launch immediately.
        Clear-StaleOpenCode
        # Session archiving is useful for long-running `run` jobs, but it must
        # never delay a user who asked for the empty interactive TUI.  The old
        # inline backup preflight could spend several seconds touching the F:
        # backup volume before OpenCode received the launch request.
        if ($Args.Count -gt 0) {
            Backup-OpenCodeSessions
        } else {
            Write-Host 'OC_PROGRESS stage=interactive-backup-skipped'
        }

        # Ensure proxy is running
        $proxyRunning = Ensure-NvidiaProxy
        if ($proxyRunning) {
            Write-Host "OC_PROGRESS stage=proxy-active model=$finalModelArg (proxy handles 429s, skipping preflight)"
            $finalModelArg = $finalModelArg
            $finalLabel = $modelLabels[$finalModelArg]
            if (-not $finalLabel) { $finalLabel = $finalModelArg }
            Write-Host "OC_PROGRESS stage=instant-launch model=$finalModelArg label=$finalLabel"
        } else {
            # Proxy unavailable — verify the requested model directly and fail
            # closed if that exact route is not usable.
            Write-Host 'OC_PROGRESS stage=proxy-not-running (direct exact-model preflight)'
            $launchModel = $null
            $probe = Test-ModelCached -ModelId $finalModelArg -ApiKey $nvidiaApiKey
            if ($probe.ok) {
                $launchModel = $finalModelArg
                Write-Host "OC_PROGRESS stage=preflight-ok model=$finalModelArg label=$finalLabel source=$($probe.source)"
            } else {
                Write-Host "OC_PROGRESS stage=preflight-skip model=$finalModelArg status=$($probe.status) source=$($probe.source) (rate-limited or unavailable)"
            }

            if (-not $launchModel) {
                throw "nvioc: requested NVIDIA model $finalModelArg failed direct exact-model preflight while the proxy was unavailable."
            }
            $finalModelArg = $launchModel
            $finalLabel = $modelLabels[$finalModelArg]
            if (-not $finalLabel) { $finalLabel = $finalModelArg }
            Write-Host "OC_PROGRESS stage=instant-launch model=$finalModelArg label=$finalLabel"
        }
    }
    Add-NviocTiming -Stage 'proxy-ready'

    # ═══════════════════════════════════════════════════════════════════
    # OPENCODE CONFIG MANAGEMENT
    # Two config locations opencode reads:
    #   1. %APPDATA%\opencode\opencode.json (Windows standard)
    #   2. ~/.config/opencode/opencode.json (XDG-style, can override)
    # ═══════════════════════════════════════════════════════════════════
    $configPaths = @(
        (Join-Path $env:APPDATA 'opencode\opencode.json'),
        (Join-Path $env:USERPROFILE '.config\opencode\opencode.json')
    )

    # Permission config
    $permissionConfig = @{
        '*'         = 'allow'
        'doom_loop' = 'ask'
    }

    # Instructions file path
    $instructionsPath = Join-Path $env:USERPROFILE '.config\opencode\instructions.md'
    $instructionsRel = '~/.config/opencode/instructions.md'

    # Build prompt file path
    $buildPromptPath = Join-Path $env:USERPROFILE '.config\opencode\build-prompt.txt'
    $buildPromptRel = '{file:~/.config/opencode/build-prompt.txt}'

    # Agent config
    # steps: maximum agentic iterations before opencode force-stops the
    # agent and demands text-only. Pinned near-infinite so the agent can
    # NEVER be forced to stop mid-task (the never-stop mandate lives in
    # build-prompt.txt + instructions.md; this removes the hard cap that
    # could otherwise interrupt a long autonomous run).
    $agentConfig = @{
        build = @{
            mode       = 'primary'
            prompt     = $buildPromptRel
            steps      = 100000
            permission = @{
                '*' = 'allow'
            }
        }
    }

    Add-NviocTiming -Stage 'prelaunch-branch-complete'

    # ═══════════════════════════════════════════════════════════════════
    # CUSTOM NVIDIA PROVIDER CONFIG
    # CRITICAL: The built-in nvidia provider crashes with "U.split is
    # not a function" for some catalog model IDs. We define a custom provider
# using @ai-sdk/openai-compatible with key "nvidia-nim" (not "nvidia")
    # to create a SEPARATE provider that doesn't merge with the built-in
    # nvidia provider from models.dev catalog.
    #
    # baseURL routes through the local rate-limit proxy (localhost:3460)
    # so NVIDIA 429/503/529 responses are retried with exponential
    # backoff BEFORE OpenCode ever sees them. If the proxy is not running,
    # the same exact model uses the direct NVIDIA URL as transport fallback.
    #
    # Each model declares:
    #   modalities  — tells OC what input/output types are supported
    #   attachment  — false = OC will NEVER try to send images to this model
    #   tool_call   — true  = model supports function/tool calling
    #   temperature — boolean capability flag (true = model supports temperature)
    #   limit       — context + output token limits
    # ═══════════════════════════════════════════════════════════════════

    # Start the proxy if it is not already running. If it fails to start,
    # use the direct NVIDIA URL for the same exact model (without the
    # 429-retry shield); never substitute a different model.
    if ($null -eq $proxyRunning) {
        $proxyRunning = Ensure-NvidiaProxy
    }
    if ($proxyRunning) {
        $effectiveBase = $proxyBaseUrl
        Write-Host "OC_PROGRESS stage=proxy-active url=$effectiveBase"
    } else {
        $effectiveBase = 'https://integrate.api.nvidia.com/v1'
        Write-Host "OC_PROGRESS stage=proxy-unavailable url=$effectiveBase (429s will reach OpenCode)"
    }

    $nvidiaProviderConfig = @{
        npm     = '@ai-sdk/openai-compatible'
        name    = 'NVIDIA NGC'
        env     = @('NVIDIA_API_KEY')
        options = @{
            baseURL = $effectiveBase
            apiKey  = $nvidiaApiKey
        }
        models  = @{
            'z-ai/glm-5.2' = @{
                name         = 'GLM-5.2 (753B MoE, best coding)'
                modalities   = @{ input = @('text'); output = @('text') }
                attachment   = $false
                tool_call    = $true
                temperature  = $true
                limit        = @{ context = 1048576; output = 32768 }
            }
            'meta/muse-glimmer-30b' = @{
                name         = 'Muse Glimmer 30B (multimodal reasoning)'
                modalities   = @{ input = @('text', 'image'); output = @('text') }
                attachment   = $true
                tool_call    = $true
                temperature  = $true
                limit        = @{ context = 262144; output = 16384 }
            }
            'mistralai/mistral-nemotron' = @{
                name         = 'Mistral-Nemotron (coding and tool use)'
                modalities   = @{ input = @('text'); output = @('text') }
                attachment   = $false
                tool_call    = $true
                temperature  = $true
                limit        = @{ context = 131072; output = 4096 }
            }
            'nvidia/nemotron-3-super-120b-a12b' = @{
                name         = 'Nemotron 3 Super (120B, strong general)'
