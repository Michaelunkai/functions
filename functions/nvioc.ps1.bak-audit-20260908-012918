    # ═══════════════════════════════════════════════════════════════════
    # LAUNCH OPENCODE - IMMEDIATELY (auto-heals if missing)
    # ═══════════════════════════════════════════════════════════════════
    function Resolve-NviocOpenCode {
        # The platform binary lives directly in opencode-ai\bin AND (as a
        # hard link) in the optional opencode-windows-x64 package. PowerShell
        # 5.1 cannot reliably launch the Bun executable directly, so prefer
        # npm's command shim and validate the native executable only as a
        # fallback.
        $candidates = @(
            (Join-Path $env:LOCALAPPDATA 'OpenCodeStable\opencode.cmd'),
            (Join-Path $env:LOCALAPPDATA 'npm-global\opencode.cmd'),
            (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\bin\opencode.exe'),
            (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64\bin\opencode.exe'),
            (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64-baseline\bin\opencode.exe'),
            (Join-Path $env:APPDATA 'npm\node_modules\opencode-ai\bin\opencode.exe')
        )
        foreach ($candidate in $candidates) {
            if (Test-Path -LiteralPath $candidate -PathType Leaf) { return $candidate }
        }
        foreach ($shim in @('opencode.cmd', 'opencode')) {
            $cmd = Get-Command $shim -CommandType Application -ErrorAction SilentlyContinue
            if ($cmd -and $cmd.Source) { return $cmd.Source }
        }
        return $null
    }

    function Test-NviocOpenCodeWorks {
        param([string]$Path)
        $receiptPath = "$Path.verified.json"
        try {
            if (Test-Path -LiteralPath $receiptPath -PathType Leaf) {
                $receipt = Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
                $file = Get-Item -LiteralPath $Path
                if ([long]$receipt.length -eq $file.Length -and
                    [long]$receipt.lastWriteTimeUtcTicks -eq $file.LastWriteTimeUtc.Ticks -and
                    [string]$receipt.identity -eq 'opencode models') {
                    $script:NviocVerifiedOpenCodePath = [IO.Path]::GetFullPath($Path)
                    $script:NviocVerifiedOpenCodeVersion = [string]$receipt.version
                    return $true
                }
            }
        } catch { }

        # Bun itself also returns a semantic version, so verify an OpenCode-only
        # command signature before trusting a native executable or shim.
        try {
            $version = (& $Path '--version' 2>$null) -join " "
            if ($LASTEXITCODE -ne 0 -or $version -notmatch '^\s*\d+\.\d+\.\d+\s*$') { return $false }
            $helpCommand = '"{0}" models --help 2>&1' -f $Path
            $help = ((& $env:ComSpec /d /s /c $helpCommand) -join "`n") -replace "`e\[[0-9;]*m", ''
            if ($help -match '(?m)^\s*opencode\s+models\b') {
                try {
                    $file = Get-Item -LiteralPath $Path
                    [pscustomobject]@{
                        length = $file.Length
                        lastWriteTimeUtcTicks = $file.LastWriteTimeUtc.Ticks
                        version = $version.Trim()
                        identity = 'opencode models'
                        } | ConvertTo-Json | Set-Content -LiteralPath $receiptPath -Encoding UTF8
                } catch { }
                $script:NviocVerifiedOpenCodePath = [IO.Path]::GetFullPath($Path)
                $script:NviocVerifiedOpenCodeVersion = $version.Trim()
                return $true
            }
        } catch { }
        return $false
    }

    function Get-NviocOpenCodeVersion {
        param([string]$Path)

        if ($script:NviocVerifiedOpenCodePath -and
            [string]::Equals(
                $script:NviocVerifiedOpenCodePath,
                [IO.Path]::GetFullPath($Path),
                [StringComparison]::OrdinalIgnoreCase
            ) -and
            [string]$script:NviocVerifiedOpenCodeVersion -match '^\d+\.\d+\.\d+$') {
            Add-NviocTiming -Stage 'version-from-verified-state'
            return [string]$script:NviocVerifiedOpenCodeVersion
        }

        # Test-NviocOpenCodeWorks has already validated this exact binary and
        # records its version in a sidecar receipt.  Reusing that receipt keeps
        # every interactive launch from spawning Bun just to ask for --version
        # again (which costs about a second on this machine).  If the receipt
        # is absent or stale, revalidate synchronously and fail closed.
        $receiptPath = "$Path.verified.json"
        try {
            if (Test-Path -LiteralPath $receiptPath -PathType Leaf) {
                $receipt = Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
                $file = Get-Item -LiteralPath $Path -ErrorAction Stop
                if ([long]$receipt.length -eq $file.Length -and
                    [long]$receipt.lastWriteTimeUtcTicks -eq $file.LastWriteTimeUtc.Ticks -and
                    [string]$receipt.identity -eq 'opencode models' -and
                    [string]$receipt.version -match '^\d+\.\d+\.\d+$') {
                    Add-NviocTiming -Stage 'version-from-receipt'
                    return [string]$receipt.version
                }
            }
        } catch { }

        $version = ((& $Path '--version' 2>$null) -join '').Trim()
        if ($version -notmatch '^\d+\.\d+\.\d+$') {
            throw "nvioc: could not verify the OpenCode version at $Path."
        }
        Add-NviocTiming -Stage 'version-from-native'
        return $version
    }

    $openCodePath = Resolve-NviocOpenCode
    if ($openCodePath -and -not (Test-NviocOpenCodeWorks -Path $openCodePath)) {
        Write-Host "OC_PROGRESS stage=invalid-binary path=$openCodePath"
        $openCodePath = $null
    }
    if (-not $openCodePath) {
        # Never fail with 'not installed': run the permanent installer on the
        # spot and re-resolve (same auto-bootstrap as the oc launcher).
        Write-Host 'OC_PROGRESS stage=not-installed-auto-bootstrap'
        $installer = 'F:\study\Platforms\windows\functions\getoc2.ps1'
        if (Test-Path -LiteralPath $installer -PathType Leaf) {
            & $installer
            if (-not $?) {
                throw "nvioc: opencode auto-install failed: $installer"
            }
        } else {
            throw "nvioc: opencode auto-install script is missing: $installer"
        }
        $openCodePath = Resolve-NviocOpenCode
        Write-Host "OC_PROGRESS stage=auto-installed path=$openCodePath"
        if ($openCodePath -and -not (Test-NviocOpenCodeWorks -Path $openCodePath)) {
            throw "nvioc: OpenCode bootstrap returned an unusable command: $openCodePath"
        }
    }
    if (-not $openCodePath) {
        throw 'nvioc: opencode could not be installed. Check your network / npm, then run getoc2 manually.'
    }
    Add-NviocTiming -Stage 'binary-ready'

    # A ranked version check is metadata-only.  The resolver above has already
    # validated the exact OpenCode binary and records its semantic version in a
    # receipt.  Re-running the same Bun shim concurrently for all four slots can
    # contend on its global startup state and make an otherwise instant version
    # check appear hung; use the validated receipt and invoke the binary only
    # when the receipt is unavailable.
    if ($Args.Count -eq 1 -and [string]$Args[0] -match '^--?version$') {
        $version = $null
        $receiptPath = "$openCodePath.verified.json"
        try {
            if (Test-Path -LiteralPath $receiptPath -PathType Leaf) {
                $receipt = Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
                if ([string]$receipt.identity -eq 'opencode models' -and
                    [string]$receipt.version -match '^\d+\.\d+\.\d+$') {
                    $version = [string]$receipt.version
                }
            }
        } catch { }
        if (-not $version) {
            $version = ((& $openCodePath '--version' 2>$null) -join '').Trim()
        }
        if ($version -notmatch '^\d+\.\d+\.\d+$') {
            throw "nvioc: could not verify the OpenCode version at $openCodePath."
        }
        Write-Output $version
        $global:LASTEXITCODE = 0
        return
    }

    Write-NviocModelIdentity -Stage route -Requested $requestedModelArg -Selected $finalModelArg `
        -Status 'route-selected' -Fallback $modelFallbackApplied -FallbackReason $modelFallbackReason
    Write-Host "OC_PROGRESS stage=launching model=$finalModelArg label=$finalLabel"
    # OpenCode snapshots contend on one internal Git worktree when many nvi
    # sessions start together. Disable only that local bookkeeping layer for
    # this launch; model reasoning, tools, context, and user files are unchanged.
    $previousConfigContent = $env:OPENCODE_CONFIG_CONTENT
    try {
        $runtimeConfig = [ordered]@{}
        if (-not [string]::IsNullOrWhiteSpace($previousConfigContent)) {
            try {
                $existingRuntimeConfig = $previousConfigContent | ConvertFrom-Json
                foreach ($property in $existingRuntimeConfig.PSObject.Properties) {
                    $runtimeConfig[$property.Name] = $property.Value
                }
            } catch {
                Write-Host 'OC_PROGRESS stage=config-content-invalid using=nvi-safe-runtime'
            }
        }
        $runtimeConfig['snapshot'] = $false
        $runtimeAgents = [ordered]@{}
        if ($runtimeConfig.Contains('agent') -and $null -ne $runtimeConfig['agent']) {
            foreach ($property in $runtimeConfig['agent'].PSObject.Properties) {
                $runtimeAgents[$property.Name] = $property.Value
            }
        }
        $runtimeTitleAgent = [ordered]@{}
        if ($runtimeAgents.Contains('title') -and $null -ne $runtimeAgents['title']) {
            foreach ($property in $runtimeAgents['title'].PSObject.Properties) {
                $runtimeTitleAgent[$property.Name] = $property.Value
            }
        }
        $runtimeTitleAgent['disable'] = $true
        $runtimeAgents['title'] = $runtimeTitleAgent
        $runtimeConfig['agent'] = $runtimeAgents
        # OpenCode 1.18 still invokes its hidden title worker even when that
        # agent is disabled. Keep the cosmetic request off the selected model
        # and route it through the verified low-latency 9B endpoint instead.
        $runtimeConfig['small_model'] = 'nvidia-nim/nvidia/nvidia-nemotron-nano-9b-v2'
        $env:OPENCODE_CONFIG_CONTENT = $runtimeConfig | ConvertTo-Json -Depth 20 -Compress

        # OpenCode 1.18 opens the same SQLite database independently in every
        # local TUI/run process. Thirty simultaneous clients can therefore fail
        # with "database is locked" before the selected model is contacted.
        # Keep one localhost-only OpenCode backend as the sole database owner;
        # every nvi client attaches to it and retains the shared session history.
        # Keep the NVIDIA backend away from any user-started OpenCode process.
        # OpenCode stores its SQLite session database globally; sharing that
        # file made an unrelated TUI able to block NVIDIA session creation for
        # tens of seconds.  The dedicated port/data root makes this backend an
        # independent owner while preserving the normal OpenCode UI.
        $sharedServerPort = 4098
        $sharedServerUrl = "http://127.0.0.1:$sharedServerPort"
        $sharedServerMutexName = 'Local\NviOpenCodeSharedServer4098'
        $sharedDataHome = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\nvioc-data'
        # OpenCode's attached CLI can occasionally lose its first submission
        # when several clients are started at the same instant.  Serialize
        # only that short hand-off; model inference remains concurrent after
        # the server has observed each user message.
        $sharedSubmissionMutexName = 'Local\NviOpenCodeSharedRunSubmitV1'
        $sharedServerOutLog = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\shared-server.out.log'
        $sharedServerErrLog = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\shared-server.err.log'
        $sharedServerReadyMarker = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\nvioc-shared-server-ready.json'

        function Resolve-NviocServerExecutable {
            $clientVersion = Get-NviocOpenCodeVersion -Path $openCodePath
            # Resolve-NviocOpenCode validates the client shim, but a shim-based
            # install still needs the matching native server binary.  Cache that
            # exact path/version/file identity after the first validation; the
            # old loop spawned Bun on every launch and could consume a full
            # second before the shared server was even checked.
            $serverReceiptPath = Join-Path $env:LOCALAPPDATA 'OpenCodeStable\nvioc-server-executable.json'
            if ([IO.Path]::GetExtension($openCodePath) -ieq '.exe' -and
                (Test-Path -LiteralPath $openCodePath -PathType Leaf)) {
                return $openCodePath
            }
            $serverCandidates = @(
                (Join-Path (Split-Path -Parent $openCodePath) 'opencode.exe'),
                (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\bin\opencode.exe'),
                (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64\bin\opencode.exe'),
                (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64-baseline\bin\opencode.exe'),
                (Join-Path $env:APPDATA 'npm\node_modules\opencode-ai\bin\opencode.exe'),
                (Join-Path $env:LOCALAPPDATA 'OpenCodeStable\opencode.exe')
            )
            foreach ($candidate in @($serverCandidates | Select-Object -Unique)) {
                if (-not (Test-Path -LiteralPath $candidate -PathType Leaf)) { continue }
                try {
                    $candidateFile = Get-Item -LiteralPath $candidate -ErrorAction Stop
                    if (Test-Path -LiteralPath $serverReceiptPath -PathType Leaf) {
                        $receipt = Get-Content -LiteralPath $serverReceiptPath -Raw | ConvertFrom-Json
                        if ([string]::Equals(
                            [IO.Path]::GetFullPath([string]$receipt.path),
                            [IO.Path]::GetFullPath($candidate),
                            [StringComparison]::OrdinalIgnoreCase
                        ) -and
                            [long]$receipt.length -eq $candidateFile.Length -and
                            [long]$receipt.lastWriteTimeUtcTicks -eq $candidateFile.LastWriteTimeUtc.Ticks -and
                            [string]$receipt.version -eq $clientVersion) {
                            return [IO.Path]::GetFullPath($candidate)
                        }
                    }
                } catch { }
                try {
                    $serverVersion = ((& $candidate '--version' 2>$null) -join '').Trim()
                    if ($serverVersion -eq $clientVersion -and $serverVersion -match '^\d+\.\d+\.\d+$') {
                        try {
                            $candidateFile = Get-Item -LiteralPath $candidate -ErrorAction Stop
                            $receiptDir = Split-Path -Parent $serverReceiptPath
                            if (-not (Test-Path -LiteralPath $receiptDir -PathType Container)) {
                                New-Item -ItemType Directory -Force -Path $receiptDir | Out-Null
                            }
                            $temporaryReceipt = "$serverReceiptPath.tmp.$PID.$([guid]::NewGuid().ToString('N'))"
                            [IO.File]::WriteAllText(
                                $temporaryReceipt,
                                (([ordered]@{
                                    path = [IO.Path]::GetFullPath($candidate)
                                    length = $candidateFile.Length
                                    lastWriteTimeUtcTicks = $candidateFile.LastWriteTimeUtc.Ticks
                                    version = $serverVersion
                                } | ConvertTo-Json -Depth 5) + "`r`n"),
                                (New-Object Text.UTF8Encoding($false))
                            )
                            Move-Item -LiteralPath $temporaryReceipt -Destination $serverReceiptPath -Force
                        } catch { }
                        return [IO.Path]::GetFullPath($candidate)
                    }
                } catch { }
            }
            return $null
        }

        function Get-NviocListenerProcessIds {
            param([int]$Port)
            $listenerIds = @()
            try {
                foreach ($connection in @(Get-NetTCPConnection -State Listen -LocalPort $Port -ErrorAction Stop)) {
                    if ([int]$connection.OwningProcess -gt 0) {
                        $listenerIds += [int]$connection.OwningProcess
                    }
                }
            } catch {
                $netstatPath = Join-Path $env:SystemRoot 'System32\netstat.exe'
                if (Test-Path -LiteralPath $netstatPath -PathType Leaf) {
                    foreach ($line in @(& $netstatPath -ano -p tcp 2>$null)) {
                        if ($line -match ('^\s*TCP\s+\S+:' + [regex]::Escape([string]$Port) + '\s+\S+\s+LISTENING\s+(\d+)\s*$')) {
                            $listenerIds += [int]$matches[1]
                        }
                    }
                }
            }
            return @($listenerIds | Select-Object -Unique)
        }

        function Test-NviocSharedServerIdentity {
            param(
                [int]$Port,
                [string]$ServerExecutable
            )
            $listenerIds = @(Get-NviocListenerProcessIds -Port $Port)
            if ($listenerIds.Count -ne 1) { return $false }
            try {
                $listener = Get-CimInstance Win32_Process -Filter "ProcessId=$($listenerIds[0])" -ErrorAction Stop
                if (-not $listener -or $listener.Name -ne 'opencode.exe') { return $false }
                $commandLine = [string]$listener.CommandLine
                if ($commandLine -notmatch '(?i)\bserve\b' -or
                    $commandLine -notmatch ('(?i)--port\s+' + [regex]::Escape([string]$Port) + '(?:\s|$)')) {
                    return $false
                }
                $expectedPath = [IO.Path]::GetFullPath($ServerExecutable)
                if ($listener.ExecutablePath) {
                    return [string]::Equals(
                        [IO.Path]::GetFullPath([string]$listener.ExecutablePath),
                        $expectedPath,
                        [StringComparison]::OrdinalIgnoreCase
                    )
                }
                return $commandLine.IndexOf($expectedPath, [StringComparison]::OrdinalIgnoreCase) -ge 0
            } catch {
                return $false
            }
        }

        function Test-NviocOwnedSharedServerProcess {
            param([int]$Port)
            $listenerIds = @(Get-NviocListenerProcessIds -Port $Port)
            if ($listenerIds.Count -ne 1) { return $false }
            try {
                $listener = Get-CimInstance Win32_Process -Filter "ProcessId=$($listenerIds[0])" -ErrorAction Stop
                if (-not $listener -or $listener.Name -ne 'opencode.exe') { return $false }
                $commandLine = [string]$listener.CommandLine
                if ($commandLine -notmatch '(?i)\bserve\b' -or
                    $commandLine -notmatch ('(?i)--port\s+' + [regex]::Escape([string]$Port) + '(?:\s|$)')) {
                    return $false
                }
                $trustedPaths = @(
                    (Join-Path $env:LOCALAPPDATA 'OpenCodeStable\opencode.exe'),
                    (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\bin\opencode.exe'),
                    (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64\bin\opencode.exe'),
                    (Join-Path $env:LOCALAPPDATA 'npm-global\node_modules\opencode-ai\node_modules\opencode-windows-x64-baseline\bin\opencode.exe'),
                    (Join-Path $env:APPDATA 'npm\node_modules\opencode-ai\bin\opencode.exe')
                )
                $listenerPath = if ($listener.ExecutablePath) { [IO.Path]::GetFullPath([string]$listener.ExecutablePath) } else { '' }
                foreach ($trustedPath in @($trustedPaths | Select-Object -Unique)) {
                    if ([string]::Equals($listenerPath, [IO.Path]::GetFullPath($trustedPath), [StringComparison]::OrdinalIgnoreCase)) {
                        return $true
                    }
                }
            } catch { }
            return $false
        }

        function Write-NviocSharedServerReadyMarker {
            param(
                [int]$Port,
                [string]$Version,
                [string]$ServerExecutable,
                [int]$ProcessId
            )
            try {
                $process = Get-Process -Id $ProcessId -ErrorAction Stop
                $payload = [ordered]@{
                    port = $Port
                    version = $Version
                    executable = [IO.Path]::GetFullPath($ServerExecutable)
                    dataHome = [IO.Path]::GetFullPath($sharedDataHome)
                    processId = $ProcessId
                    processStartUtcTicks = $process.StartTime.ToUniversalTime().Ticks
                }
                $markerDir = Split-Path -Parent $sharedServerReadyMarker
                if (-not (Test-Path -LiteralPath $markerDir -PathType Container)) {
                    New-Item -ItemType Directory -Force -Path $markerDir | Out-Null
                }
                $temporaryPath = "$sharedServerReadyMarker.tmp.$PID.$([guid]::NewGuid().ToString('N'))"
                [IO.File]::WriteAllText(
                    $temporaryPath,
                    (($payload | ConvertTo-Json -Depth 5) + "`r`n"),
                    (New-Object Text.UTF8Encoding($false))
                )
                Move-Item -LiteralPath $temporaryPath -Destination $sharedServerReadyMarker -Force
                Write-Host "OC_PROGRESS stage=shared-server-marker-written pid=$ProcessId"
            } catch {
                Write-Host "OC_PROGRESS stage=shared-server-marker-skip msg=$($_.Exception.Message)"
            }
        }

        function Test-NviocCachedSharedServer {
            param(
                [string]$Url,
                [int]$Port,
                [string]$ServerExecutable,
                [string]$ExpectedVersion
            )
            try {
                if (-not (Test-Path -LiteralPath $sharedServerReadyMarker -PathType Leaf)) {
                    return $false
                }
                $marker = Get-Content -LiteralPath $sharedServerReadyMarker -Raw | ConvertFrom-Json
                if ([int]$marker.port -ne $Port -or
                    [string]$marker.version -ne $ExpectedVersion -or
                    -not [string]$marker.executable -or
                    -not [string]$marker.dataHome) {
                    return $false
                }
                if (-not [string]::Equals(
                    [IO.Path]::GetFullPath([string]$marker.executable),
                    [IO.Path]::GetFullPath($ServerExecutable),
                    [StringComparison]::OrdinalIgnoreCase
                )) {
                    return $false
                }
                if (-not [string]::Equals(
                    [IO.Path]::GetFullPath([string]$marker.dataHome),
                    [IO.Path]::GetFullPath($sharedDataHome),
                    [StringComparison]::OrdinalIgnoreCase
                )) {
                    return $false
                }
                # A marker is written only after the full listener/process
                # identity check. Once that exact PID and start time are still
                # alive, the subsequent model-pinned POST /session is the
                # liveness probe. Avoid an extra /global/health request here:
                # a slow health endpoint used to add 2-5 seconds to every TUI.
                $process = Get-Process -Id ([int]$marker.processId) -ErrorAction Stop
                if ([long]$marker.processStartUtcTicks -ne $process.StartTime.ToUniversalTime().Ticks) {
                    return $false
                }
                return $true
            } catch {
                return $false
            }
        }

        function Test-NviocSharedServer {
            param(
                [string]$Url,
                [int]$Port,
                [string]$ServerExecutable,
                [string]$ExpectedVersion
            )
            try {
                # The marker is written only after a full identity and session
                # read-path check.  On later launches, verify the same PID,
                # process start time, listener, and health endpoint without
                # repeating WMI and SQLite validation before opening the TUI.
                if (Test-NviocCachedSharedServer -Url $Url -Port $Port `
                    -ServerExecutable $ServerExecutable -ExpectedVersion $ExpectedVersion) {
                    return $true
                }
                $health = Invoke-RestMethod -Uri "$Url/global/health" -Method Get -TimeoutSec 5 -ErrorAction Stop
                if (-not $health.healthy -or [string]$health.version -ne $ExpectedVersion) {
                    return $false
                }
                if (-not (Test-NviocSharedServerIdentity -Port $Port -ServerExecutable $ServerExecutable)) {
                    return $false
                }
                # /global/health can remain green while the session/SQLite
                # path is wedged.  Probe the same read path used by runs so a
                # stale server is restarted before a wrapper can hang.
                $sessionProbe = Invoke-WebRequest -Uri "$Url/session?limit=1" -Method Get `
                    -TimeoutSec 5 -UseBasicParsing -ErrorAction Stop
                if ([int]$sessionProbe.StatusCode -ne 200) { return $false }
                $listenerIds = @(Get-NviocListenerProcessIds -Port $Port)
                if ($listenerIds.Count -eq 1) {
                    Write-NviocSharedServerReadyMarker -Port $Port -Version $ExpectedVersion `
                        -ServerExecutable $ServerExecutable -ProcessId ([int]$listenerIds[0])
                }
                return $true
            } catch {
                return $false
            }
        }

        function Ensure-NviocSharedServer {
            param(
                [string]$Url,
                [int]$Port,
                [string]$ServerExecutable,
                [string]$ExpectedVersion,
                [switch]$ForceRestart
            )
            if ($ForceRestart) {
                $configChangeListeners = @(Get-NviocListenerProcessIds -Port $Port)
                if ($configChangeListeners.Count -gt 0) {
                    if ($configChangeListeners.Count -ne 1 -or
                        -not (Test-NviocOwnedSharedServerProcess -Port $Port)) {
                        throw "nvioc: refusing to restart unverified process on port $Port after provider configuration changed."
                    }
                    Write-Host "OC_PROGRESS stage=shared-server-config-restart port=$Port pid=$($configChangeListeners[0])"
                    Stop-Process -Id ([int]$configChangeListeners[0]) -Force -ErrorAction SilentlyContinue
                    for ($configWait = 1; $configWait -le 100; $configWait++) {
                        if (@(Get-NviocListenerProcessIds -Port $Port).Count -eq 0) { break }
                        Start-Sleep -Milliseconds 100
                    }
                    if (@(Get-NviocListenerProcessIds -Port $Port).Count -gt 0) {
                        throw "nvioc: dedicated OpenCode server did not release port $Port after provider configuration changed."
                    }
                }
            }
            if (-not $ForceRestart -and (Test-NviocSharedServer -Url $Url -Port $Port -ServerExecutable $ServerExecutable -ExpectedVersion $ExpectedVersion)) {
                Write-Host "OC_PROGRESS stage=shared-server-ready port=$Port version=$ExpectedVersion"
                return
            }

            $serverMutex = New-Object Threading.Mutex($false, $sharedServerMutexName)
            $serverLockTaken = $false
            try {
                try {
                    $serverLockTaken = $serverMutex.WaitOne(30000)
                } catch [Threading.AbandonedMutexException] {
                    $serverLockTaken = $true
                }
                if (-not $serverLockTaken) {
                    throw "nvioc: timed out waiting for shared OpenCode server startup on port $Port."
                }
                if (-not $ForceRestart -and (Test-NviocSharedServer -Url $Url -Port $Port -ServerExecutable $ServerExecutable -ExpectedVersion $ExpectedVersion)) {
                    Write-Host "OC_PROGRESS stage=shared-server-ready port=$Port version=$ExpectedVersion"
                    return
                }

                $listeners = @(Get-NviocListenerProcessIds -Port $Port)
                if ($listeners.Count -gt 0) {
                    # A verified shared server may be briefly slow while other
                    # ranked functions are creating sessions. Give an exact
                    # expected binary a short recovery window before replacing
                    # it, but recover a stale owned OpenCode listener instead
                    # of leaving every ranked wrapper blocked forever.
                    if ($listeners.Count -eq 1 -and
                        (Test-NviocSharedServerIdentity -Port $Port -ServerExecutable $ServerExecutable)) {
                        Write-Host "OC_PROGRESS stage=shared-server-recheck port=$Port pid=$($listeners[0])"
                        $healthDeadline = (Get-Date).AddSeconds(20)
                        while ((Get-Date) -lt $healthDeadline) {
                            if (Test-NviocSharedServer -Url $Url -Port $Port -ServerExecutable $ServerExecutable -ExpectedVersion $ExpectedVersion) {
                                Write-Host "OC_PROGRESS stage=shared-server-ready port=$Port version=$ExpectedVersion"
                                return
                            }
                            Start-Sleep -Milliseconds 250
                        }
                    } elseif ($listeners.Count -eq 1 -and (Test-NviocOwnedSharedServerProcess -Port $Port)) {
                        Write-Host "OC_PROGRESS stage=shared-server-stale-owned-restart port=$Port pid=$($listeners[0])"
                    } else {
                        throw "nvioc: port $Port is owned by an unverified process (PID $($listeners -join ',')). Refusing to replace it."
                    }

                    $stalePid = [int]$listeners[0]
                    Stop-Process -Id $stalePid -Force -ErrorAction SilentlyContinue
                    for ($wait = 1; $wait -le 100; $wait++) {
                        if (@(Get-NviocListenerProcessIds -Port $Port).Count -eq 0) { break }
                        Start-Sleep -Milliseconds 100
                    }
                    if (@(Get-NviocListenerProcessIds -Port $Port).Count -gt 0) {
                        throw "nvioc: owned shared OpenCode server PID $stalePid did not release port $Port."
                    }
                }

                Write-Host "OC_PROGRESS stage=shared-server-starting port=$Port data=$sharedDataHome"
                if (-not (Test-Path -LiteralPath $sharedDataHome -PathType Container)) {
                    New-Item -ItemType Directory -Force -Path $sharedDataHome | Out-Null
                }
                $previousXdgDataHome = [Environment]::GetEnvironmentVariable(
                    'XDG_DATA_HOME', [EnvironmentVariableTarget]::Process
                )
                [Environment]::SetEnvironmentVariable(
                    'XDG_DATA_HOME', $sharedDataHome, [EnvironmentVariableTarget]::Process
                )
                try {
                    $serverProcess = Start-Process -FilePath $ServerExecutable -ArgumentList @(
                        'serve',
                        '--hostname', '127.0.0.1',
                        '--port', [string]$Port,
                        '--print-logs',
                        '--log-level', 'WARN'
                    ) -WindowStyle Hidden -RedirectStandardOutput $sharedServerOutLog `
                        -RedirectStandardError $sharedServerErrLog -PassThru -ErrorAction Stop
                } finally {
                    [Environment]::SetEnvironmentVariable(
                        'XDG_DATA_HOME', $previousXdgDataHome, [EnvironmentVariableTarget]::Process
                    )
                }

                $started = $false
                for ($attempt = 1; $attempt -le 200; $attempt++) {
                    if (Test-NviocSharedServer -Url $Url -Port $Port -ServerExecutable $ServerExecutable -ExpectedVersion $ExpectedVersion) {
                        $started = $true
                        break
                    }
                    if ($serverProcess.HasExited) { break }
                    if (($attempt % 20) -eq 0) {
                        Write-Host "OC_PROGRESS stage=shared-server-wait port=$Port elapsed_ms=$($attempt * 100)"
                    }
                    Start-Sleep -Milliseconds 100
                }
                if (-not $started) {
                    $detail = ''
                    if (Test-Path -LiteralPath $sharedServerErrLog -PathType Leaf) {
                        $detail = ((Get-Content -LiteralPath $sharedServerErrLog -Tail 8) -join ' ')
                    }
                    if (-not $serverProcess.HasExited) {
                        Stop-Process -Id $serverProcess.Id -Force -ErrorAction SilentlyContinue
                    }
                    throw "nvioc: shared OpenCode server failed to become healthy. $detail"
                }
                Write-Host "OC_PROGRESS stage=shared-server-started port=$Port pid=$($serverProcess.Id) version=$ExpectedVersion"
                $serverProcess.Dispose()
            } finally {
                if ($serverLockTaken) {
                    [void]$serverMutex.ReleaseMutex()
                }
                $serverMutex.Dispose()
            }
        }

        function Get-NviocDirectoryHeaders {
            param([string]$Directory)
            return @{ 'x-opencode-directory' = $Directory }
        }

        function New-NviocSharedSession {
            param(
                [string]$Url,
                [string]$Directory,
                [string]$Model,
                [string]$Label
            )
            $providerModel = $Model -replace '^nvidia-nim/', ''
            $payload = [ordered]@{
                # Keep the exact provider/model ID in the visible session title.
                # The human label is useful, but it is not an identity proof.
                title = "NVI | $Label | nvidia-nim/$providerModel"
                agent = 'build'
                model = [ordered]@{
                    providerID = 'nvidia-nim'
                    id = $providerModel
                    variant = 'default'
                }
            } | ConvertTo-Json -Depth 8 -Compress
            $headers = Get-NviocDirectoryHeaders -Directory $Directory
            $lastError = $null
            for ($attempt = 1; $attempt -le 4; $attempt++) {
                try {
                    $session = Invoke-RestMethod -Uri "$Url/session" -Method Post -Headers $headers `
                        -ContentType 'application/json' -Body $payload -TimeoutSec 30 -ErrorAction Stop
                    if ($session.id -and
                        [string]$session.model.providerID -eq 'nvidia-nim' -and
                        [string]$session.model.id -eq $providerModel) {
                        # A just-started isolated server can acknowledge the
                        # POST before its read path sees the committed row.
                        # Confirm visibility before handing the ID to attach;
                        # this prevents a transient "Session not found" screen
                        # without adding delay to an already-ready session.
                        for ($readbackAttempt = 1; $readbackAttempt -le 4; $readbackAttempt++) {
                            try {
                                $readback = Invoke-RestMethod -Uri "$Url/session/$($session.id)" `
                                    -Method Get -Headers $headers -TimeoutSec 2 -ErrorAction Stop
                                if ($readback.id -eq $session.id -and
                                    [string]$readback.model.providerID -eq 'nvidia-nim' -and
                                    [string]$readback.model.id -eq $providerModel) {
                                    return $session
                                }
                            } catch { }
                            Start-Sleep -Milliseconds (50 * $readbackAttempt)
                        }
                        $lastError = 'created session was not immediately visible to the attach read path'
                        continue
                    }
                    $lastError = 'server returned a session without the requested model'
                } catch {
                    $lastError = $_.Exception.Message
                }
                Start-Sleep -Milliseconds (250 * $attempt)
            }
            throw "nvioc: could not create the model-pinned shared session: $lastError"
        }

        function Get-NviocMessageModelIdentity {
            param([object]$Message)
            $info = if ($Message) { $Message.info } else { $null }
            $providerId = ''
            $modelId = ''
            if ($info) {
                if ($info.providerID) { $providerId = [string]$info.providerID }
                if ($info.modelID) { $modelId = [string]$info.modelID }
                if ($info.model) {
                    if (-not $providerId -and $info.model.providerID) {
                        $providerId = [string]$info.model.providerID
                    }
                    if (-not $modelId) {
                        if ($info.model.modelID) { $modelId = [string]$info.model.modelID }
                        elseif ($info.model.id) { $modelId = [string]$info.model.id }
                    }
                }
            }
            $qualified = ''
            if ($providerId -and $modelId) { $qualified = "$providerId/$modelId" }
            [pscustomobject]@{
                ProviderId = $providerId
                ModelId = $modelId
                Qualified = $qualified
            }
        }

        function Invoke-NviocSharedRun {
            param(
                [string]$Path,
                [string]$Url,
                [string]$Directory,
                [string]$Model,
                [string]$Label,
                [string[]]$RunArguments,
                [string]$RequestedModel,
                [bool]$FallbackApplied = $false,
                [string]$FallbackReason = 'none',
                [int]$RetryAttempt = 0
            )

            $jsonRequested = $false
            $showThinking = $false
            $hasDirectory = $false
            $requestedSessionId = $null
            $continueRequested = $false
            $normalized = @()
            for ($index = 0; $index -lt $RunArguments.Count; $index++) {
                $argument = [string]$RunArguments[$index]
                if ($argument -eq '--format') {
                    if ($index + 1 -lt $RunArguments.Count) {
                        $jsonRequested = [string]$RunArguments[$index + 1] -eq 'json'
                        $index++
                    }
                    continue
                }
                if ($argument -match '^--format=(.+)$') {
                    $jsonRequested = $matches[1] -eq 'json'
                    continue
                }
                if ($argument -eq '-s' -or $argument -eq '--session') {
                    if ($index + 1 -lt $RunArguments.Count) {
                        $requestedSessionId = [string]$RunArguments[$index + 1]
                    }
                } elseif ($argument -match '^--session=(.+)$') {
                    $requestedSessionId = $matches[1]
                } elseif ($argument -eq '-c' -or $argument -eq '--continue') {
                    $continueRequested = $true
                }
                if ($argument -eq '--thinking') { $showThinking = $true }
                if ($argument -eq '--dir' -or $argument -match '^--dir=') { $hasDirectory = $true }
                if ($argument -eq '--attach') {
                    if ($index + 1 -lt $RunArguments.Count) { $index++ }
                    continue
                }
                if ($argument -match '^--attach=') { continue }
                $normalized += $argument
            }

            $clientArguments = @('run', '--attach', $Url, '-m', $Model, '--format', 'json')
            $sessionId = $requestedSessionId
            if (-not $sessionId -and -not $continueRequested) {
                # Attached run can submit successfully and then exit before its
                # event stream prints the generated session ID. Create the
                # model-pinned session first so response recovery never depends
                # on that lossy client event.
                $preparedSession = New-NviocSharedSession -Url $Url -Directory $Directory `
                    -Model $Model -Label $Label
                $sessionId = [string]$preparedSession.id
                $clientArguments += @('--session', $sessionId)
                Write-Host "OC_PROGRESS stage=shared-run-session-created session=$sessionId model=$Model"
            }
            if (-not $hasDirectory) {
                $clientArguments += @('--dir', $Directory)
            }
            $clientArguments += $normalized

            # Keep a direct REST prompt ready as a bounded transport fallback.
            # It is used only when the attached CLI exits before the server
            # observes the user message; normal runs retain the native CLI
            # transport and all OpenCode agent behavior.
            $directPromptParts = @()
            $directPromptStarted = $false
            $skipDirectPromptArgument = $false
            for ($index = 0; $index -lt $normalized.Count; $index++) {
                $argument = [string]$normalized[$index]
                if ($skipDirectPromptArgument) {
                    $skipDirectPromptArgument = $false
                    continue
                }
                if ($argument -eq '--') {
                    $directPromptStarted = $true
                    continue
                }
                if ($argument -eq '-s' -or $argument -eq '--session' -or
                    $argument -eq '--dir' -or $argument -eq '--agent' -or
                    $argument -eq '--variant') {
                    $skipDirectPromptArgument = $true
                    continue
                }
                if ($argument -match '^--(?:session|dir|agent|variant)=') { continue }
                if ($argument -eq '-c' -or $argument -eq '--thinking') { continue }
                if ($directPromptStarted -or $argument -notmatch '^-') {
                    $directPromptParts += $argument
                }
            }
            $directPrompt = (@($directPromptParts) -join ' ').Trim()

            $capturedLines = New-Object 'Collections.Generic.List[string]'
            $seenPartIds = @{}
            $clientToken = [guid]::NewGuid().ToString('N')
            $clientStdoutPath = Join-Path $env:TEMP "nvioc-client-$PID-$clientToken.out"
            $clientStderrPath = Join-Path $env:TEMP "nvioc-client-$PID-$clientToken.err"
            $submissionMutex = New-Object Threading.Mutex($false, $sharedSubmissionMutexName)
            $submissionLockTaken = $false
            try {
                try {
                    $submissionLockTaken = $submissionMutex.WaitOne(30000)
                } catch [Threading.AbandonedMutexException] {
                    $submissionLockTaken = $true
                }
                if (-not $submissionLockTaken) {
                    throw 'nvioc: timed out waiting for the shared OpenCode submission gate.'
                }
                Write-Host 'OC_PROGRESS stage=shared-submit-gate-acquired'

                # Do not invoke the attached CLI synchronously.  OpenCode can
                # block before emitting its first event while the server is
                # unhealthy; Start-Process lets the bounded REST watchdog
                # observe that condition and terminate only this client.
                try {
                    $clientProcess = Start-Process -FilePath $Path -ArgumentList $clientArguments `
                        -RedirectStandardOutput $clientStdoutPath -RedirectStandardError $clientStderrPath `
                        -WindowStyle Hidden -PassThru -ErrorAction Stop
                    Write-Host "OC_PROGRESS stage=shared-client-started pid=$($clientProcess.Id) session=$sessionId"
                } catch {
                    throw "nvioc: could not start attached OpenCode client: $($_.Exception.Message)"
                }
                $nativeExitCode = -1
                $resultCode = -1

                if ($sessionId) {
                    $messages = $null
                    $headers = Get-NviocDirectoryHeaders -Directory $Directory
                    $lastReadError = $null
                    $assistant = @()
                    $assistantComplete = $false
                    $requestObserved = $false
                # The proxy has a hard three-minute upstream deadline.  Keep
                # the client watchdog finite as well so a stale OpenCode
                # session can never leave a wrapper waiting for hours.  An
                # explicit environment override is available for unusually
                # long, user-authorized runs, but the safe default remains
                # bounded.
                $responseDeadlineSeconds = 300
                $responseDeadlineOverride = 0
                if ([int]::TryParse([string]$env:NVIDIA_NVI_RESPONSE_DEADLINE_SECONDS, [ref]$responseDeadlineOverride) -and
                    $responseDeadlineOverride -ge 60 -and $responseDeadlineOverride -le 7200) {
                    $responseDeadlineSeconds = $responseDeadlineOverride
                }
                $responseDeadline = [DateTime]::UtcNow.AddSeconds($responseDeadlineSeconds)
                $submissionDeadline = [DateTime]::UtcNow.AddSeconds(30)
                $nextProgress = [DateTime]::UtcNow.AddSeconds(2)
                $waitStopwatch = [Diagnostics.Stopwatch]::StartNew()
                while ([DateTime]::UtcNow -lt $responseDeadline) {
                    try {
                        $messages = Invoke-RestMethod -Uri "$Url/session/$sessionId/message" -Method Get `
                            -Headers $headers -TimeoutSec 5 -ErrorAction Stop
                        $lastReadError = $null
                        $requestObserved = @($messages | Where-Object { $_.info.role -eq 'user' }).Count -gt 0
                        $assistant = @($messages | Where-Object { $_.info.role -eq 'assistant' } |
                            Sort-Object { [int64]$_.info.time.created } | Select-Object -Last 1)
                        if ($assistant.Count -eq 1 -and
                            ($assistant[0].info.time.completed -or $assistant[0].info.error)) {
                            $assistantComplete = $true
                            break
                        }
                    } catch {
                        $lastReadError = $_.Exception.Message
                    }
                    # Once the server has observed the user request, the
                    # attached CLI is only a transport client.  Keep reading
                    # the authoritative session even if that client exits;
                    # otherwise a completed upstream response can be reported
                    # as a false timeout.
                    if ($clientProcess.HasExited -and -not $assistantComplete -and -not $requestObserved) {
                        break
                    }
                    if (-not $requestObserved -and [DateTime]::UtcNow -ge $submissionDeadline) {
                        break
                    }
                    if ([DateTime]::UtcNow -ge $nextProgress) {
                        $state = if ($requestObserved) { 'running' } else { 'submitting' }
                        Write-Host "OC_PROGRESS stage=shared-run-wait session=$sessionId state=$state elapsed_ms=$($waitStopwatch.ElapsedMilliseconds)"
                        $nextProgress = [DateTime]::UtcNow.AddSeconds(5)
                    }
                    if ($requestObserved -and $submissionLockTaken) {
                        [void]$submissionMutex.ReleaseMutex()
                        $submissionLockTaken = $false
                        Write-Host 'OC_PROGRESS stage=shared-submit-gate-released'
                    }
                    # /message behaves like a long-poll on an idle session.
                    # A 200ms loop accumulates listeners in the shared server;
                    # one bounded poll per second preserves responsiveness
                    # without creating a server-side event-listener leak.
                    Start-Sleep -Milliseconds 1000
                }
                $waitStopwatch.Stop()

                if ($submissionLockTaken) {
                    [void]$submissionMutex.ReleaseMutex()
                    $submissionLockTaken = $false
                    Write-Host 'OC_PROGRESS stage=shared-submit-gate-released'
                }

                if ($clientProcess -and -not $clientProcess.HasExited) {
                    Stop-Process -Id $clientProcess.Id -Force -ErrorAction SilentlyContinue
                    [void]$clientProcess.WaitForExit(5000)
                }
                if ($clientProcess -and $clientProcess.HasExited) {
                    $nativeExitCode = [int]$clientProcess.ExitCode
                } else {
                    $nativeExitCode = -999
                }
                $resultCode = $nativeExitCode
                foreach ($clientOutputPath in @($clientStdoutPath, $clientStderrPath)) {
                    if (-not (Test-Path -LiteralPath $clientOutputPath -PathType Leaf)) { continue }
                    foreach ($clientLine in @(Get-Content -LiteralPath $clientOutputPath -ErrorAction SilentlyContinue)) {
                        [void]$capturedLines.Add([string]$clientLine)
                    }
                    Remove-Item -LiteralPath $clientOutputPath -Force -ErrorAction SilentlyContinue
                }

                if (-not $assistantComplete -and -not $requestObserved -and
                    -not [string]::IsNullOrWhiteSpace($directPrompt)) {
                    try {
                        Write-Host 'OC_PROGRESS stage=shared-rest-submit-fallback'
                        $restPayload = [ordered]@{
                            parts = @(
                                [ordered]@{
                                    type = 'text'
                                    text = $directPrompt
                                }
                            )
                        } | ConvertTo-Json -Depth 12 -Compress
                        $restResponse = Invoke-RestMethod -Uri "$Url/session/$sessionId/message" `
                            -Method Post -Headers $headers -ContentType 'application/json' `
                            -Body $restPayload -TimeoutSec $responseDeadlineSeconds -ErrorAction Stop
                        if ($restResponse.info.role -ne 'assistant') {
                            throw 'OpenCode REST fallback returned no assistant message.'
                        }
                        $assistant = @($restResponse)
                        $assistantComplete = $true
                        $requestObserved = $true
                        $resultCode = 0
                        Write-Host 'OC_PROGRESS stage=shared-rest-submit-complete'
                    } catch {
                        $lastReadError = $_.Exception.Message
                        Write-Host "OC_PROGRESS stage=shared-rest-submit-failed detail=$lastReadError"
                    }
                }
                if ($assistantComplete) {
                    # The REST session is authoritative.  The attached CLI is
                    # only a transport client and may still be flushing its
                    # event stream when the completed assistant message is
                    # already available.
                    $resultCode = 0
                }

                if ($assistantComplete) {
                    $responseIdentity = Get-NviocMessageModelIdentity -Message $assistant[0]
                    $expectedProvider = 'nvidia-nim'
                    $expectedProviderModel = $Model -replace '^nvidia-nim/', ''
                    $responseMatchesRequest = [string]$responseIdentity.ProviderId -eq $expectedProvider -and
                        [string]$responseIdentity.ModelId -eq $expectedProviderModel
                    if (-not $responseIdentity.Qualified) {
                        Write-NviocModelIdentity -Stage response -Requested $RequestedModel -Selected $Model `
                            -Status 'provider-response-metadata-missing' -Fallback $FallbackApplied `
                            -FallbackReason $FallbackReason
                        throw "nvioc: provider response omitted model identity metadata; refusing to report success for $Model."
                    }
                    if (-not $responseMatchesRequest) {
                        Write-NviocModelIdentity -Stage response -Requested $RequestedModel -Selected $Model `
                            -Actual $responseIdentity.Qualified -Status 'provider-response-mismatch' `
                            -Fallback $FallbackApplied -FallbackReason $FallbackReason
                        throw "nvioc: provider response model mismatch; requested route=$Model actual=$($responseIdentity.Qualified)."
                    }
                    Write-NviocModelIdentity -Stage response -Requested $RequestedModel -Selected $Model `
                        -Actual $responseIdentity.Qualified -Status 'provider-response-metadata' `
                        -Fallback $FallbackApplied -FallbackReason $FallbackReason
                    if ($jsonRequested) {
                        [ordered]@{
                            type = 'model_identity'
                            timestamp = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
                            sessionID = $sessionId
                            requestedModel = $RequestedModel
                            selectedModel = $Model
                            actualModel = $responseIdentity.Qualified
                            identityStatus = 'provider-response-metadata'
                            fallbackApplied = $FallbackApplied
                            fallbackReason = $FallbackReason
                        } | ConvertTo-Json -Depth 12 -Compress | Write-Output
                    }
                    foreach ($part in @($assistant[0].parts)) {
                        if ($part.id -and $seenPartIds.ContainsKey([string]$part.id)) { continue }
                        $eventType = $null
                        if ($part.type -eq 'step-start') { $eventType = 'step_start' }
                        elseif ($part.type -eq 'step-finish') { $eventType = 'step_finish' }
                        elseif ($part.type -eq 'text') { $eventType = 'text' }
                        elseif ($part.type -eq 'reasoning') { $eventType = 'reasoning' }
                        elseif ($part.type -eq 'tool') { $eventType = 'tool_use' }
                        if (-not $eventType) { continue }

                        if ($jsonRequested) {
                            [ordered]@{
                                type = $eventType
                                timestamp = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
                                sessionID = $sessionId
                                part = $part
                            } | ConvertTo-Json -Depth 30 -Compress | Write-Output
                        } elseif ($part.type -eq 'text' -and -not [string]::IsNullOrWhiteSpace([string]$part.text)) {
                            Write-Output ([string]$part.text).Trim()
                        } elseif ($part.type -eq 'reasoning' -and $showThinking -and -not [string]::IsNullOrWhiteSpace([string]$part.text)) {
                            Write-Output ("Thinking: " + ([string]$part.text).Trim())
                        } elseif ($part.type -eq 'tool') {
                            Write-Host "OC_PROGRESS stage=tool name=$($part.tool) status=$($part.state.status)"
                        }
                    }
                    if ($assistant[0].info.error) {
                        $errorDetail = $assistant[0].info.error | ConvertTo-Json -Depth 12 -Compress
                        throw "nvioc: shared run failed in session ${sessionId}: $errorDetail"
                    }
                } else {
                    $reason = if (-not $requestObserved) {
                        'the attached client did not submit a user message within 30 seconds'
                    } elseif ($lastReadError) {
                        "the assistant response could not be read: $lastReadError"
                    } else {
                        "the assistant response did not complete before the ${responseDeadlineSeconds}-second upstream deadline"
                    }
                    # If the client died before the server observed a user
                    # message, retry once with a fresh model-pinned session.
                    # Replaying after requestObserved would risk duplicating a
                    # real task, so that path remains fail-closed and bounded.
                    if (-not $requestObserved -and $RetryAttempt -lt 1) {
                        Write-Host "OC_PROGRESS stage=shared-run-retry reason=client-submit-not-observed attempt=2"
                        Start-Sleep -Milliseconds 500
                        return Invoke-NviocSharedRun -Path $Path -Url $Url `
                            -Directory $Directory -Model $Model -Label $Label `
                            -RunArguments $RunArguments -RequestedModel $RequestedModel `
                            -FallbackApplied $FallbackApplied -FallbackReason $FallbackReason `
                            -RetryAttempt ($RetryAttempt + 1)
                    }
                    throw "nvioc: shared run session $sessionId failed because $reason."
                }
                } else {
                    if ($clientProcess -and -not $clientProcess.HasExited) {
                        Stop-Process -Id $clientProcess.Id -Force -ErrorAction SilentlyContinue
                    }
                    foreach ($clientOutputPath in @($clientStdoutPath, $clientStderrPath)) {
                        Remove-Item -LiteralPath $clientOutputPath -Force -ErrorAction SilentlyContinue
                    }
                    throw 'nvioc: attached continuation returned no session identifier.'
                }

                if ($resultCode -ne 0) {
                    throw "nvioc: attached OpenCode client exited with code $resultCode."
                }
                $global:LASTEXITCODE = 0
            } finally {
                if ($submissionLockTaken) {
                    [void]$submissionMutex.ReleaseMutex()
                }
                $submissionMutex.Dispose()
            }
        }

        $serverExecutable = Resolve-NviocServerExecutable
        if (-not $serverExecutable) {
            throw 'nvioc: the native OpenCode server executable is missing.'
        }
        Add-NviocTiming -Stage 'server-executable-ready'
        $openCodeVersion = Get-NviocOpenCodeVersion -Path $openCodePath
        if ($openCodeVersion -notmatch '^\d+\.\d+\.\d+$') {
            throw "nvioc: could not verify the OpenCode version at $openCodePath."
        }
        Add-NviocTiming -Stage 'version-ready'

        $firstArgument = if ($Args.Count -gt 0) { [string]$Args[0] } else { '' }
        $usesSharedServer = $Args.Count -eq 0 -or $firstArgument -eq 'run'
        if ($usesSharedServer) {
            Ensure-NviocSharedServer -Url $sharedServerUrl -Port $sharedServerPort `
                -ServerExecutable $serverExecutable -ExpectedVersion $openCodeVersion `
                -ForceRestart:$configWasUpdated
            Add-NviocTiming -Stage 'shared-server-ready'

            if ($Prewarm) {
                Write-Host "OC_PROGRESS stage=prewarm-ready port=$sharedServerPort data=$sharedDataHome"
                return
            }

    # The server deliberately has no global model. Pin the model in both
    # the client runtime and the individual session so every ranked wrapper
    # can use its distinct model simultaneously.
            $runtimeConfig['model'] = $finalModelArg
            $env:OPENCODE_CONFIG_CONTENT = $runtimeConfig | ConvertTo-Json -Depth 20 -Compress
            $currentDirectory = (Get-Location).ProviderPath

            if ($firstArgument -eq 'run') {
                $runArguments = @()
                if ($Args.Count -gt 1) { $runArguments = @($Args[1..($Args.Count - 1)]) }
                Invoke-NviocSharedRun -Path $serverExecutable -Url $sharedServerUrl `
                    -Directory $currentDirectory -Model $finalModelArg -Label $finalLabel `
                    -RunArguments $runArguments -RequestedModel $requestedModelArg `
                    -FallbackApplied $modelFallbackApplied -FallbackReason $modelFallbackReason
            } else {
                $session = New-NviocSharedSession -Url $sharedServerUrl -Directory $currentDirectory `
                    -Model $finalModelArg -Label $finalLabel
                $sessionProviderModel = "$( [string]$session.model.providerID )/$( [string]$session.model.id )" -replace '\s+', ''
                Write-NviocModelIdentity -Stage session -Requested $requestedModelArg -Selected $finalModelArg `
                    -Actual $sessionProviderModel -Status 'session-pinned-provider-model' `
                    -Fallback $modelFallbackApplied -FallbackReason $modelFallbackReason
                Write-Host "OC_PROGRESS stage=shared-session-ready session=$($session.id) model=$finalModelArg requested=$requestedModelArg fallback=$modelFallbackApplied"
                $interactiveReadyElapsedMs = $script:NviocStartupStopwatch.ElapsedMilliseconds
                Write-Host "OC_PROGRESS stage=interactive-ready model=$finalModelArg session=$($session.id) elapsed_ms=$interactiveReadyElapsedMs"
                # Tests can request a machine-readable receipt without adding
                # any work to normal launches.  The receipt is written before
                # the native TUI attaches, so it measures local readiness and
                # is not contaminated by model inference time.
                $startupReceiptPath = [string]$env:NVIDIA_NVI_INTERACTIVE_RECEIPT
                if (-not [string]::IsNullOrWhiteSpace($startupReceiptPath)) {
                    try {
                        $startupReceipt = [ordered]@{
                            status = 'interactive-ready'
                            function = [string]$env:NVIDIA_NVI_FUNCTION
                            model = $finalModelArg
                            requestedModel = $requestedModelArg
                            selectedModel = $finalModelArg
                            actualModel = $sessionProviderModel
                            identityStatus = 'session-pinned-provider-model;provider-response-pending'
                            fallbackApplied = $modelFallbackApplied
                            fallbackReason = $modelFallbackReason
                            session = [string]$session.id
                            elapsedMs = [int64]$interactiveReadyElapsedMs
                            timestampUtc = [DateTime]::UtcNow.ToString('o')
                            timingsMs = $script:NviocTiming
                        }
                        $startupReceiptDir = Split-Path -Parent $startupReceiptPath
                        if ($startupReceiptDir -and -not (Test-Path -LiteralPath $startupReceiptDir -PathType Container)) {
                            New-Item -ItemType Directory -Force -Path $startupReceiptDir | Out-Null
                        }
                        [IO.File]::WriteAllText(
                            $startupReceiptPath,
                            (($startupReceipt | ConvertTo-Json -Depth 5) + "`r`n"),
                            (New-Object Text.UTF8Encoding($false))
                        )
                    } catch {
                        Write-Host "OC_PROGRESS stage=interactive-receipt-skip msg=$($_.Exception.Message)"
                    }
                }
                $previousXdgDataHome = [Environment]::GetEnvironmentVariable(
                    'XDG_DATA_HOME', [EnvironmentVariableTarget]::Process
                )
                [Environment]::SetEnvironmentVariable(
                    'XDG_DATA_HOME', $sharedDataHome, [EnvironmentVariableTarget]::Process
                )
                try {
                    & $serverExecutable 'attach' $sharedServerUrl '--mini' '--session' ([string]$session.id) `
                        '--dir' $currentDirectory '--no-replay'
                } finally {
                    [Environment]::SetEnvironmentVariable(
                        'XDG_DATA_HOME', $previousXdgDataHome, [EnvironmentVariableTarget]::Process
                    )
                }
            }
        } else {
            # Metadata/debug commands do not open the session database and remain
            # direct, preserving the exact OpenCode CLI surface.
            & $openCodePath '-m' $finalModelArg @Args
        }
    } finally {
        if ($null -eq $previousConfigContent) {
            Remove-Item Env:OPENCODE_CONFIG_CONTENT -ErrorAction SilentlyContinue
        } else {
            $env:OPENCODE_CONFIG_CONTENT = $previousConfigContent
        }
    }
}

if ($MyInvocation.InvocationName -ne '.') {
    # Switches must be re-bound as real tokens: the profile module forwards
    # command-line args as a string ARRAY, and array-splatting '-Check' as a
    # positional string never binds the [switch]$Check parameter. Detect it
    # here and invoke with a literal switch token so -Check actually works.
    $__checkSwitch = $false
    $__prewarmSwitch = $false
    $__passArgs = @()
    foreach ($__a in $args) {
        if ($__a -eq '-Check' -or $__a -eq '-check') {
            $__checkSwitch = $true
        } elseif ($__a -eq '-Prewarm' -or $__a -eq '-prewarm') {
            $__prewarmSwitch = $true
        } else {
            $__passArgs += $__a
        }
    }
    if ($__prewarmSwitch) {
        & 'nvioc' -Prewarm @__passArgs
    } elseif ($__checkSwitch) {
        & 'nvioc' -Check @__passArgs
    } else {
        & 'nvioc' @__passArgs
    }
}
