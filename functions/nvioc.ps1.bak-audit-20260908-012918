    # ───────────────────────────────────────────────────────────────────
    # MODEL HEALTH CACHE
    # Every launch used to re-probe models - and those probes themselves
    # burn the shared NVIDIA rate limit, CAUSING the very 429s we avoid.
    # A small JSON cache with a TTL means a model verified OK within the
    # last minute is trusted instantly (zero probe traffic), and a model
    # that was throttled isn't re-probed until its window likely cleared.
    # This keeps launches instant AND reduces self-inflicted throttling.
    # ───────────────────────────────────────────────────────────────────
    $healthCachePath = Join-Path $env:USERPROFILE '.config\opencode\model-health.json'

    function Read-ModelHealthCache {
        if (Test-Path -LiteralPath $healthCachePath -PathType Leaf) {
            try {
                return (Get-Content -LiteralPath $healthCachePath -Raw | ConvertFrom-Json)
            } catch { }
        }
        return $null
    }

    function Write-ModelHealthCache {
        param([object]$Cache)
        $cacheMutex = New-Object Threading.Mutex($false, 'Local\NviocModelHealthCacheV1')
        $cacheLockTaken = $false
        $temporaryPath = $null
        try {
            try {
                $cacheLockTaken = $cacheMutex.WaitOne(1000)
            } catch [Threading.AbandonedMutexException] {
                $cacheLockTaken = $true
            }
            if (-not $cacheLockTaken) { return }
            $dir = Split-Path -Parent $healthCachePath
            if (-not (Test-Path -LiteralPath $dir -PathType Container)) {
                New-Item -ItemType Directory -Force -Path $dir | Out-Null
            }
            $temporaryPath = "$healthCachePath.tmp.$PID.$([guid]::NewGuid().ToString('N'))"
            $json = $Cache | ConvertTo-Json -Depth 4
            [IO.File]::WriteAllText(
                $temporaryPath,
                ($json + "`r`n"),
                (New-Object Text.UTF8Encoding($false))
            )
            if ([IO.File]::Exists($healthCachePath)) {
                [IO.File]::Replace($temporaryPath, $healthCachePath, $null, $true)
            } else {
                [IO.File]::Move($temporaryPath, $healthCachePath)
            }
            $temporaryPath = $null
        } catch { }
        finally {
            if ($temporaryPath -and [IO.File]::Exists($temporaryPath)) {
                [IO.File]::Delete($temporaryPath)
            }
            if ($cacheLockTaken) {
                [void]$cacheMutex.ReleaseMutex()
            }
            $cacheMutex.Dispose()
        }
    }

    function Test-ModelCached {
        param(
            [string]$ModelId,
            [string]$ApiKey,
            [int]$OkTtlSec = 60,
            [int]$ThrottledRetrySec = 45
        )
        # Decision helper: honor a fresh cache entry instead of probing.
        # Returns @{ ok; status; source = 'cache' | 'probe' }
        $now = [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
        $cache = Read-ModelHealthCache
        # JSON parsing creates a PSCustomObject whose slash-containing model
        # IDs cannot be assigned with dynamic member syntax. Normalize the
        # model map to a hashtable before both lookup and update so concurrent
        # direct-preflight checks cannot throw SetValueInvocationException.
        $cacheModels = @{}
        if ($cache -and $cache.models) {
            foreach ($property in $cache.models.PSObject.Properties) {
                $cacheModels[[string]$property.Name] = $property.Value
            }
        }
        if ($cacheModels.ContainsKey($ModelId)) {
            $entry = $cacheModels[$ModelId]
            $ageSec = ($now - [int64]$entry.ts) / 1000.0
            if ($entry.ok -and $ageSec -le $OkTtlSec) {
                return @{ ok = $true; status = 200; source = 'cache' }
            }
            if (-not $entry.ok -and $entry.status -eq 429 -and $ageSec -le $ThrottledRetrySec) {
                return @{ ok = $false; status = 429; source = 'cache' }
            }
        }
        # Probe (real request) and persist the result.
        $result = Test-ModelFastWithStatus -ModelId $ModelId -ApiKey $ApiKey
        if ($null -eq $cache) { $cache = [ordered]@{} }
        $cache.models = $cacheModels
        $cacheModels[$ModelId] = @{
            ok     = [bool]$result.ok
            status = [int]$result.status
            ts     = $now
        }
        Write-ModelHealthCache -Cache $cache
        return @{ ok = [bool]$result.ok; status = [int]$result.status; source = 'probe' }
    }

