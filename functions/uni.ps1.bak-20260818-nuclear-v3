    try { return @([UniSweepCollect]::Collect($Root, $Mode, $Pattern, @($DenyPaths), @($Protected), @($RootDeny))) } catch { return $null }
}

function Invoke-UniWalk {
    param(
        [string]$Dir,
        [int]$Depth,
        [string]$Mode,
        [System.Text.RegularExpressions.Regex]$Re,
        [string[]]$DenyPaths,
        [string[]]$Protected,
        [string[]]$RootDeny
    )
    $dirInfo = $null
    try { $dirInfo = New-Object System.IO.DirectoryInfo($Dir) } catch { return $false }
    if (-not $dirInfo.Exists) { return $false }
    $infos = $null
    try { $infos = $dirInfo.GetFileSystemInfos() } catch { return $false }
    $touched = $false
    $itemDepth = $Depth + 1
    foreach ($fi in $infos) {
        $name = $fi.Name
        if ($fi.Attributes -band [System.IO.FileAttributes]::ReparsePoint) { continue }
        if ($Depth -eq 0 -and $RootDeny -and ($RootDeny -contains $name)) { continue }
        if ($name -eq '.git' -or $name -eq '__pycache__' -or $name -eq '$Recycle.Bin') { continue }
        $path = $fi.FullName
        $skip = $false
        foreach ($p in $Protected) {
            if ($path.Equals($p, [System.StringComparison]::OrdinalIgnoreCase)) { $skip = $true; break }
        }
        if (-not $skip) {
            foreach ($d in $DenyPaths) {
                if ($path.StartsWith($d, [System.StringComparison]::OrdinalIgnoreCase)) { $skip = $true; break }
            }
        }
        if ($skip) { continue }
        if ($fi -is [System.IO.DirectoryInfo]) {
            $deleteDir = $false
            if ($Re.IsMatch($name)) {
                if ($Mode -eq 'T') { $deleteDir = $true }
                elseif ($Mode -ne 'B') { $deleteDir = ($itemDepth -le 3 -or ($itemDepth -le 4 -and $Re.IsMatch($dirInfo.Name))) }
                elseif ($dirInfo.Name -eq 'node_modules' -or $name -match 'removed|backup|bak|old') { $deleteDir = $true }
            }
            if ($deleteDir) {
                if (Remove-UniTarget -Path $path) {
                    $touched = $true
                    $script:UniDeleted += 1
                    Write-Host ("uni:   removed {0}" -f $path) -ForegroundColor Green
                } else { [void]$script:UniFailed.Add($path) }
                continue
            }
            $childMode = $Mode
            $childDepth = $itemDepth
            if ($name -eq 'AppData' -and $Mode -eq 'B') { $childMode = 'A'; $childDepth = 0 }
            elseif ($name -eq 'scoop' -and $Mode -eq 'B') { $childMode = 'A' }
            elseif ($name -eq 'Temp' -and $Mode -ne 'T') { $childMode = 'T' }
            $prune = Invoke-UniWalk -Dir $path -Depth $childDepth -Mode $childMode -Re $Re -DenyPaths $DenyPaths -Protected $Protected -RootDeny $RootDeny
            if ($prune) {
                if (Remove-UniTarget -Path $path) {
                    $touched = $true
                    $script:UniDeleted += 1
                    Write-Host ("uni:   removed {0}" -f $path) -ForegroundColor Green
                } else { [void]$script:UniFailed.Add($path) }
            }
        } else {
            $isShortcut = $false
            $ext = [System.IO.Path]::GetExtension($name)
            if ($ext -and ($ext.Equals('.lnk', [System.StringComparison]::OrdinalIgnoreCase) -or $ext.Equals('.url', [System.StringComparison]::OrdinalIgnoreCase) -or $ext.Equals('.appref-ms', [System.StringComparison]::OrdinalIgnoreCase))) { $isShortcut = $true }
            $deleteFile = $false
            if ($Re.IsMatch($name)) {
                if ($isShortcut -or $Mode -eq 'T') { $deleteFile = $true }
                elseif ($Mode -eq 'A') { $deleteFile = ($itemDepth -le 1 -or ($itemDepth -le 4 -and $Re.IsMatch($dirInfo.Name))) }
                else { $deleteFile = ($itemDepth -le 1 -or $dirInfo.Name -eq 'node_modules' -or $Re.IsMatch($dirInfo.Name) -or $name -match 'removed|backup|bak|old' -or ($ext -and $ext -match '^\.(dll|exe|cpl|sys|cmd|bat|ps1|psm1|psd1|vbs|js|mjs|cjs|flow|json|xml|pak|log|tmp|dat|ini|cfg|db|wasm|map|ico|png|url|appref-ms|lnk)$')) }
            }
            if ($deleteFile) {
                if (Remove-UniTarget -Path $path) {
                    $touched = $true
                    $script:UniDeleted += 1
                    Write-Host ("uni:   removed {0}" -f $path) -ForegroundColor Green
                } else { [void]$script:UniFailed.Add($path) }
            }
        }
    }
    if ($touched) {
        try { if (@($dirInfo.GetFileSystemInfos()).Count -eq 0) { return $true } } catch { return $false }
        return $false
    }
    if ($infos.Count -eq 0 -and $Re.IsMatch($dirInfo.Name)) { return $true }
    return $false
}

