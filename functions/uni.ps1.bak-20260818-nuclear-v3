        @{ Path = $env:ProgramFiles; Mode = 'A'; RootDeny = @() },
        @{ Path = $prog86;           Mode = 'A'; RootDeny = @() },
        @{ Path = (Join-Path $sd 'Users\Public'); Mode = 'B'; RootDeny = @() },
        @{ Path = (Join-Path $sd 'Windows\Temp'); Mode = 'T'; RootDeny = @() }
    )
    $rootSpecs = @($rootSpecs | Where-Object {
        $_.Path -and $_.Path.StartsWith($sd, [System.StringComparison]::OrdinalIgnoreCase) -and (Test-Path -LiteralPath $_.Path -PathType Container)
    })

    $denyPaths = @()
    if ($env:ProgramFiles) {
        $denyPaths += (Join-Path $env:ProgramFiles 'WindowsApps')
        $denyPaths += (Join-Path $env:ProgramFiles 'Microsoft Shared')
        $denyPaths += (Join-Path $env:ProgramFiles 'Common Files\Microsoft Shared')
        $denyPaths += (Join-Path $env:ProgramFiles 'Windows NT')
        $denyPaths += (Join-Path $env:ProgramFiles 'Internet Explorer')
    }
    if ($prog86) {
        $denyPaths += (Join-Path $prog86 'Microsoft Shared')
        $denyPaths += (Join-Path $prog86 'Windows NT')
        $denyPaths += (Join-Path $prog86 'Internet Explorer')
    }
    if ($env:ProgramData) { $denyPaths += (Join-Path $env:ProgramData 'Package Cache') }
    $denyPaths = @($denyPaths | Where-Object { $_ -and (Test-Path -LiteralPath $_ -PathType Container) })

    $protected = @()
    if ($PSCommandPath) { $protected += [System.IO.Path]::GetFullPath($PSCommandPath) }
    $mod = Get-Module -Name 'CodexProfileFunctions' -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($mod -and $mod.ModuleBase) {
        $protected += (Join-Path $mod.ModuleBase ($mod.Name + '.psm1'))
        $protected += (Join-Path $mod.ModuleBase ($mod.Name + '.psd1'))
    }

    $script:UniDeleted = 0
    $script:UniFailed = New-Object System.Collections.Generic.List[string]
    $total = $rootSpecs.Count
    $i = 0
    foreach ($rs in $rootSpecs) {
        $i++
        Write-Progress -Activity ("C-Drive leftover sweep for: {0}" -f ($Names -join ', ')) -Status ("Scanning {0}" -f $rs.Path) -PercentComplete ((($i - 1) / $total) * 100)
        Write-Host ("uni:   scanning {0} ..." -f $rs.Path) -ForegroundColor DarkGray
        $cands = Get-UniSweepCandidates -Root $rs.Path -Mode $rs.Mode -Pattern $pat -DenyPaths $denyPaths -Protected $protected -RootDeny @($rs.RootDeny)
        if ($null -ne $cands) {
            foreach ($c in @($cands)) {
                if (Remove-UniTarget -Path $c) { $script:UniDeleted += 1; Write-Host ("uni:   removed {0}" -f $c) -ForegroundColor Green }
                else { [void]$script:UniFailed.Add($c) }
            }
        } else {
            $null = Invoke-UniWalk -Dir $rs.Path -Depth 0 -Mode $rs.Mode -Re $re -DenyPaths $denyPaths -Protected $protected -RootDeny @($rs.RootDeny)
        }
    }
    Write-Progress -Activity ("C-Drive leftover sweep for: {0}" -f ($Names -join ', ')) -Completed
    Write-Host ("uni: sweep done - removed {0} leftover item(s)." -f $script:UniDeleted) -ForegroundColor Green
    if ($script:UniFailed.Count -gt 0) {
        Write-Host ("uni: {0} item(s) could NOT be removed (in use / access denied):" -f $script:UniFailed.Count) -ForegroundColor Yellow
        foreach ($f in @($script:UniFailed | Select-Object -Unique)) { Write-Host ("uni:   blocked: {0}" -f $f) -ForegroundColor Yellow }
    } else {
        Write-Host ("uni: C-Drive is clean of '{0}' - nothing else left." -f ($Names -join ', ')) -ForegroundColor Green
    }
}

function uni {
    $exeCandidates = @(
        'F:\study\Dev_Toolchain\programming\.NET\projects\c\Terminaluninstaller\ultimate_uninstaller_NUCLEAR_v2.exe',
        'F:\study\Dev_Toolchain\programming\.NET\projects\c\Terminaluninstaller\ultimate_uninstaller_NUCLEAR.exe'
    )
    $exe = $null
    foreach ($exeCandidate in $exeCandidates) {
        if (Test-Path -LiteralPath $exeCandidate -PathType Leaf) {
            $exe = $exeCandidate
            break
        }
    }
    if (-not $exe) {
        throw "uni: NUCLEAR uninstaller executable not found. Searched: $($exeCandidates -join ', ')"
    }
    $raw = @($args)
    $names = New-Object System.Collections.Generic.List[string]
    $exeArgs = New-Object System.Collections.Generic.List[string]
    $pendingRoot = $false
    $sweepOnly = $false
    foreach ($a in $raw) {
        $s = [string]$a
        if ($s -eq '--uni-sweep-only') { $sweepOnly = $true; continue }
        if ($pendingRoot) { $exeArgs.Add($s); $pendingRoot = $false; continue }
        if ($s -eq '--root' -or $s -eq '/root') { $exeArgs.Add($s); $pendingRoot = $true }
        elseif ($s -match '^(/|--|-)[A-Za-z]') { $exeArgs.Add($s) }
        else { $names.Add($s) }
    }
    if ($names.Count -eq 0) {
        Write-Host 'uni: no target app names given.' -ForegroundColor Yellow
        return
    }
    $isElevated = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    if ($sweepOnly) {
        Invoke-UniSweep -Names @($names)
        return
    }
    $neverKill = $script:UniNeverKill
    $protectedPids = $script:UniProtectedPids
    for ($s = 0; $s -lt 2; $s++) {
        $procs = @(Get-Process -ErrorAction SilentlyContinue)
        foreach ($n in $names) {
            $token = ([string]$n -replace '[^A-Za-z0-9]', '').ToLowerInvariant()
            if ($token.Length -lt 2) { continue }
            if ($neverKill -contains $token) { continue }
            $procs | Where-Object { ($_.ProcessName -and $_.ProcessName.ToLowerInvariant().Contains($token)) -and -not $protectedPids.ContainsKey($_.Id) } | ForEach-Object {
                try { Stop-Process -Id $_.Id -Force -ErrorAction Stop } catch { }
            }
            & taskkill.exe /F /T /IM "*$token*" 2>$null | Out-Null
        }
        if ($s -eq 0) { Start-Sleep -Milliseconds 400 }
    }
    foreach ($n in $names) {
        $thisExeArgs = @($exeArgs)
        if ($thisExeArgs -notcontains '/y' -and $thisExeArgs -notcontains '-y') { $thisExeArgs += '/y' }
        & $exe $n @thisExeArgs
        if ($LASTEXITCODE -ne 0) { & $exe $n @thisExeArgs }
    }
    $script:UniDeleted = 0
    $script:UniFailed = New-Object System.Collections.Generic.List[string]
    Invoke-UniSweep -Names @($names)
    if (-not $isElevated -and $PSCommandPath -and $script:UniFailed.Count -gt 0) {
        $needElev = $false
        $pf86 = $null
        try { $pf86 = ${env:ProgramFiles(x86)} } catch { }
        foreach ($f in $script:UniFailed) {
            foreach ($base in @($env:ProgramFiles, $pf86, $env:ProgramData, (Join-Path $env:SystemDrive 'Windows\Temp'))) {
                if ($base -and $f.StartsWith($base, [System.StringComparison]::OrdinalIgnoreCase)) { $needElev = $true; break }
            }
            if (-not $needElev -and $f.StartsWith($env:SystemDrive + '\', [System.StringComparison]::OrdinalIgnoreCase) -and -not $f.StartsWith($env:SystemDrive + '\Users', [System.StringComparison]::OrdinalIgnoreCase)) { $needElev = $true }
            if ($needElev) { break }
        }
        if ($needElev) {
            Write-Host 'uni: some leftovers need administrator rights - re-running the sweep elevated.' -ForegroundColor Cyan
            $inner = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('"' + $PSCommandPath + '"'), '--uni-sweep-only')
            foreach ($n in @($names)) { $inner += ('"' + $n + '"') }
            try { Start-Process -FilePath "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -ArgumentList $inner -Verb RunAs -Wait } catch { }
        }
    }
}

