function Invoke-DKillFastHardDeleteDockerVhd {
    [CmdletBinding()]
    param()

    $vhd = 'C:\ProgramData\DockerDesktop\vm-data\DockerDesktop.vhdx'
    $vmData = 'C:\ProgramData\DockerDesktop\vm-data'
    $dockerRoot = 'C:\ProgramData\DockerDesktop'
    $bytesBefore = 0L
    $warnings = @()

    if(-not $script:DKillFastIsAdmin) {
        Write-DKillFastLine 'DKILL_VHD_DELETE_SKIP administrator rights are required' Yellow
        return $false
    }

    foreach($candidate in @($vmData, $vhd)) {
        if(Test-Path -LiteralPath $candidate) {
            try {
                $bytesBefore = [int64](Get-DKillFastPathBytes -Path $candidate)
            } catch {
                $warnings += $_.Exception.Message
                Write-DKillFastLine ("DKILL_VHD_DELETE_WARN measurement failed for {0}: {1}" -f $candidate, $_.Exception.Message) Yellow
            }
            break
        }
    }

    $attempt = 0
    while(
        ((Test-Path -LiteralPath $vhd) -or (Test-Path -LiteralPath $vmData)) -and
        (Get-DKillFastRemainingMilliseconds) -ge 1200
    ) {
        $attempt++
        $remaining = Get-DKillFastRemainingMilliseconds
        $percent = [Math]::Min(85, 10 + ($attempt * 15))
        Write-Progress -Activity 'Docker VHD deletion' -Status ("Releasing VHD locks, attempt {0}" -f $attempt) -PercentComplete $percent

        try {
            $lockBudget = [Math]::Min(1400, [Math]::Max(500, $remaining - 13000))
            $lockReceipt = Invoke-DKillFastReleaseDockerVhdLocks -Milliseconds $lockBudget
            if(-not $lockReceipt.Succeeded) {
                $warnings += "lock release incomplete on attempt $attempt"
                Write-DKillFastLine ("DKILL_VHD_DELETE_WARN lock release incomplete on attempt {0}" -f $attempt) Yellow
            }
        } catch {
            $warnings += $_.Exception.Message
            Write-DKillFastLine ("DKILL_VHD_DELETE_WARN lock release failed on attempt {0}: {1}" -f $attempt, $_.Exception.Message) Yellow
        }

        foreach($target in @($vhd, $vmData)) {
            if(-not (Test-Path -LiteralPath $target)) {
                continue
            }

            Write-Progress -Activity 'Docker VHD deletion' -Status ("Preparing {0}" -f $target) -PercentComplete 70
            try {
                $item = Get-Item -LiteralPath $target -Force -ErrorAction Stop
                $takeown = Join-Path $env:SystemRoot 'System32\takeown.exe'
                $icacls = Join-Path $env:SystemRoot 'System32\icacls.exe'
                if(Test-Path -LiteralPath $takeown) {
                    if($item.PSIsContainer) {
                        & $takeown /F $target /A /R /D Y 2>&1 | Out-Null
                    } else {
                        & $takeown /F $target /A 2>&1 | Out-Null
                    }
                    if($LASTEXITCODE -gt 1) {
                        throw "takeown exit=$LASTEXITCODE"
                    }
                }
                if(Test-Path -LiteralPath $icacls) {
                    if($item.PSIsContainer) {
                        & $icacls $target /grant 'Administrators:(OI)(CI)F' /T /C 2>&1 | Out-Null
                    } else {
                        & $icacls $target /grant 'Administrators:F' /C 2>&1 | Out-Null
                    }
                    if($LASTEXITCODE -ne 0) {
                        throw "icacls exit=$LASTEXITCODE"
                    }
                }
                & attrib -R -S -H $target /S /D 2>&1 | Out-Null
                Write-DKillFastLine ("DKILL_VHD_DELETE_OK ownership prepared for {0}" -f $target) DarkCyan
            } catch {
                $warnings += $_.Exception.Message
                Write-DKillFastLine ("DKILL_VHD_DELETE_WARN ownership preparation failed for {0}: {1}" -f $target, $_.Exception.Message) Yellow
            }

            Write-Progress -Activity 'Docker VHD deletion' -Status ("Deleting {0}" -f $target) -PercentComplete 85
            try {
                $removed = Remove-DKillPath -Path $target
                if(-not $removed -or (Test-Path -LiteralPath $target)) {
                    throw 'deletion was not verified'
                }
                Write-DKillFastLine ("DKILL_VHD_DELETE_OK deleted {0}" -f $target) Green
            } catch {
                $warnings += $_.Exception.Message
                Write-DKillFastLine ("DKILL_VHD_DELETE_FAIL target={0}: {1}" -f $target, $_.Exception.Message) Red
            }
        }

        if((Test-Path -LiteralPath $vhd) -or (Test-Path -LiteralPath $vmData)) {
            Start-Sleep -Milliseconds 160
        }
    }

    Write-Progress -Activity 'Docker VHD deletion' -Completed
    if((Test-Path -LiteralPath $vhd) -or (Test-Path -LiteralPath $vmData)) {
        $remainingTargets = @($vhd, $vmData | Where-Object { Test-Path -LiteralPath $_ }) -join '; '
        Write-DKillFastLine ("DKILL_VHD_DELETE_FAIL unverified remaining target(s): {0}" -f $remainingTargets) Red
        return $false
    }

    Write-Progress -Activity 'Docker VHD deletion' -Status 'Removing stale Docker service logs' -PercentComplete 94
    try {
        $serviceLogs = @(Get-ChildItem -LiteralPath $dockerRoot -Force -File -Filter 'service*.txt' -ErrorAction Stop)
        $serviceLogBytes = 0L
        foreach($serviceLog in $serviceLogs) {
            $serviceLogBytes += [int64]$serviceLog.Length
            Remove-Item -LiteralPath $serviceLog.FullName -Force -ErrorAction Stop
            if(Test-Path -LiteralPath $serviceLog.FullName) {
                throw ("service-log deletion was not verified: {0}" -f $serviceLog.FullName)
            }
        }
        if($serviceLogs.Count -gt 0) {
            $script:DKillFastDeletedBytes += $serviceLogBytes
            Write-DKillFastLine ("DKILL_VHD_DELETE_OK removed service logs files={0} bytes={1}" -f $serviceLogs.Count, (Format-DKillFastBytes $serviceLogBytes)) Green
        }
    } catch {
        $warnings += $_.Exception.Message
        Write-DKillFastLine ("DKILL_VHD_DELETE_WARN service-log cleanup failed: {0}" -f $_.Exception.Message) Yellow
    } finally {
        Write-Progress -Activity 'Docker VHD deletion' -Completed
    }

    if($bytesBefore -gt 0) {
        $script:DKillFastDeletedBytes += $bytesBefore
    }
    $script:DKillFastForcedVhdDeleteCompletedAt = Get-Date
    $status = if($warnings.Count -eq 0) { 'OK' } else { 'OK_WITH_WARNINGS' }
    $color = if($warnings.Count -eq 0) { 'Green' } else { 'Yellow' }
    Write-DKillFastLine ("DKILL_VHD_DELETE_{0} attempts={1} removed_bytes={2} warnings={3}" -f $status, $attempt, (Format-DKillFastBytes $bytesBefore), $warnings.Count) $color
    return $true
}

if ($MyInvocation.InvocationName -ne '.') {
    & 'Invoke-DKillFastHardDeleteDockerVhd' @args
}
