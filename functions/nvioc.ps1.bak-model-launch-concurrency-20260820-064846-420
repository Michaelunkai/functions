        if ($null -eq $cache) { $cache = @{} }
        if (-not $cache.models) { $cache.models = @{} }
        $cache.models.$ModelId = @{
            ok     = [bool]$result.ok
            status = [int]$result.status
            ts     = $now
        }
        Write-ModelHealthCache -Cache $cache
        return @{ ok = [bool]$result.ok; status = [int]$result.status; source = 'probe' }
    }

