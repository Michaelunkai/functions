    public FullScreenSnip()
    {
        this.ShowInTaskbar = false;
        this.WindowState = FormWindowState.Minimized;
        this.FormBorderStyle = FormBorderStyle.None;
        this.Opacity = 0;
        this.Size = new Size(1, 1);
        this.Load += FullScreenSnip_Load;

        // Hotkeys live on a dedicated message-only window (HWND_MESSAGE) that
        // nothing can hide, minimize or destroy. Registering on this.Handle was
        // fragile: hiding the form destroys its WinForms handle, which releases
        // the RegisterHotKey registrations (e.g. the startup manager's "quiet"
        // window-hiding breaks Alt+S/Alt+Q/Ctrl+Alt+S/Ctrl+Alt+Q until restart).
        hotkeyHost = new HotkeyHost();
        hotkeyHost.HotkeyPressed += OnHostHotkey;
        AppLog.Write("constructor: hotkeyHost created");

        screenshotFolder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Personal), "Screenshots");
        if (!Directory.Exists(screenshotFolder))
        {
            Directory.CreateDirectory(screenshotFolder);
        }
    }

    private void FullScreenSnip_Load(object sender, EventArgs e)
    {
        try
        {
            LoadSettings();
            SetupTrayIcon();
            
            // Robust startup registration: verify current state and fix if needed
            if (runAtStartup)
            {
                if (!VerifyStartupRegistration())
                {
                    // Registration missing or corrupted - re-register
                    AddToStartup();
                }
            }
            else
            {
                // Ensure we're removed if disabled
                if (VerifyStartupRegistration())
                {
                    RemoveFromStartup();
                }
            }
            
            hotkeyHost.CreateMessageOnly();
            RegisterHotkeys();
            this.Hide();
        }
        catch (Exception ex)
        {
            MessageBox.Show("Startup error: " + ex.Message, "FullScreenSnip Error",
                MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    private void LoadSettings()
    {
        try
        {
            using (RegistryKey key = Registry.CurrentUser.OpenSubKey(@"SOFTWARE\FullScreenSnip", false))
            {
                if (key != null)
                {
                    saveAsPath = ((int)key.GetValue("SaveAsPath", 0)) == 1;
                    runAtStartup = ((int)key.GetValue("RunAtStartup", 1)) == 1;
                    string folder = key.GetValue("ScreenshotFolder", "") as string;
                    if (!string.IsNullOrEmpty(folder) && Directory.Exists(folder))
                    {
                        screenshotFolder = folder;
                    }
                }
            }
        }
        catch { }
    }

    private void SaveSettings()
    {
        try
        {
            using (RegistryKey key = Registry.CurrentUser.CreateSubKey(@"SOFTWARE\FullScreenSnip"))
            {
                if (key != null)
                {
                    key.SetValue("SaveAsPath", saveAsPath ? 1 : 0);
                    key.SetValue("RunAtStartup", runAtStartup ? 1 : 0);
                    key.SetValue("ScreenshotFolder", screenshotFolder);
                }
            }
        }
        catch { }
    }

    private Icon CreateTrayIcon()
    {
        // Create a high-quality, properly managed tray icon
        using (Bitmap bmp = new Bitmap(32, 32))
        {
            using (Graphics g = Graphics.FromImage(bmp))
            {
                g.SmoothingMode = SmoothingMode.AntiAlias;
                g.InterpolationMode = InterpolationMode.HighQualityBicubic;
                g.PixelOffsetMode = PixelOffsetMode.HighQuality;
                g.Clear(Color.Transparent);

                // Camera body - modern blue
                using (SolidBrush bodyBrush = new SolidBrush(Color.FromArgb(41, 98, 155)))
                {
                    GraphicsExtensions.FillRoundedRectangle(g, bodyBrush, 3, 9, 26, 18, 4);
                }

                // Camera lens ring
                using (Pen lensPen = new Pen(Color.FromArgb(20, 50, 80), 2))
                {
                    g.DrawEllipse(lensPen, 10, 11, 12, 12);
                }

                // Lens inner
                using (SolidBrush lensBrush = new SolidBrush(Color.FromArgb(70, 130, 180)))
                {
                    g.FillEllipse(lensBrush, 12, 13, 8, 8);
                }

                // Lens center highlight
                using (SolidBrush highlightBrush = new SolidBrush(Color.FromArgb(180, 210, 240)))
                {
                    g.FillEllipse(highlightBrush, 14, 15, 4, 4);
                }

                // Flash indicator (top-left accent)
                using (SolidBrush flashBrush = new SolidBrush(Color.FromArgb(255, 193, 7)))
                {
                    g.FillRectangle(flashBrush, 5, 4, 7, 4);
                    // Small triangle for flash shape
                    Point[] flashTri = { new Point(5, 4), new Point(12, 4), new Point(8, 0) };
                    g.FillPolygon(flashBrush, flashTri);
                }

                // Subtle border for visibility on dark/light taskbars
                using (Pen borderPen = new Pen(Color.FromArgb(0, 0, 0, 80), 1))
                {
                    GraphicsExtensions.FillRoundedRectangle(g, new SolidBrush(Color.FromArgb(0, 0, 0, 0)), 1, 7, 30, 22, 5);
                    // Just draw border
                    using (GraphicsPath path = new GraphicsPath())
                    {
                        path.AddArc(1, 7, 10, 10, 180, 90);
                        path.AddArc(21, 7, 10, 10, 270, 90);
                        path.AddArc(21, 19, 10, 10, 0, 90);
                        path.AddArc(1, 19, 10, 10, 90, 90);
                        path.CloseFigure();
                        g.DrawPath(borderPen, path);
                    }
                }
            }
            // GetHicon creates an unmanaged HICON; Icon.FromHandle doesn't own it.
            // We must track and destroy it when the NotifyIcon is disposed.
            IntPtr hIcon = bmp.GetHicon();
            Icon icon = Icon.FromHandle(hIcon);
            // Store the handle for later cleanup
            _trayIconHandle = hIcon;
            return icon;
        }
    }

    private void SetupTrayIcon()
    {
        trayIcon = new NotifyIcon();
        trayIcon.Icon = CreateTrayIcon();
        trayIcon.Text = "FullScreenSnip\nAlt+S/Ctrl+Alt+S: PNG\nAlt+Q/Ctrl+Alt+Q: Image";
        trayIcon.Visible = true;
        trayIcon.DoubleClick += OnCaptureClick;

        ContextMenu menu = new ContextMenu();
        menu.MenuItems.Add("--- PNG Mode (saves file) ---");
        menu.MenuItems.Add("Full Screen PNG (Ctrl+Alt+S)", OnCaptureClick);
        menu.MenuItems.Add("Free Snip PNG (Alt+S)", OnFreeSnipClick);
        menu.MenuItems.Add("-");
        menu.MenuItems.Add("--- Image Mode (clipboard) ---");
        menu.MenuItems.Add("Full Screen Image (Ctrl+Alt+Q)", OnCaptureImgClick);
        menu.MenuItems.Add("Free Snip Image (Alt+Q)", OnFreeSnipImgClick);
        menu.MenuItems.Add("-");

        saveAsPathMenuItem = new MenuItem("Also Save PNG File (image ALWAYS on clipboard)");
        saveAsPathMenuItem.Checked = saveAsPath;
        saveAsPathMenuItem.Click += OnToggleSaveAsPath;
        menu.MenuItems.Add(saveAsPathMenuItem);

        menu.MenuItems.Add("Change Screenshot Folder...", OnChangeFolderClick);
        menu.MenuItems.Add("-");

        startupMenuItem = new MenuItem("Run at Startup");
        startupMenuItem.Checked = runAtStartup;
        startupMenuItem.Click += OnToggleStartup;
        menu.MenuItems.Add(startupMenuItem);

        menu.MenuItems.Add("-");
        menu.MenuItems.Add("Re-register Hotkeys", OnReregisterClick);
        menu.MenuItems.Add("Exit", OnExitClick);
        trayIcon.ContextMenu = menu;
    }

    private void RegisterHotkeys()
    {
        IntPtr target = hotkeyHost != null ? hotkeyHost.Handle : this.Handle;
        UnregisterHotKey(target, HOTKEY_FULLSCREEN);
        UnregisterHotKey(target, HOTKEY_FREESNIP);
        UnregisterHotKey(target, HOTKEY_FULLSCREEN_IMG);
        UnregisterHotKey(target, HOTKEY_FREESNIP_IMG);
        Thread.Sleep(100);

        hotkeyFullscreenRegistered = RegisterHotKey(target, HOTKEY_FULLSCREEN, MOD_CTRL | MOD_ALT | MOD_NOREPEAT, VK_S);
        hotkeyFreesnipRegistered = RegisterHotKey(target, HOTKEY_FREESNIP, MOD_ALT | MOD_NOREPEAT, VK_S);

        hotkeyFullscreenImgRegistered = RegisterHotKey(target, HOTKEY_FULLSCREEN_IMG, MOD_CTRL | MOD_ALT | MOD_NOREPEAT, VK_Q);
        hotkeyFreesnipImgRegistered = RegisterHotKey(target, HOTKEY_FREESNIP_IMG, MOD_ALT | MOD_NOREPEAT, VK_Q);
        AppLog.Write("RegisterHotkeys: CtrlAltS={0} AltS={1} CtrlAltQ={2} AltQ={3} (target 0x{4:X})",
            hotkeyFullscreenRegistered, hotkeyFreesnipRegistered, hotkeyFullscreenImgRegistered, hotkeyFreesnipImgRegistered, target.ToInt64());

        string msg = "";
        bool allOk = hotkeyFullscreenRegistered && hotkeyFreesnipRegistered && hotkeyFullscreenImgRegistered && hotkeyFreesnipImgRegistered;
        if (allOk)
        {
            msg = "PNG: Ctrl+Alt+S / Alt+S\nImage: Ctrl+Alt+Q / Alt+Q";
            trayIcon.ShowBalloonTip(3000, "FullScreenSnip Ready!", msg, ToolTipIcon.Info);
        }
        else
        {
            if (!hotkeyFullscreenRegistered) msg += "Ctrl+Alt+S failed. ";
            if (!hotkeyFreesnipRegistered) msg += "Alt+S failed. ";
            if (!hotkeyFullscreenImgRegistered) msg += "Ctrl+Alt+Q failed. ";
            if (!hotkeyFreesnipImgRegistered) msg += "Alt+Q failed. ";
            trayIcon.ShowBalloonTip(5000, "FullScreenSnip Warning", msg + "Use tray menu.", ToolTipIcon.Warning);
        }
    }

